To="Para"/><OUTSIDEMARGIN Bottom="0" Left="56" Right="56" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>M``</SCRIPT></EQUATION><CHAR>, 최솟값을 </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="42786333" Lock="false" NumberingType="Equation" ZOrder="398"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="1037" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="56" Right="56" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>m`</SCRIPT></EQUATION><CHAR>이라 할 때, </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="38081578" Lock="false" NumberingType="Equation" ZOrder="398"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="3282" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="56" Right="56" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>M`+m`</SCRIPT></EQUATION><CHAR>의 값을 구하시오. (단, </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="19992576" Lock="false" NumberingType="Equation" ZOrder="398"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="1099" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="56" Right="56" Top="0"/><SHAPECOMMENT>수식입니다.</SHAPECOMMENT></SHAPEOBJECT><SCRIPT>O``</SCRIPT></EQUATION><CHAR>는 영행렬이다.)</CHAR></TEXT></P><P ParaShape="2" Style="0"><TEXT CharShape="0"><CHAR>[6.00점]</CHAR></TEXT></P><P ColumnBreak="false" PageBreak="true" ParaShape="0" Style="0"><TEXT CharShape="0"><TABLE BorderFill="2" CellSpacing="0" ColCount="2" PageBreak="Cell" RepeatHeader="true" RowCount="3"><SHAPEOBJECT InstId="23473970" Lock="false" NumberingType="Table" ZOrder="260822"><SIZE Height="10220" HeightRelTo="Absolute" Protect="false" Width="29059" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="1131" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3131" Protect="false" RowAddr="0" RowSpan="1" Width="29059"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P InstId="18257536" ParaShape="0" Style="0"><TEXT CharShape="2"><CHAR>내신 2026년 서울시 강남구 중산고 고1 공통 1학기 기말 공통수학1(빠른 정답)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="948" Protect="false" RowAddr="1" RowSpan="1" Width="29059"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="1"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2564" Protect="false" RowAddr="2" RowSpa