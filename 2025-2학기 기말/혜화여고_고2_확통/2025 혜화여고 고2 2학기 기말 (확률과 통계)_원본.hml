 HasNumRef="false" HasTextRef="false" LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" TextHeight="3685" TextWidth="62648" VertAlign="Bottom"><P ParaShape="3" Style="0"><TEXT CharShape="0"><AUTONUM Number="1" NumberType="Page"><AUTONUMFORMAT Superscript="false" Type="Digit" /></AUTONUM><CHAR /></TEXT></P></PARALIST></FOOTER><NEWNUM Number="1" NumberType="Page" /><HEADER ApplyPageType="Both" SeriesNum="2"><PARALIST HasNumRef="false" HasTextRef="false" LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" TextHeight="5669" TextWidth="62648" VertAlign="Top"><P ParaShape="0" Style="0"><TEXT CharShape="2" /></P><P ParaShape="0" Style="0"><TEXT CharShape="2"><CHAR>2025년 혜화여고 고2 2학기 기말고사(확통)</CHAR></TEXT></P></PARALIST></HEADER></TEXT></P><P ParaShape="6" Style="1"><TEXT CharShape="4" /><TEXT CharShape="3"><TABLE BorderFill="5" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="2"><SHAPEOBJECT InstId="7835853" Lock="false" NumberingType="Table" ZOrder="522413"><SIZE Height="2282" HeightRelTo="Absolute" Protect="false" Width="29624" WidthRelTo="Absolute" /><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para" /><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0" /></SHAPEOBJECT><INSIDEMARGIN Bottom="566" Left="0" Right="0" Top="566" /><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="282" Protect="false" RowAddr="0" RowSpan="1" Width="4152"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="6" Style="1"><TEXT CharShape="7"><CHAR>[출처]</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="1" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="282" Protect="false" RowAddr="0" RowSpan="1" Width="25472"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="7" Style="1"><TEXT CharShape="7"><CHAR>2025년 혜화여고 고2 2학기 기말고사(확통) &gt; 1 [3.2점]</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="5" ColAddr="0" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="282" Protect="false" RowAddr="1" RowSpan="1" Width="14812"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="6" Style="1"><TEXT CharShape="7" /></P></PARALIST></CELL><CELL BorderFill="5" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="282" Protect="false" RowAddr="1" RowSpan="1" Width="14812"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141" /><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="34" Style="1"><TEXT CharShape="24"><CHAR>난이도 하</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR /></TEXT></P><P ParaShape="13" Style="1"><TEXT CharShape="4"><ENDNOTE><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="6" Style="1"><TEXT CharShape="3"><AUTONUM Number="1" NumberType="Endnote"><AUTONUMFORMAT SuffixChar="." Superscript="false" Type="Digit" /></AUTONUM><CHAR> [정답] ④</CHAR></TEXT></P><P ParaShape="6" Style="1"><TEXT CharShape="3" /></P><P ParaShape="6" Style="1"><TEXT CharShape="3"><CHAR>[해설]</CHAR></TEXT></P><P ParaShape="6" Style="1"><TEXT CharShape="3"><CHAR>전수조사는 모집단 전체를 조사하는 방법이고, 표본조사는 모집단의 일부를 뽑아 조사하는 방법이다. 모집단 전체를 조사하기 어렵거나 불가능할 때 표본조사를 한다.</CHAR></TEXT></P><P ParaShape="14" Style="1"><TEXT CharShape="3"><CHAR>① </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="88678024" Lock="false" NumberingType="Equation" ZOrder="461819"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="662" WidthRelTo="Absolute" /><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="632" HorzRelTo="Column" TreatAsChar="true" VertAlign="Top" VertOffset="455" VertRelTo="Para" /><OUTSIDEMARGIN Bottom="0" Left="56" Right="56" Top="0" /><CAPTION FullSize="false" Gap="0" LastWidth="0" Side="Left" Width="0"><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="6" Style="1"><TEXT CharShape="13"><CHAR /></TEXT></P></PARALIST></CAPTION></SHAPEOBJECT><SCRIPT>2`</SCRIPT></EQUATION><CHAR>학년 </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="96952328" Lock="false" NumberingType="Equation" ZOrder="436759"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="1187" WidthRelTo="Absolute" /><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="697" HorzRelTo="Column" TreatAsChar="true" VertAlign="Top" VertOffset="26" VertRelTo="Para" /><OUTSIDEMARGIN Bottom="0" Left="56" Right="56" Top="0" /><CAPTION FullSize="false" Gap="0" LastWidth="0" Side="Left" Width="0"><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="6" Style="1"><TEXT CharShape="13"><CHAR /></TEXT></P></PARALIST></CAPTION></SHAPEOBJECT><SCRIPT>13`</SCRIPT></EQUATION><CHAR>반 학생 전체의 생일은 조사 대상이 한 학급으로 많지 않으므로 전수조사가 적합하다.</CHAR></TEXT></P><P ParaShape="14" Style="1"><TEXT CharShape="3"><CHAR>② </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="65144237" Lock="false" NumberingType="Equation" ZOrder="456625"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="662" WidthRelTo="Absolute" /><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="902" HorzRelTo="Column" TreatAsChar="true" VertAlign="Top" VertOffset="153" VertRelTo="Para" /><OUTSIDEMARGIN Bottom="0" Left="56" Right="56" Top="0" /><CAPTION FullSize="false" Gap="0" LastWidth="0" Side="Left" Width="0"><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="6" Style="1"><TEXT CharShape="13"><CHAR /></TEXT></P></PARALIST></CAPTION></SHAPEOBJECT><SCRIPT>2`</SCRIPT></EQUATION><CHAR>학년 학생들의 ‘확률과 통계’ 시험 평균 점수는 학교에서 전체 학생의 점수를 모두 알 수 있으므로 전수조사가 적합하다.</CHAR></TEXT></P><P ParaShape="14" Style="1"><TEXT CharShape="3"><CHAR>③ 우리나라 총인구 조사는 모든 국민을 조사해야 정확한 인구를 알 수 있으므로 전수조사가 적합하다.</CHAR></TEXT></P><P ParaShape="14" Style="1"><TEXT CharShape="3"><CHAR>④ 대기 오염 농도는 대기 전체를 조사할 수 없으므로 여러 지점에서 공기의 일부분을 채취하여 조사하는 표본조사가 적합하다.</CHAR></TEXT></P><P ParaShape="14" Style="1"><TEXT CharShape="3"><CHAR>⑤ 병역 판정 검사는 병역 대상자 모두를 검사해야 하므로 전수조사가 적합하다.</CHAR></TEXT></P><P ParaShape="6" Style="1"><TEXT CharShape="3"><CHAR>이상에서 전수조사보다 표본조사가 더 적합한 것은 ④이다.</CHAR></TEXT></P></PARALIST></ENDNOTE></TEXT><TEXT CharShape="3"><CHAR>다음 중 전수조사보다 표본조사가 더 적합한 것은?</CHAR></TEXT></P><P ParaShape="6" Style="1"><TEXT CharShape="3"><CHAR>① </CHAR><EQUATION BaseLine="85" BaseUnit="1100" LineMode="false" TextColor="0" Version="Equation Version 60"><SHAPEOBJECT InstId="96952328" Lock="false" NumberingType="Equation" ZOrder="436759"><SIZE Height="1125" HeightRelTo="Absolute" Protect="false" Width="662" WidthRelTo="Absolute" /><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="634" HorzRelTo="Column" TreatAsChar="true" VertAlign="Top" VertOffset="282" VertRelTo="Para" /><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0" /><CAPTION FullSize="false" Gap="0" 