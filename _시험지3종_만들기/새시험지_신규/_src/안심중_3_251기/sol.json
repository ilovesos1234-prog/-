{
"1":{"tp":"이차방정식이 될 조건","key":"정리한 식의 x² 계수가 0","sol":["$3x^2+12ax+12a^2-2x=ax^2+4ax$","$(3-a)x^2+(8a-2)x+12a^2=0$","이차방정식이 아니려면 $3-a=0$, $a=3$"],"check":"ok"},
"2":{"tp":"한 근을 이용한 식의 값","key":"양변을 p로 나누어 p − 1/p 구하기","sol":["$p^2-3p-1=0$ 의 양변을 $p$로 나누면 $p-3-\\dfrac1p=0$","$p-\\dfrac1p=3$","$2p-\\dfrac2p=6$"],"check":"ok"},
"3":{"tp":"인수분해로 풀기","key":"곱이 −28, 합이 3인 두 수","sol":["$(x+7)(x-4)=0$","$x=-7$ 또는 $x=4$"],"check":"ok"},
"4":{"tp":"(x−a)²=k 의 해","key":"k의 부호에 따라 근의 개수 결정","sol":["$k\\gt0$ 이면 $x=a\\pm\\sqrt k$ 로 서로 다른 두 근","① $x=a\\pm\\sqrt k$ ② $k=0$ 일 때 중근 ③ 부호는 $a$, $k$에 따라 다름 ⑤ $k=0$ 이면 중근 $x=a$","옳은 것은 ④"],"check":"ok"},
"5":{"tp":"중근을 가질 조건","key":"판별식 = 0","sol":["$x^2+(2a-6)x-12a=0$","$\\dfrac{D}{4}=(a-3)^2+12a=(a+3)^2=0$","$a=-3$"],"check":"ok"},
"6":{"tp":"근의 공식","key":"3x²−x+A=0 에 근의 공식 적용","sol":["$3x^2-x+A=0$, $x=\\dfrac{1\\pm\\sqrt{1-12A}}{6}$","$B=1$, $1-12A=37$ 에서 $A=-3$","$A+B=-2$"],"check":"ok"},
"7":{"tp":"계수가 소수·분수인 방정식","key":"양변에 15를 곱해 정수 계수로","sol":["양변에 $15$를 곱하면 $12x-5(x^2-2x)=-15$","$5x^2-22x-15=0$, $(5x+3)(x-5)=0$","$x=-\\dfrac35$ 또는 $x=5$"],"check":"ok"},
"8":{"tp":"자릿수와 이차방정식","key":"A=10a+(8−a), B=10(8−a)+a 로 놓기","sol":["십의 자리 숫자를 $a$라 하면 $A=9a+8$, $B=80-9a$","$(9a-9)(90-9a)=1620$ → $81(a-1)(10-a)=1620$ → $(a-1)(10-a)=20$","$a^2-11a+30=0$, $a=5$ 또는 $a=6$","$a=5$: $A=53$, $B=35$, $A-2B\\lt0$ (적합) / $a=6$: $A=62$, $B=26$, $A-2B\\gt0$ (부적합)","$A=53$"],"check":"ok"},
"9":{"tp":"그래프 위의 점과 사분면 조건","key":"점 대입 후 기울기 부호 조건","sol":["$a(a+2)-\\dfrac13=3a^2-\\dfrac a3-2$","$6a^2-7a-5=0$, $(3a-5)(2a+1)=0$","$y$절편이 $-\\dfrac13$ 이므로 제$1$사분면을 지나지 않으려면 $a\\le0$","$a=-\\dfrac12$"],"check":"ok"},
"10":{"tp":"이차함수 판별","key":"y를 x의 식으로 나타내 최고차항 확인","sol":["① $r=2x$, $y=4\\pi x^2$ ② $y=\\dfrac{x(x-3)}{2}$ ③ $y=(x+1)^2$ ④ $y=3\\pi x^2$ : 이차함수","⑤ 빗변 $x-1$ 이면 둘레 $y=(1+\\sqrt2)(x-1)$ 로 일차함수"],"check":"ok"},
"11":{"tp":"함숫값","key":"x=2 대입","sol":["$f(2)=-4+2(a-3)-5=2a-15=-7$","$a=4$"],"check":"ok"},
"12":{"tp":"그래프의 폭","key":"|a|가 클수록 폭이 좁다","sol":["$|-4|$ 가 가장 크므로 $y=-4x^2$"],"check":"ok"},
"13":{"tp":"y=a(x−p)²+q 의 성질","key":"꼭짓점 (−3, 2), 아래로 볼록","sol":["아래로 볼록, 꼭짓점 $(-3,2)$, 축 $x=-3$","$y$절편 $\\dfrac95+2=\\dfrac{19}{5}$, $x\\gt-3$ 에서 증가","옳은 것은 ②"],"check":"ok"},
"14":{"tp":"대칭 이동한 그래프와 직선","key":"y=−2x² 와 y=k 의 두 교점 사이 거리","sol":["$x$축 대칭인 그래프는 $y=-2x^2$","$y=k$ 와 만나는 점 $x=\\pm\\sqrt{-\\dfrac k2}$ ($k\\lt0$)","$2\\sqrt{-\\dfrac k2}=6$ → $-\\dfrac k2=9$, $k=-18$"],"check":"'y=2x²의 그래프와 x축에 대칭인 그래프'를 y=−2x²로 해석(정답 ①과 일치)."},
"15":{"tp":"포물선 위의 직사각형","key":"A(a, a²), B(a, 4a²), C(2a, 4a²)","sol":["$\\mathrm{A}(a,a^2)$, $\\mathrm{B}(a,4a^2)$, C는 $y=x^2$ 위에서 $y=4a^2$ 이므로 $\\mathrm{C}(2a,4a^2)$","$\\overline{\\mathrm{AB}}=3a^2$, $\\overline{\\mathrm{BC}}=a$, $3a^2:a=3:2$ → $a=\\dfrac12$","넓이 $=\\dfrac34\\times\\dfrac12=\\dfrac38$"],"check":"ok"},
"16":{"tp":"그래프가 지나는 사분면","key":"꼭짓점 위치와 y절편 부호","sol":["$y=2a(x-1)^2-6$: 꼭짓점 $(1,-6)$, 제$3$사분면을 지나지 않으려면 $a\\gt0$ 이고 $y$절편 $2a-6\\ge0$ → $a\\ge3$","$y=-a(x+1)^2+7$: 꼭짓점 $(-1,7)$, 위로 볼록, 모든 사분면을 지나려면 $y$절편 $7-a\\gt0$ → $a\\lt7$","$a=3,4,5,6$ 의 $4$개"],"check":"ok"},
"17":{"tp":"한 근이 주어진 이차방정식","key":"x=−3 대입으로 a, 다른 근 대입으로 b","sol":["$x=-3$ 대입: $9+21a+6+6=0$ → $a=-1$","$x^2+5x+6=0$ → $(x+2)(x+3)=0$, 다른 근 $x=-2$","$4-2(b-1)+3b=0$ → $b=-6$"],"check":"ok"},
"18":{"tp":"원의 넓이와 이차방정식","key":"π(r+3)² = 6πr² − 23π","sol":["작은 원의 반지름을 $r$이라 하면 $\\pi(r+3)^2=6\\pi r^2-23\\pi$","$5r^2-6r-32=0$, $(5r-16)(r+2)=0$","$r\\gt0$ 이므로 $r=\\dfrac{16}{5}\\,\\text{cm}$"],"check":"ok"},
"19":{"tp":"서로의 꼭짓점을 지나는 포물선","key":"꼭짓점 (0, 3), (−2, 4b) 를 서로 대입","sol":["$(-2,4b)$ 가 $y=-2x^2+3$ 위: $4b=-5$, $b=-\\dfrac54$","$(0,3)$ 이 $y=a(x+2)^2+4b$ 위: $3=4a-5$, $a=2$","$a+12b=2-15=-13$"],"check":"ok"},
"20":{"tp":"평행이동과 꼭짓점","key":"이동 후 꼭짓점 (−p+1, q−3)","sol":["$-p+1=4$, $q-3=-1$ 이므로 $p=-3$, $q=2$","이동한 식 $y=a(x-4)^2-1$ 이 $(1,4)$를 지남: $9a-1=4$, $a=\\dfrac59$","$a+p+q=\\dfrac59-3+2=-\\dfrac49$"],"check":"ok"}
}
