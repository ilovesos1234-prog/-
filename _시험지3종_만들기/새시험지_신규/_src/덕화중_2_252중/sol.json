{
"1":{"tp":"이등변삼각형의 꼭지각의 이등분선","key":"꼭지각의 이등분선은 밑변을 수직이등분","sol":["$\\overline{AD}\\perp\\overline{BC}$이므로 $y=90$","$\\overline{BD}=\\dfrac{1}{2}\\times14=7$이므로 $x=7$","$x+y=97$"],"check":"ok"},
"2":{"tp":"이웃한 이등변삼각형","key":"외각의 성질로 각을 차례로 구함","sol":["$\\angle B=a$라 하면 $\\angle FEB=a$, $\\angle EDF=\\angle DFE=2a$","$\\angle DCE=\\angle DEC=3a$, $\\angle A=\\angle CDA=4a$","$\\angle BCA=\\angle A=4a$이므로 $a+4a+4a=180^\\circ$, $a=20^\\circ$","$\\angle DCE=3a=60^\\circ$"],"check":"ok"},
"3":{"tp":"직각삼각형의 합동 조건","key":"RHA, RHS 또는 SAS·ASA","sol":["① SAS ② RHS ③ RHA ④ ASA","⑤ 세 각만 같으면 닮음일 뿐 합동이 아니다"],"check":"ok"},
"4":{"tp":"접은 도형과 이등변삼각형","key":"접은 각은 같다: ∠ABE=∠A","sol":["$\\angle A=\\angle x$이면 $\\angle ABE=\\angle x$","$\\angle B=\\angle C=\\angle x+36^\\circ$","$\\angle x+2(\\angle x+36^\\circ)=180^\\circ$, $\\angle x=36^\\circ$"],"check":"ok"},
"5":{"tp":"피타고라스 정리와 정사각형의 넓이","key":"빗변 위 정사각형 = 두 정사각형의 합","sol":["$\\triangle DEF$에서 $\\overline{DE}^2=256+144=400$, $\\overline{DE}=20$","$\\overline{AC}=\\overline{DE}=20$, $\\overline{BC}^2=225$","$\\overline{AB}^2=225+400=625$, $\\overline{AB}=25\\,\\text{cm}$"],"check":"원본 문장·그림이 깨져 AC=DE 조건을 보충함(정답 25와 일치)"},
"6":{"tp":"내심과 각","key":"∠BIC = 90° + ½∠A","sol":["$\\angle A=2\\times26^\\circ=52^\\circ$","$\\angle x=90^\\circ+26^\\circ=116^\\circ$"],"check":"ok"},
"7":{"tp":"내접원의 접선의 길이","key":"한 점에서 그은 두 접선의 길이는 같다","sol":["$\\overline{AD}=\\overline{AF}=x$라 하면 $\\overline{BE}=9-x$, $\\overline{CE}=13-x$","$(9-x)+(13-x)=15$, $x=\\dfrac{7}{2}$"],"check":"ok"},
"8":{"tp":"외심을 공유하는 두 삼각형","key":"A, B, C, D가 한 원 위 ⇒ ∠B+∠D=180°","sol":["$\\angle AOC=2\\angle B=156^\\circ$","점 D는 호 AC의 반대쪽에 있으므로 $\\angle D=\\dfrac{1}{2}(360^\\circ-156^\\circ)=102^\\circ$"],"check":"ok"},
"9":{"tp":"이등변삼각형의 외심과 내심","key":"∠OBC=90°−∠A, ∠IBC=½∠B","sol":["$\\angle B=62^\\circ$, $\\angle IBC=31^\\circ$","$\\angle BOC=112^\\circ$, $\\angle OBC=34^\\circ$","$\\angle OBI=34^\\circ-31^\\circ=3^\\circ$"],"check":"ok (그림은 원본처럼 O를 I 위에 그림; 실제로는 두 점이 매우 가깝다)"},
"10":{"tp":"외심과 수선","key":"외심에서 변에 내린 수선은 그 변을 이등분","sol":["$\\overline{AC}=2\\times5=10$","$\\overline{OA}+\\overline{OC}=24-10=14$","$\\overline{OA}=7\\,\\text{cm}$"],"check":"ok"},
"11":{"tp":"평행사변형이 되는 조건","key":"한 쌍의 대변이 평행하고 길이가 같다","sol":["③ $\\overline{AB}\\,/\\!/\\,\\overline{DC}$, $\\overline{AB}=\\overline{DC}$ ⇒ 평행사변형","④ 대각선이 서로를 이등분하지 않음, ⑤ 대각의 크기가 다름"],"check":"ok"},
"12":{"tp":"평행사변형의 이웃한 두 각의 이등분선","key":"∠B+∠C=180°","sol":["$\\angle EBC+\\angle ECB=\\dfrac{1}{2}(\\angle B+\\angle C)=90^\\circ$","$\\angle BEC=90^\\circ$"],"check":"ok"},
"13":{"tp":"마름모와 수선","key":"사각형 APCQ의 내각의 합","sol":["$\\angle C=180^\\circ-80^\\circ=100^\\circ$","$\\angle PAQ=360^\\circ-90^\\circ-90^\\circ-100^\\circ=80^\\circ$"],"check":"ok"},
"14":{"tp":"대각선의 수직이등분선","key":"E는 AC의 수직이등분선 위 ⇒ EA=EC","sol":["$\\overline{AD}=\\overline{BC}=13$, $\\overline{ED}=4$이므로 $\\overline{AE}=9=\\overline{EC}$","$\\triangle ECD$에서 $\\overline{CD}^2=9^2-4^2=65$","$\\overline{AB}^2=65$"],"check":"그림의 13은 BC의 길이, 4는 ED의 길이로 읽음"},
"15":{"tp":"평행선과 넓이","key":"DC∥AF ⇒ △DCA=△DCF ⇒ △DBF=△ABC","sol":["$\\triangle DBE:\\triangle DEF=3:5$이므로 $\\triangle DBF=24\\times\\dfrac{8}{3}=64$","$\\triangle ABC=\\triangle DBF=64$","$\\square ADEC=64-24=40\\,\\text{cm}^2$"],"check":"ok"},
"16":{"tp":"항상 닮은 도형","key":"모양이 하나로 정해지는가","sol":["⑤ 크기가 같은 한 내각이 한쪽은 꼭지각, 다른 쪽은 밑각일 수 있어 항상 닮음은 아니다"],"check":"ok"},
"17":{"tp":"닮은 입체의 겉넓이의 비","key":"닮음비 m:n ⇒ 겉넓이의 비 m²:n²","sol":["닮음비 $10:14=5:7$, 겉넓이의 비 $25:49$","$245\\times\\dfrac{25}{49}=125\\,\\text{cm}^2$"],"check":"ok"},
"18":{"tp":"평행사변형이 되는 조건의 증명","key":"SSS 합동 → 엇각","sol":["1) $\\triangle ABC$와 $\\triangle CDA$에서 $\\overline{AB}=\\overline{CD}$, $\\overline{BC}=\\overline{DA}$, $\\overline{AC}$는 공통","따라서 $\\triangle ABC\\equiv\\triangle CDA$ (SSS 합동)","2) $\\angle BAC=\\angle DCA$ (엇각) ⇒ $\\overline{AB}\\,/\\!/\\,\\overline{DC}$","$\\angle BCA=\\angle DAC$ (엇각) ⇒ $\\overline{AD}\\,/\\!/\\,\\overline{BC}$"],"check":"ok"},
"19":{"tp":"마름모와 이등변삼각형","key":"엇각과 맞꼭지각 ⇒ △DFC는 이등변삼각형","sol":["1) $\\overline{BF}=\\overline{BE}=10\\,\\text{cm}$","2) $\\angle BEF=\\angle BFE$ (이등변삼각형), $\\angle DFC=\\angle BFE$ (맞꼭지각)","$\\overline{AB}\\,/\\!/\\,\\overline{DC}$이므로 $\\angle DCF=\\angle BEF$ (엇각)","$\\angle DFC=\\angle DCF$이므로 $\\overline{DF}=\\overline{DC}=18$","$\\overline{BD}=10+18=28\\,\\text{cm}$"],"check":"원본 문장이 불완전해 그림에 따라 C, F, E가 한 직선 위라는 조건을 보충함. 1)은 주어진 조건에서 바로 나옴. 인쇄된 배점 2점 그대로"},
"20":{"tp":"정사각형과 SAS 합동","key":"△ABE ≡ △BCF","sol":["1) $\\overline{AB}=\\overline{BC}$, $\\angle ABE=\\angle BCF=90^\\circ$, $\\overline{BE}=\\overline{CF}$ ⇒ SAS 합동","2) $\\angle AEB=180^\\circ-113^\\circ=67^\\circ$, $\\angle BAE=23^\\circ$","$\\angle CBF=\\angle BAE=23^\\circ$"],"check":"ok"},
"21":{"tp":"평행사변형에서 넓이","key":"△ABE=△ABD=½□ABCD","sol":["1) $\\triangle ABE=\\triangle ABD$ (밑변 AB, 높이 같음)이므로 각각에서 $\\triangle ABF$를 빼면 $\\triangle AFD=\\triangle BEF$","2) $\\triangle AFD=\\triangle BEF=S$, $\\triangle DFE=T$라 하면","$\\triangle ABD=21+S$, $\\triangle BCD=15+S+T$, 두 넓이는 같으므로","3) $T=6\\,\\text{cm}^2$"],"check":"인쇄된 배점 2점 그대로"},
"22":{"tp":"닮은 입체의 부피의 비","key":"닮음비 5:1 ⇒ 부피의 비 125:1","sol":["닮음비 $10:2=5:1$","부피의 비 $5^3:1^3=125:1$","최대 $125$개"],"check":"ok"}
}
