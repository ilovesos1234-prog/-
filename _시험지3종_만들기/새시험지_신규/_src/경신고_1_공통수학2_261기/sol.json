{
"1":{"tp":"합성함수의 함숫값","key":"안쪽 함수부터 차례로 대입","sol":["$f(1)=2-1=1$","$(g\\circ f)(1)=g(1)=1-2=-1$"],"check":"ok"},
"2":{"tp":"항등함수가 되는 정의역","key":"$f(x)=x$를 만족하는 $x$만 원소가 될 수 있다","sol":["$3x^2-x=x\\Rightarrow 3x^2-2x=0\\Rightarrow x=0$ 또는 $x=\\dfrac{2}{3}$","$X$는 $\\left\\{0,\\dfrac{2}{3}\\right\\}$의 공집합이 아닌 부분집합: $2^2-1=3$개"],"check":"ok"},
"3":{"tp":"역함수의 성질로 식 정리","key":"$(g^{-1}\\circ f)^{-1}=f^{-1}\\circ g$","sol":["$f\\circ(f^{-1}\\circ g)\\circ f=g\\circ f$","$f(-1)=3-2=1$, $g(1)=2+5=7$"],"check":"ok"},
"4":{"tp":"명제가 참일 조건","key":"$P\\subset Q^C$","sol":["$P=\\{x\\,|\\,a-1\\le x\\le a+1\\}$","$x^2-4x-12\\gt 0\\iff x\\lt -2$ 또는 $x\\gt 6$이므로 $Q^C=\\{x\\,|\\,-2\\le x\\le 6\\}$","$a-1\\ge -2$, $a+1\\le 6$에서 $-1\\le a\\le 5$","최댓값 $5$"],"check":"ok"},
"5":{"tp":"필요조건 판별","key":"$Q\\subset P$이고 $P\\not\\subset Q$","sol":["①②③ $p\\Rightarrow q$이므로 충분조건","④ $x^2-4x+4=0\\iff x=2$: 필요충분조건","⑤ $P=\\{1,2,3,4,6,12\\}$, $Q=\\{1,2,4\\}$, $Q\\subset P$이고 $P\\ne Q$: 필요조건이지만 충분조건 아님"],"check":"ok"},
"6":{"tp":"무리함수의 최솟값","key":"정의역의 끝점에서 최솟값","sol":["정의역 $x\\le \\dfrac{a}{3}$, 함수는 감소하므로 $x=\\dfrac{a}{3}$에서 최솟값 $4$","$\\dfrac{a}{3}=3$에서 $a=9$, $m=4$","$a+m=13$"],"check":"ok"},
"7":{"tp":"산술·기하평균 부등식","key":"$(2x+y)\\left(\\dfrac{2}{x}+\\dfrac{1}{y}\\right)$ 전개","sol":["$\\dfrac{2}{x}+\\dfrac{1}{y}=(2x+y)\\left(\\dfrac{2}{x}+\\dfrac{1}{y}\\right)=5+2\\left(\\dfrac{y}{x}+\\dfrac{x}{y}\\right)$","$\\dfrac{y}{x}+\\dfrac{x}{y}\\ge 2$ (등호 $x=y=\\dfrac{1}{3}$)","최솟값 $5+4=9$"],"check":"ok"},
"8":{"tp":"진리집합의 포함관계와 부분집합 개수","key":"$P\\cap Q\\subset R\\subset P\\cup Q$","sol":["$P=\\{1,3,5,7,9\\}$, $Q=\\{5,10,15,20\\}$","$P\\cap Q=\\{5\\}$, $P\\cup Q=\\{1,3,5,7,9,10,15,20\\}$ (원소 8개)","$5$를 반드시 포함하는 부분집합: $2^{7}$개","$k=7$"],"check":"ok"},
"9":{"tp":"무리함수와 직선의 교점 개수","key":"$t=\\sqrt{x+2}\\,(t\\ge 0)$로 치환해 이차방정식의 근 조건","sol":["$x=t^2-2$ 대입: $-t+3=-t^2+2+k\\Rightarrow t^2-t+1-k=0$","두 점: 서로 다른 두 음이 아닌 근 $\\Rightarrow D=4k-3\\gt 0$, $1-k\\ge 0$: $\\dfrac{3}{4}\\lt k\\le 1$, $M=1$","한 점: 중근 $k=\\dfrac{3}{4}$ 또는 $k\\gt 1$, 최솟값 $m=\\dfrac{3}{4}$","$M+m=\\dfrac{7}{4}$"],"check":"ok"},
"10":{"tp":"역함수가 존재할 조건","key":"일대일대응: $x\\ge 2$에서 감소, $f(2)=8$","sol":["축 $x=a\\le 2$이어야 $x\\ge 2$에서 감소","$f(2)=-4+4a+b=8\\Rightarrow b=12-4a$","$f(6)=-36+12a+b=8a-24\\le 8\\cdot2-24=-8$"],"check":"ok"},
"11":{"tp":"유리함수와 직선이 만나지 않을 조건","key":"교점 방정식이 실근을 갖지 않을 조건","sol":["$\\dfrac{-x+5}{x-3}=-1+\\dfrac{2}{x-3}$, 직선은 $(0,-1)$을 지남","$mx-1=-1+\\dfrac{2}{x-3}\\Rightarrow mx^2-3mx-2=0$","$m=0$: $-2=0$ 해 없음 → 만나지 않음","$m\\ne 0$: $D=9m^2+8m\\lt 0\\iff -\\dfrac{8}{9}\\lt m\\lt 0$ → 정수 없음 ($x=3$은 근이 아님)","정수 $m$은 $0$ 하나"],"check":"ok"},
"12":{"tp":"넓이의 최대","key":"사각형을 $\\triangle OAP+\\triangle OPB$로 분할","sol":["$S=\\dfrac{1}{2}\\cdot 9\\cdot y+\\dfrac{1}{2}\\cdot 3\\cdot x$, $x=9-y^2$","$S=-\\dfrac{3}{2}y^2+\\dfrac{9}{2}y+\\dfrac{27}{2}$","$y=\\dfrac{3}{2}$일 때 최대 $\\dfrac{135}{8}$","$k=135$"],"check":"ok"},
"13":{"tp":"절댓값 유리함수와 수평선","key":"$f(x)=\\left|-2+\\dfrac{6}{x-3}\\right|$의 그래프를 구간별로","sol":["$0\\lt x\\lt 3$: 값의 범위 $(4,\\infty)$","$3\\lt x\\le 6$: $[0,\\infty)$, $x\\gt 6$: $(0,2)$","$t=1$: 2개, $t=2,3,4$: 1개, $t\\ge 5$: 2개","$2+3+4=9$"],"check":"ok"},
"14":{"tp":"일대일대응 함수 결정","key":"조건으로 $f$, $g$의 대응을 하나씩 확정","sol":["$f(3)=6$, $f(2)=3$, $g(3)=6$, $g(f(1))=5$","$f(1),f(4)\\in\\{4,5\\}$. $f(4)=4$면 $g(4)=6=g(3)$ 모순","$f(4)=5$, $g(5)=7$, $f(1)=4$, $g(4)=5$, $g(6)=8$","$f(1)+g^{-1}(8)=4+6=10$"],"check":"ok"},
"15":{"tp":"무리함수와 역함수의 교점","key":"증가함수와 역함수의 교점은 $y=x$ 위","sol":["$\\sqrt{5x-9}+1=x\\Rightarrow 5x-9=(x-1)^2$","$x^2-7x+10=0$, $x=2,5$ (모두 $x\\ge 1$)","교점 $(2,2)$, $(5,5)$, 거리 $3\\sqrt{2}$"],"check":"ok"},
"16":{"tp":"유리함수 위의 점과 점근선의 교점 사이 거리","key":"$f(x)=3x$, 산술·기하평균","sol":["$f(x)=ax+b$, $f(2x)=2f(x)$에서 $b=0$, $f(x)=3x$","$g(x)=\\dfrac{x+2}{x-2}=1+\\dfrac{4}{x-2}$, Q는 점근선의 교점","$P\\left(2+u,1+\\dfrac{4}{u}\\right)$: $PQ^2=u^2+\\dfrac{16}{u^2}\\ge 8$","최솟값 $2\\sqrt{2}$"],"check":"ok"},
"17":{"tp":"조건을 만족하는 함수","key":"$f(f(4))=f(f(3))=1$","sol":["$x=4$: $f(f(4))\\le 1$, $x=3$: $f(f(3))\\le 2$ → 둘 다 $1$","$f(4)=4$이면 $f(f(4))=4$ 모순, $f(4)=1$이면 $f(2),f(3)$이 $3,4$를 덮어야 하는데 성립 안 함","$f(4)=3$, $f(3)=1$, 치역에 $4$가 필요하므로 $f(2)=4$ ($f(f(2))=3\\le 3$ 성립)","$(4-1)\\times 3=9$"],"check":"ok"},
"18":{"tp":"역함수 대칭과 외접원","key":"P, Q는 $y=x$에 대해 대칭, 이등변삼각형 외접원 $R=\\dfrac{OP^2}{2h}$","sol":["$P(a,c)$, $Q(c,a)$, $c=\\sqrt{a-1}$, $l: y=-x+b$, $b=a+c$","O에서 $l$까지 거리 $h=\\dfrac{b}{\\sqrt{2}}$, $R=\\dfrac{a^2+c^2}{\\sqrt{2}b}$","$R^2=\\dfrac{25}{18}$에서 $a^2+a-1=\\dfrac{5}{3}b$","$b=3$: $a=2$, $c=1$에서 $5=5$ 성립 → $y$절편 $3$"],"check":"ok"},
"19":{"tp":"합성함수 방정식의 실근 개수","key":"$f$가 $x=1$에 대칭이므로 $g(x)=x$ 또는 $g(x)=2-x$","sol":["$x^2-4x-a=0$ … ㉠, $x^2+2x+a=0$ … ㉡","$a=-4$: ㉠ 중근 $2$, ㉡ 두 근 → 3개","$a=1$: ㉡ 중근 $-1$, ㉠ 두 근 → 3개","공통근 $x=-\\dfrac{a}{3}$: $a=-3$ → 근 $\\{1,3,-3\\}$ 3개","합 $-4+1-3=-6$"],"check":"ok"},
"20":{"tp":"구간별 함수와 원점을 지나는 직선","key":"$u=18x-7$의 범위로 $h$를 나누기","sol":["$x\\lt\\dfrac{1}{3}$: $h=1$, $\\dfrac{1}{3}\\lt x\\lt\\dfrac{7}{18}$: $h=-1$, $x\\ge\\dfrac{7}{18}$: $h=\\dfrac{9x-4}{9x-3}$","$m\\lt 0$: $h=1$과 1번, $m=-1,-2$만 곡선 부분과 1번 더 → $m=-3,-4,-5$ 가능","$m=0$: $x=\\dfrac{4}{9}$ 한 점","$m\\gt 0$: $9mx^2-(3m+9)x+4=0$, $D=9(m-1)(m-9)$ → $m=1$ 접함(1점), $m=2,3$ 0점, $m=4,5$는 $h=1$과 1점","$m\\in\\{-5,-4,-3,0,1,4,5\\}$: $7$개"],"check":"ok"}
}
