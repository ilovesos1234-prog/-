{
"1":{"tp":"이차방정식 판별","key":"정리했을 때 (x에 대한 이차식)=0 꼴","sol":["ㄱ. 이차방정식 (○)","ㄴ. 등호가 없는 이차식 (×)","ㄷ. $-x^2-2x+3=0$ (○)","ㄹ. $x+1=0$, 일차방정식 (×)","ㅁ. $2x^2-6=0$ (○)"],"check":"ok"},
"2":{"tp":"인수분해로 이차방정식 풀기","key":"$AB=0\\Rightarrow A=0$ 또는 $B=0$","sol":["$(x+11)(x-2)=0$ → $a=2$","$(2x-1)(x+3)=0$ → $b=-3$","$a-b=5$"],"check":"ok"},
"3":{"tp":"중근 조건","key":"$x^2+bx+c=0$이 중근 ⟺ $c=\\left(\\dfrac b2\\right)^2$","sol":["$9=\\left(\\dfrac a2\\right)^2$, $a\\gt0$ → $a=6$","$6x^2+bx+6=0$ → $x^2+\\dfrac b6x+1=0$에서 $\\left(\\dfrac{b}{12}\\right)^2=1$ → $b=12$"],"check":"ok"},
"4":{"tp":"두 근이 주어진 이차방정식","key":"$(x-\\alpha)(x-\\beta)=0$","sol":["$(2x-1)(3x+2)=0$ → $a=\\dfrac12$, $b=-\\dfrac23$","$2a-3b=1+2=3$, $2a+3b=1-2=-1$","$(x-3)(x+1)=0$ → $x^2-2x-3=0$"],"check":"ok"},
"5":{"tp":"닮음을 이용한 이차방정식 활용","key":"B 서쪽 점, A, N이 한 직선 위","sol":["한 변을 $2x$, B에서 서쪽 25m 지점을 Q, N에서 BC 연장선에 내린 수선의 발 H","$\\triangle\\text{NMA}\\sim\\triangle\\text{NHQ}$: $14:(2x+14)=x:(x+25)$","$14x+350=2x^2+14x$ → $x^2=175$ → $x=5\\sqrt7$","한 변 $=10\\sqrt7\\,\\text{m}$"],"check":"ok"},
"6":{"tp":"계수를 바꾸어 푼 이차방정식","key":"바뀐 식에 근 대입 → k 결정","sol":["원래 식 $x^2-6kx+(3-2k)=0$","바꾼 식 $x^2+(3-2k)x-6k=0$에 $x=2$: $4+6-4k-6k=0$ → $k=1$","원래 식 $x^2-6x+1=0$ → $x=3\\pm2\\sqrt2$, 두 근의 합 $6$"],"check":"ok"},
"7":{"tp":"움직이는 점과 넓이","key":"$\\triangle\\text{CPQ}=\\dfrac19\\square\\text{ABCD}$","sol":["$\\overline{\\text{CP}}=2t$, $\\overline{\\text{CQ}}=30-t$ ($0\\le t\\le30$)","$\\triangle\\text{CPQ}=t(30-t)=\\dfrac{1800}{9}=200$","$t^2-30t+200=0$ → $t=10,\\,20$","합 $30$"],"check":"ok"},
"8":{"tp":"이차함수 찾기","key":"$y=ax^2+bx+c$ ($a\\ne0$) 꼴","sol":["① $y=4\\pi(x+1)^2$ 이차함수","② $y=4x$ ③ $y=180(x-2)$ ④ $y=60x$ 일차함수","⑤ $y=\\dfrac2x$"],"check":"ok"},
"9":{"tp":"이차함수의 함숫값","key":"$x=0.2$ 대입","sol":["$y=-5\\times0.04+10\\times0.2+1=-0.2+2+1=2.8=\\dfrac{14}{5}$"],"check":"ok"},
"10":{"tp":"그래프의 폭 비교","key":"$|a|$가 작을수록 폭이 넓다","sol":["$|a|$: $9,\\dfrac13,\\dfrac14,4,7$ 중 최소는 $\\dfrac14$","③ $y=\\dfrac14x^2$"],"check":"ok"},
"11":{"tp":"x절편 사이 거리가 자연수","key":"$\\overline{\\text{AB}}=2\\sqrt{2k}$","sol":["$\\dfrac12x^2=k$ → $x=\\pm\\sqrt{2k}$","$2\\sqrt{2k}=\\sqrt{8k}$가 자연수 → $k=2m^2$","$k=2,8,18,32,50$ → $5$개"],"check":"ok"},
"12":{"tp":"포물선 위 점으로 만든 오각형 넓이","key":"y축 대칭 + 길이 비로 k 결정","sol":["$-2x^2+6=-10$ → $x=\\pm2\\sqrt2$, $\\overline{\\text{CD}}=4\\sqrt2$","$\\overline{\\text{BE}}=\\sqrt2$ → B$\\left(-\\dfrac{\\sqrt2}{2},5\\right)$, E$\\left(\\dfrac{\\sqrt2}{2},5\\right)$","$\\triangle\\text{ABE}=\\dfrac12\\cdot\\sqrt2\\cdot1=\\dfrac{\\sqrt2}{2}$","$\\square\\text{BCDE}=\\dfrac12(\\sqrt2+4\\sqrt2)\\cdot15=\\dfrac{75\\sqrt2}{2}$","합 $38\\sqrt2$"],"check":"ok"},
"13":{"tp":"y=a(x-p)² 그래프의 성질","key":"꼭짓점 $(-1,0)$, 축 $x=-1$, 아래로 볼록","sol":["다혜: 축은 $x=-1$ (×)","서준: (○)","세민: $a\\gt0$ → 아래로 볼록 (×)","윤아: 꼭짓점 $(-1,0)$ (×)","하은: $x$축보다 위쪽 (×)"],"check":"ok"},
"14":{"tp":"증가·감소로 축 찾기","key":"축 $x=2$, 위로 볼록","sol":["$p=2$","$(0,-8)$ 대입: $4a=-8$ → $a=-2$","$a-p=-4$"],"check":"ok"},
"15":{"tp":"부호 판정과 그래프 모양","key":"$\\sqrt{a^2}=|a|$","sol":["$a\\lt0$, $p\\gt0$, $q\\lt0$","위로 볼록, 꼭짓점 $(p,q)$는 제4사분면","→ ④"],"check":"ok"},
"16":{"tp":"그래프가 지나는 사분면","key":"꼭짓점 위치와 볼록 방향","sol":["①②③④는 모두 $x\\lt0$인 부분에서 $y\\gt0$인 점이 있어 제2사분면을 지남","⑤ 위로 볼록, 꼭짓점 $(0,-10)$ → 항상 $y\\lt0$, 제1·2사분면을 지나지 않음"],"check":"ok"},
"17":{"tp":"한 근을 대입한 식의 값","key":"양변을 $p$로 나누기","sol":["$x^2-3x-2=0$에 $x=p$: $p^2-3p-2=0$","$p\\ne0$이므로 양변을 $p$로 나누면 $p-3-\\dfrac2p=0$","$p-\\dfrac2p=3$"],"check":"ok"},
"18":{"tp":"자리의 수에 관한 활용","key":"십의 자리 $x$, 일의 자리 $12-x$","sol":["$10(12-x)+x=10x+(12-x)-2x(12-x)$","$2x^2-6x-108=0$ → $(x-9)(x+6)=0$ → $x=9$","처음 수 $93$ (확인: $39=93-54$)"],"check":"ok"},
"19":{"tp":"y=ax² 결정","key":"꼭짓점이 원점 → $y=ax^2$","sol":["$12=36a$ → $a=\\dfrac13$","$3=\\dfrac13m^2$ → $m^2=9$, $m\\gt0$ → $m=3$"],"check":"ok"},
"20":{"tp":"대칭이동 후 평행이동","key":"$x$축 대칭: $y\\to-y$","sol":["$x$축 대칭: $y=ax^2$","평행이동: $y=a(x-5)^2-3$","$(3,-9)$ 대입: $4a-3=-9$ → $a=-\\dfrac32$"],"check":"ok"},
"21":{"tp":"그래프에서 이차함수 식","key":"꼭짓점 $(1,-4)$, 원점 통과","sol":["$y=a(x-1)^2-4$에 $(0,0)$: $a=4$","$p=1$, $q=-4$","$a-pq=4+4=8$"],"check":"ok"}
