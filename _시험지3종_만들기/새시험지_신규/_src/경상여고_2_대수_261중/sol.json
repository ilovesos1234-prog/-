{
"1":{"tp":"거듭제곱근의 곱","key":"$\\sqrt[n]{a}\\sqrt[n]{b}=\\sqrt[n]{ab}$","sol":["$\\sqrt[5]{9\\times27}=\\sqrt[5]{3^5}=3$"],"check":"ok"},
"2":{"tp":"로그의 값","key":"$\\log_2 2^k=k$","sol":["$\\log_2 4+\\log_2 8=2+3=5$"],"check":"ok"},
"3":{"tp":"지수법칙과 근과 계수의 관계","key":"분자·분모를 $5$의 거듭제곱으로 정리","sol":["$\\alpha+\\beta=10$, $\\alpha\\beta=2$","(준식)$=\\dfrac{5^{\\frac{\\alpha+\\beta}{4}}}{5^{\\frac{\\alpha\\beta}{4}}}=5^{\\frac{10-2}{4}}=5^2$"],"check":"ok"},
"4":{"tp":"호도법과 삼각함수의 대소","key":"$1$(라디안)$\\approx57^\\circ$","sol":["$\\sin 1\\approx0.84$, $\\cos1\\approx0.54$, $\\tan1\\approx1.56$","$\\sin1^\\circ\\approx0.017$, $\\cos1^\\circ\\approx1.00$","가장 작은 값은 $\\sin 1^\\circ$"],"check":"ok"},
"5":{"tp":"로그의 실생활 활용","key":"$\\text{pH}=k \\Rightarrow x=10^{-k}$","sol":["pH 2: $x=10^{-2}$, pH 6: $x=10^{-6}$","$\\dfrac{10^{-2}}{10^{-6}}=10^4$(배)"],"check":"ok"},
"6":{"tp":"삼각함수 값과 지수·로그의 대소","key":"$\\dfrac{\\pi}{3}\\lt x\\lt\\dfrac{\\pi}{2}$에서 $\\sin x\\gt\\cos x\\gt0$","sol":["ㄱ. $\\sin x\\gt\\dfrac{\\sqrt3}{2}\\gt\\dfrac12\\gt\\cos x$ (참)","ㄴ. $4^{\\sin x}=2^{2\\sin x}$이고 $2\\sin x\\gt\\cos x$이므로 $4^{\\sin x}\\gt2^{\\cos x}$ (거짓)","ㄷ. $\\tan x=\\dfrac{\\sin x}{\\cos x}\\gt\\sin x$, 밑이 $1$보다 작으므로 $\\log_{\\frac17}\\sin x\\gt\\log_{\\frac17}\\tan x$ (참)"],"check":"ok"},
"7":{"tp":"로그부등식과 집합","key":"$(\\log_2x-k)^2\\le1$","sol":["$A=\\{2,3,4,5,6,7\\}$","$k-1\\le\\log_2x\\le k+1$에서 $2^{k-1}\\le x\\le2^{k+1}$","$k=1$: $\\{2,3,4\\}$(3개), $k=2$: $\\{2,\\cdots,7\\}$(6개), $k=3$: $\\{4,5,6,7\\}$(4개)","$\\therefore k=3$"],"check":"ok"},
"8":{"tp":"지수함수가 감소할 조건","key":"밑 $0\\lt(\\text{밑})\\lt1$","sol":["밑 $=\\dfrac{a^2-3a+3}{2}$이고 $a^2-3a+3\\gt0$은 항상 성립","$\\dfrac{a^2-3a+3}{2}\\lt1\\iff a^2-3a+1\\lt0\\iff\\dfrac{3-\\sqrt5}{2}\\lt a\\lt\\dfrac{3+\\sqrt5}{2}$","정수 $a=1,2$ → $2$개"],"check":"ok"},
"9":{"tp":"사분면에 따른 삼각함수의 부호","key":"$\\sin\\theta\\lt0$, $\\cos\\theta\\lt0$ (제3사분면)","sol":["$\\cos\\theta\\tan\\theta=\\sin\\theta\\lt0$, $\\sin\\theta\\cos\\theta\\gt0$이므로 $\\cos\\theta\\lt0$","$|3\\sin\\theta+2\\cos\\theta|=-3\\sin\\theta-2\\cos\\theta$, $|2\\cos\\theta|=-2\\cos\\theta$, $|1-5\\sin\\theta|=1-5\\sin\\theta$","(준식)$=-3\\sin\\theta-2\\cos\\theta+2\\cos\\theta+1-5\\sin\\theta=1-8\\sin\\theta$"],"check":"원본 스캔에서 두 번째 연산 기호가 흐림. '−|2cosθ|'로 읽어야 보기 ①이 나오므로 −로 옮김"},
"10":{"tp":"거듭제곱근이 자연수일 조건","key":"지수의 짝수·3의 배수 조건","sol":["$\\dfrac{n}{5}=3^a5^{b-1}$이 제곱수: $a$ 짝수, $b$ 홀수","$\\dfrac{n}{3}=3^{a-1}5^b$이 세제곱수: $a\\equiv1\\pmod 3$, $b\\equiv0\\pmod3$","최소 $a=4$, $b=3$ → $a+b=7$"],"check":"ok"},
"11":{"tp":"역함수 관계와 삼각형의 넓이","key":"Q는 P를 $y=x$에 대칭, R은 $y=x$ 위","sol":["두 함수는 역함수 관계이므로 $\\text{Q}(3,25)$, R$(r,r)$","$\\overline{\\text{PQ}}=22\\sqrt2$, R과 직선 $x+y=28$ 사이 거리 $\\dfrac{28-2r}{\\sqrt2}$","넓이 $11(28-2r)=286$ → $r=1$","$a-b=1$, $a^3=25+b$ → $a^3-a-24=0$ → $a=3$, $b=2$","$a+b=5$"],"check":"ok"},
"12":{"tp":"삼각함수의 성질과 식의 값","key":"$\\sin\\alpha=s$, $\\cos\\beta=c$로 치환","sol":["$s+c=\\dfrac56$, $(1-s^2)(1-c^2)=\\dfrac23$","$1-(s^2+c^2)+s^2c^2=\\dfrac23$, $s^2+c^2=\\dfrac{25}{36}-2p$ ($p=sc$)","$p^2+2p-\\dfrac{13}{36}=0$ → $p=\\dfrac16$ ($p=-\\dfrac{13}{6}$은 부적합)","$\\dfrac{b}{a}=\\dfrac16$ → $a+b=7$"],"check":"ok"},
"13":{"tp":"실수인 n제곱근의 개수","key":"$n$ 홀수→1개, $n$ 짝수→부호에 따라 2,1,0개","sol":["$f(5)\\sim f(9)$: $1,0,1,0,1$, $f(10)=1$, $n\\ge11$: 홀수 1, 짝수 2","누적합: $m=15$일 때 11, $16$: 13, $17$: 14, $18$: 16, $19$: 17, $20$: 19","$m=16,17,18,19$ → 합 $70$"],"check":"ok"},
"14":{"tp":"밑이 1보다 작은 로그부등식","key":"진수 조건 + 부등호 방향 반대","sol":["진수 조건: $x\\gt4$","밑이 $\\dfrac12$이므로 $2x-8\\le x-2$ → $x\\le6$","$\\therefore 4\\lt x\\le6$"],"check":"ok"},
"15":{"tp":"감소하는 지수함수의 최대·최소","key":"$x=-1$에서 최대, $x=a$에서 최소","sol":["최댓값: $\\left(\\dfrac12\\right)^{b-1}+5=9$ → $2^{1-b}=4$ → $b=-1$","최솟값: $\\left(\\dfrac12\\right)^{a-1}+5=\\dfrac{11}{2}$ → $a=2$","$ab=-2$"],"check":"ok"},
"16":{"tp":"cos² 합과 여각 관계","key":"$\\cos^2\\theta+\\cos^2\\left(\\dfrac{\\pi}{2}-\\theta\\right)=1$","sol":["$\\overline{\\text{OQ}_k}=\\left|\\cos\\dfrac{k\\pi}{18}\\right|$","$\\cos^2\\dfrac{k\\pi}{18}+\\cos^2\\dfrac{(9-k)\\pi}{18}=1$ ($k=1,\\cdots,8$에서 4쌍) → $4$","$k=9$일 때 $0$, $k=10\\sim17$도 대칭으로 $4$","합 $=8$"],"check":"ok"},
"17":{"tp":"cos에 대한 이차함수의 최대·최소","key":"$t=\\cos x\\in[-1,1]$로 치환","sol":["$y=-\\sin^2x+2k\\cos x+4k+1=t^2+2kt+4k$","꼭짓점 $t=-k$가 $[-1,1]$ 안: $-k^2+4k=4$ → $k=2$ (모순)","$k\\gt1$: $t=-1$에서 최소 $1+2k=4$ → $k=\\dfrac32$","$k\\lt-1$: $t=1$에서 최소 $1+6k=4$ → 모순","최댓값 $t=1$: $1+6k=10$ → $a=10$"],"check":"ok"},
"18":{"tp":"지수함수 평행이동과 넓이","key":"$(1,-2)$ 평행이동이 직선 방향, $\\overline{\\text{CD}}\\parallel\\overline{\\text{AB}}$","sol":["$y=a^{x+1}+3$을 $(1,-2)$만큼 옮기면 $y=a^x+1$, 이 이동은 직선 $y=-2x+14$ 위를 따라 움직임 → $x_{\\text{Q}}=x_{\\text{P}}+1$","$2\\overline{\\text{AP}}=\\overline{\\text{QB}}$ → $2x_{\\text{P}}=7-x_{\\text{Q}}$ → $x_{\\text{P}}=2$, P$(2,10)$, Q$(3,8)$","$a^3+1=8$ → $a=\\sqrt[3]{7}$","C$(0,2)$, D$(1,0)$이고 CD의 기울기 $-2$이므로 C, D에서 직선까지 거리 같음: $\\dfrac{12}{\\sqrt5}$","$S_1+S_2=\\dfrac12\\cdot\\overline{\\text{PB}}\\cdot\\dfrac{12}{\\sqrt5}=\\dfrac12\\cdot5\\sqrt5\\cdot\\dfrac{12}{\\sqrt5}=30$"],"check":"a=∛7로 값이 깔끔하지 않음(문제 조건대로 풀이). 답안 없음 — 확인 권장"}
}
