{
"1":{"tp":"제곱근의 뜻","key":"양수의 제곱근은 2개, 제곱근 $a$는 $\\sqrt a$","sol":["① $1$의 제곱근은 $\\pm1$로 2개 (×)","② 제곱근 7은 $\\sqrt7$ (×)","③ 제곱근 2는 $\\sqrt2$, 2의 제곱근은 $\\pm\\sqrt2$ (×)","④ $-16$은 제곱근이 없다 (×)","⑤ $\\sqrt{(-36)^2}=36$, 음의 제곱근은 $-6$ (○)"],"check":"ok"},
"2":{"tp":"곱셈 공식","key":"$(a\\pm b)^2=a^2\\pm2ab+b^2$","sol":["① $x^2-2x+1$ ② $a^2-\\dfrac23a+\\dfrac19$ ③ $x^2-\\dfrac14$","④ $4a^2+20ab+25b^2$","⑤ $\\dfrac94x^2-12x+16$ (○)"],"check":"ok"},
"3":{"tp":"전개 결과가 같은 식","key":"$(-a-b)^2=(a+b)^2$, $(b-a)^2=(a-b)^2$","sol":["ㄱ과 ㄹ: $a^2+2ab+b^2$","ㄴ과 ㅂ: $a^2-2ab+b^2$","정답 ①, ③"],"check":"ok"},
"4":{"tp":"실수의 성질","key":"두 정수 사이의 정수는 유한개","sol":["①~④는 옳다","⑤ 예: 1과 2 사이에는 정수가 없다 (×)"],"check":"ok"},
"5":{"tp":"넓이를 인수분해","key":"넓이의 합 $x^2+6x+5$","sol":["넓이의 합 $x^2+6x+5=(x+1)(x+5)$","둘레 $=2\\{(x+1)+(x+5)\\}=4x+12$"],"check":"ok"},
"6":{"tp":"근호 혼합 계산","key":"분모의 유리화 후 동류항 정리","sol":["$\\dfrac{4\\sqrt2-\\sqrt{15}}{\\sqrt3}=\\dfrac{4\\sqrt6}{3}-\\sqrt5$","$\\sqrt2(\\sqrt{12}+\\sqrt{10})=2\\sqrt6+2\\sqrt5$","(준식)$=-\\dfrac{2}{3}\\sqrt6-3\\sqrt5$ → $a=-\\dfrac23$, $b=-3$","$3a-b=-2+3=1$"],"check":"ok"},
"7":{"tp":"실수의 대소 비교","key":"근삿값 또는 부호로 비교","sol":["$a=9-\\sqrt5\\approx6.76$, $c=8-\\sqrt7\\approx5.35$","$d=-c\\approx-5.35$, $b=-a\\approx-6.76$","$b\\lt d\\lt c\\lt a$"],"check":"ok"},
"8":{"tp":"제곱근의 계산","key":"$\\sqrt{a^2}=|a|$","sol":["① 계산 불가 ② $0.8\\div2=0.4$","③ $20\\div4=5$ (○)","④ $3-7=-4$ ⑤ $3\\times5=15$"],"check":"ok"},
"9":{"tp":"유리화 후 식의 값","key":"$x^2-y^2=(x+y)(x-y)$","sol":["$x=(\\sqrt3-\\sqrt2)^2=5-2\\sqrt6$, $y=5+2\\sqrt6$","$x+y=10$, $x-y=-4\\sqrt6$","$x^2-y^2=-40\\sqrt6$"],"check":"ok"},
"10":{"tp":"$\\sqrt{A^2}=|A|$","key":"$-1\\lt a\\lt0$이면 $\\dfrac1a\\lt-1$","sol":["$a-\\dfrac1a\\gt0$ → $\\sqrt{\\left(a-\\dfrac1a\\right)^2}=a-\\dfrac1a$","$\\sqrt{\\left(\\dfrac1a-a\\right)^2}=a-\\dfrac1a$, $\\sqrt{a^2}=-a$","합 $=a-\\dfrac2a$"],"check":"ok"},
"11":{"tp":"수직선 위의 무리수","key":"대각선 8인 정사각형의 한 변 $4\\sqrt2$","sol":["$\\overline{\\text{OB}}=8$이 대각선이므로 $\\overline{\\text{OA}}=\\dfrac{8}{\\sqrt2}=4\\sqrt2$","P는 O의 왼쪽: $-4\\sqrt2$"],"check":"ok"},
"12":{"tp":"제곱근표 활용","key":"소수점을 두 자리씩 이동","sol":["$\\sqrt{868}=10\\sqrt{8.68}=29.46$","$\\sqrt b=0.1442=\\dfrac{1.442}{10}$ → $b=\\dfrac{2.08}{100}=0.0208$","$a+100b=29.46+2.08=31.54$"],"check":"원본 표가 잘려 있어 표를 재구성함(값은 실제 제곱근 값)"},
"13":{"tp":"격자점 정사각형","key":"변의 벡터 (가로칸, 세로칸)","sol":["가능한 한 변: 가로·세로 $1,2,3$칸 → $\\sqrt2,\\,2\\sqrt2,\\,3\\sqrt2$","대각 방향 $(1,1)$ → $\\sqrt2\\cdot\\sqrt2=2$ (유리수)","$(1,2)$ → $\\sqrt2\\cdot\\sqrt5=\\sqrt{10}$","무리수인 길이: $\\sqrt2,2\\sqrt2,3\\sqrt2,\\sqrt{10}$ → $4$개"],"check":"ok"},
"14":{"tp":"완전제곱식 조건","key":"$x^2+bx+c$: $c=\\left(\\dfrac b2\\right)^2$","sol":["① $16$ ② $9$ ③ $2$ ④ $36$ ⑤ $24$","가장 큰 것 ④"],"check":"ok"},
"15":{"tp":"인수분해와 인수","key":"공통인수로 두 번 묶기","sol":["$4x(y-2)-2(y-2)=(4x-2)(y-2)=2(2x-1)(y-2)$","인수: $2$, $2x-1$, $y-2$, $4x-2$","$2x$는 인수가 아님"],"check":"ok"},
"16":{"tp":"직사각형 넓이 전개","key":"$(6x+4)(4x-3)$","sol":["$(6x+4)(4x-3)=24x^2-18x+16x-12=24x^2-2x-12$"],"check":"ok"},
"17":{"tp":"새로운 연산","key":"정의대로 대입","sol":["$ab=(\\sqrt3-1)\\cdot\\dfrac{1}{\\sqrt3}=1-\\dfrac{\\sqrt3}{3}$","$-\\sqrt3a=-3+\\sqrt3$","합: $1-\\dfrac{\\sqrt3}{3}-3+\\sqrt3+2=\\dfrac{2\\sqrt3}{3}$"],"check":"ok"},
"18":{"tp":"비례식과 근호","key":"$a=k(\\sqrt3+\\sqrt2)$ 등으로 놓기","sol":["$a+b+c=k\\cdot2\\sqrt5=\\sqrt{10}$ → $k=\\dfrac{\\sqrt2}{2}$","$a+b-c=k(\\sqrt3+\\sqrt2+\\sqrt5-\\sqrt2-\\sqrt5+\\sqrt3)=2\\sqrt3k=\\sqrt6$"],"check":"ok"},
"19":{"tp":"완전제곱식 조건","key":"$x^2-4ax+2b$에서 $2b=4a^2$","sol":["합: $x^2-4ax+2b$","완전제곱식: $2b=(2a)^2$ → $b=2a^2$","$b\\le50$ → $a\\le5$, $(5,50)$에서 $a+b=55$"],"check":"ok"},
"20":{"tp":"조건식 변형","key":"$a\\ne b$로 약분 → $a+b=-3$","sol":["(다): $-(a-b)(b+1)=(a-b)(a+2)$, $a\\ne b$ → $a+b=-3$","$ab=-4$, $a\\gt b$ → $a=1$, $b=-4$","$(a-b)(a^2+b^2)=5\\times17=85$"],"check":"ok"},
"21":{"tp":"지수와 곱셈 공식","key":"두 식을 곱하기","sol":["$2^{6x}\\cdot2^{6y}=(6-2\\sqrt5)(6+2\\sqrt5)=36-20=16=2^4$","$6(x+y)=4$ → $x+y=\\dfrac23$","$(x+y)^2=\\dfrac49$"],"check":"ok"},
"22":{"tp":"정수 부분·소수 부분","key":"$A=n+1$, $B=\\sqrt3-1$","sol":["$A^2-B^2=(n+1)^2-(4-2\\sqrt3)=n^2+2n-3+2\\sqrt3$","$0\\lt2n-3\\lt7$ → $\\dfrac32\\lt n\\lt5$","$n=2,3,4$ → 합 $9$"],"check":"ok"},
"23":{"tp":"정육면체 전개도와 다항식","key":"마주보는 면 짝 찾기","sol":["마주보는 면: $(x-2)$와 $(x+6)$, $(x+2)$와 $(2x-1)$, $(x^2+1)$과 $(-1)$","$A+B+C=(x^2+4x-12)+(2x^2+3x-2)+(-x^2-1)$","$=2x^2+7x-15=(2x-3)(x+5)$"],"check":"ok"},
"24":{"tp":"겹친 정사각형 둘레","key":"겹친 정사각형의 한 변은 작은 정사각형 한 변의 $\\dfrac12$","sol":["한 변: $\\sqrt3,\\,\\sqrt7,\\,2\\sqrt3,\\,2\\sqrt7$, 둘레 합 $12\\sqrt3+12\\sqrt7$","겹친 부분의 한 변: $\\dfrac{\\sqrt3}{2},\\,\\dfrac{\\sqrt7}{2},\\,\\sqrt3$","겹칠 때마다 $4\\times$(겹친 한 변)씩 줄어듦: $4\\left(\\dfrac{3\\sqrt3}{2}+\\dfrac{\\sqrt7}{2}\\right)=6\\sqrt3+2\\sqrt7$","둘레 $=6\\sqrt3+10\\sqrt7$"],"check":"ok"},
"25":{"tp":"인수분해로 조건 정리","key":"두 식을 빼서 인수분해","sol":["$a^2-b^2+bc-ac=(a-b)(a+b-c)=0$, $a\\ne b$ → $c=a+b$","$a^2+b(a+b)=5$ → $a^2+ab+b^2=5$","$a^2+b^2+(a+b)^2=2(a^2+ab+b^2)=10$"],"check":"ok"}
}
