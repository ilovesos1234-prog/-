{
"1":{"tp":"넓이에서 변의 길이","key":"넓이를 인수분해해 가로를 구한다","sol":["$2x^2+5x-12=(x+4)(2x-3)$","가로 $=2x-3$","둘레 $=2\\{(x+4)+(2x-3)\\}=6x+2$"],"check":"ok"},
"3":{"tp":"치환과 소수 조건","key":"$a+b=t$로 치환하면 $(t+12)(t-6)$","sol":["$t^2+6t-72=(t+12)(t-6)$","$t+12\\gt 1$이므로 소수가 되려면 $t-6=1$, $t=7$ (값은 $19$, 소수)","$a+b=7$인 자연수 순서쌍: $(1,6),\\cdots,(6,1)$ → $6$개"],"check":"ok"},
"5":{"tp":"이차방정식 찾기","key":"정리하여 (이차식)$=0$ 꼴인지","sol":["ㄱ: $0=6x+9$ (일차방정식)","ㄴ: 등식이 아니다","ㄷ: $x^2-2x-3=0$ (이차방정식)","ㄹ: $x^2-x-1=0$ (이차방정식)","따라서 ㄷ, ㄹ"],"check":"ok"},
"6":{"tp":"해 대입","key":"$x=2$를 대입해 등식이 성립하는지 확인","sol":["① $0=0$ ② $4-2-2=0$ ④ $5\\times 0=0$","③ $8-6-1=1\\ne 0$","⑤ 좌변 $2\\times(-1)=-2$, 우변 $8-2-8=-2$","따라서 ③"],"check":"ok"},
"7":{"tp":"한 근 대입","key":"$x=-2$ 대입으로 $k$를 구한다","sol":["$12+2k+k=0$ → $k=-4$","$3x^2+4x-4=0$ → $(3x-2)(x+2)=0$","다른 한 근 $x=\\dfrac{2}{3}$"],"check":"ok"},
"8":{"tp":"근의 공식","key":"$a=-\\dfrac{1}{2}$, $b=2$","sol":["$(2x+1)(x-2)=0$ → $a=-\\dfrac{1}{2}$, $b=2$","$-\\dfrac{1}{2}x^2+4x-2=0$ → $x^2-8x+4=0$","$x=4\\pm\\sqrt{16-4}=4\\pm 2\\sqrt{3}$"],"check":"ok"},
"9":{"tp":"중근 조건","key":"$(m-2)^2=m^2$","sol":["중근이려면 $\\{(m-2)\\}^2-m^2=0$","$-4m+4=0$ → $m=1$"],"check":"ok"},
"11":{"tp":"두 근 사이의 정수","key":"근의 공식으로 두 근의 범위를 어림","sol":["$x=\\dfrac{-5\\pm\\sqrt{61}}{6}$, $7\\lt\\sqrt{61}\\lt 8$","작은 근: $-\\dfrac{13}{6}\\lt x\\lt -2$, 큰 근: $\\dfrac{1}{3}\\lt x\\lt\\dfrac{1}{2}$","사이의 정수: $-2,\\,-1,\\,0$ → $3$개"],"check":"ok"},
"12":{"tp":"높이에 대한 부등식","key":"$-5t^2+25t+1=21$의 두 근 사이","sol":["$-5t^2+25t+1=21$ → $t^2-5t+4=0$ → $t=1,\\,4$","$1\\le t\\le 4$일 때 $21\\,\\text{m}$ 이상","$4-1=3$초 동안"],"check":"ok"},
"13":{"tp":"직선 위의 점과 넓이","key":"Q $(x,\\ -2x+16)$, 넓이 $x(-2x+16)=30$","sol":["$x(-2x+16)=30$ → $x^2-8x+15=0$ → $x=3,\\,5$","R의 $y$좌표: $x=3$이면 $10$, $x=5$이면 $6$","합 $=16$"],"check":"ok"},
"15":{"tp":"원의 넓이","key":"$\\pi(r+3)^2=2\\pi r^2$","sol":["$r+3=\\sqrt{2}r$ ($r\\gt 0$)","$r=\\dfrac{3}{\\sqrt{2}-1}=3(\\sqrt{2}+1)$","$r=(3+3\\sqrt{2})\\,\\text{cm}$"],"check":"ok"},
"16":{"tp":"좌표로 넓이 구하기","key":"한 변을 $s$로 놓고 좌표로 삼각형 넓이를 나타낸다","sol":["B $(0,0)$, C $(s,0)$, E $(s,3)$, F $(s-3,s)$, G $(2s-3,0)$","$\\overrightarrow{EG}=(s-3,-3)$, $\\overrightarrow{EF}=(-3,s-3)$","넓이 $=\\dfrac{1}{2}\\{(s-3)^2-9\\}=10$ → $(s-3)^2=29$","$s=3+\\sqrt{29}$, $a+b=3+29=32$"],"check":"ok"},
"17":{"tp":"이차함수 찾기","key":"$y=(x$의 이차식$)$","sol":["① $y=10\\pi x$ ② $y=8x^3$ ③ $y=150x$ ④ $y=\\dfrac{3}{4}x$","⑤ $y=6\\pi x^2$ → 이차함수"],"check":"ok"},
"18":{"tp":"지나는 점","key":"대입해서 $a$, $b$","sol":["$9a=3$ → $a=\\dfrac{1}{3}$","$b=\\dfrac{1}{3}\\times 36=12$","$ab=4$"],"check":"ok"},
"19":{"tp":"그래프의 성질","key":"꼭짓점 $(3,0)$, 위로 볼록","sol":["ㄱ: 축은 $x=3$ (×)","ㄴ: $x=3$일 때 $y=0$ (×)","ㄷ: $|-4|\\gt|-2|$이므로 폭이 좁다 (○)","ㄹ: $x\\lt 3$에서 증가 (×)","ㅁ: 계수의 부호만 반대 → $x$축 대칭 (○)"],"check":"ok"},
"20":{"tp":"평행이동","key":"$y=-2(x-p)^2+q$의 꼭짓점 $(p,q)$","sol":["$p=-2$, $q=5$","$y=-2(x+2)^2+5$에 $x=0$: $a=-8+5=-3$","$p+q+a=0$"],"check":"ok"},
"21":{"tp":"지나는 사분면","key":"꼭짓점과 $y$절편, 볼록 방향을 본다","sol":["ㄱ: 꼭짓점 $(0,4)$, 아래로 볼록 → 제1, 2사분면","ㄴ: 꼭짓점 $(-6,0)$, 위로 볼록 → 제3, 4사분면 (제2사분면 ×)","ㄷ: 꼭짓점 $(0,1)$, 위로 볼록 → 모든 사분면","ㄹ: 꼭짓점 $(2,1)$, $y$절편 $-3$ → 제1, 3, 4사분면 (제2사분면 ×)","ㅁ: $y$절편 $13$ → 제2사분면 지남","따라서 ㄴ, ㄹ"],"check":"ok"},
"22":{"tp":"꼭짓점 조건","key":"대입 후 꼭짓점 $(p,\\ 4p^2)$의 위치로 고른다","sol":["$-2(2-p)^2+4p^2=2$ → $2p^2+8p-10=0$","$p^2+4p-5=0$ → $p=1$ 또는 $p=-5$","꼭짓점 $(p,\\ 4p^2)$이 제2사분면 → $p\\lt 0$","$p=-5$"],"check":"ok"},
"23":{"tp":"포물선과 정사각형","key":"A $(t,\\ t^2)$, D $\\left(t,\\ -\\dfrac{t^2}{4}\\right)$","sol":["가로 $=2t$, 세로 $=t^2+\\dfrac{t^2}{4}=\\dfrac{5}{4}t^2$","$2t=\\dfrac{5}{4}t^2$ → $t=\\dfrac{8}{5}$","둘레 $=4\\times 2t=\\dfrac{64}{5}$"],"check":"ok"},
"24":{"tp":"영역 안의 격자점","key":"교점 $x=\\pm\\sqrt{6}$, $x=-2,\\cdots,2$에서 $2x^2\\lt y\\lt x^2+6$","sol":["$2x^2=x^2+6$ → $x=\\pm\\sqrt{6}$, 정수 $x$는 $-2$부터 $2$","$x=0$: $0\\lt y\\lt 6$ → $5$개","$x=\\pm1$: $2\\lt y\\lt 7$ → $4$개씩, $8$개","$x=\\pm2$: $8\\lt y\\lt 10$ → $1$개씩, $2$개","합 $15$개"],"check":"ok"},
"25":{"tp":"선분의 내분점과 포물선","key":"BC:CD:DA=1:2:1이면 C, D는 AB를 1:3, 3:1로 나누는 점","sol":["A $(8,0)$, B $(0,8)$","C $(2,\\ 6)$, D $(6,\\ 2)$","$4a=6$ → $a=\\dfrac{3}{2}$, $36b=2$ → $b=\\dfrac{1}{18}$","$ab=\\dfrac{1}{12}$"],"check":"ok"}
}
