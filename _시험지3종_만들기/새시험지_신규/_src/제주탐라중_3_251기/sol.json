{
"1":{"tp":"인수분해로 풀기","key":"$3x^2-5x-12=(3x+4)(x-3)$","sol":["$(3x+4)(x-3)=0$","$x=3$ 또는 $x=-\\dfrac{4}{3}$"],"check":"ok"},
"2":{"tp":"이차방정식 찾기","key":"정리했을 때 (이차식)$=0$ 꼴인지 확인","sol":["ㄱ: $2x^2-2x+1=0$ (이차방정식)","ㄴ: $-2x+1=0$ (일차방정식)","ㄷ: 분모에 $x$가 있어 이차방정식이 아니다","ㄹ: 등식이 아니다","ㅁ: $-x^2-3x+2=0$ (이차방정식)","따라서 $2$개"],"check":"ok"},
"4":{"tp":"꼭짓점과 축","key":"$y=a(x-p)^2+q$의 꼭짓점 $(p,\\ q)$, 축 $x=p$","sol":["꼭짓점 $(2,\\ -4)$","축은 직선 $x=2$"],"check":"ok"},
"5":{"tp":"x축 대칭","key":"$x$축 대칭이면 $x^2$의 계수의 부호가 반대","sol":["$a=5$","$y=5x^2$에 $x=-2$ 대입: $b=20$","$a+b=25$"],"check":"ok"},
"6":{"tp":"근의 공식과 계수 비교","key":"짝수 공식 $x=\\dfrac{2\\pm\\sqrt{4+5A}}{A}$","sol":["$Ax^2-4x-5=0$ → $x=\\dfrac{2\\pm\\sqrt{4+5A}}{A}$","분모 비교: $A=3$","$B=4+15=19$","$A+B=22$"],"check":"ok"},
"7":{"tp":"두 근의 곱","key":"양변에 $6$을 곱해 정수 계수로","sol":["$18x-2(x^2-2)=3(x-2)$","$-2x^2+15x+10=0$ → $2x^2-15x-10=0$","두 근의 곱 $=\\dfrac{-10}{2}=-5$"],"check":"ok"},
"8":{"tp":"한 근 대입 후 다른 근","key":"$x=2$ 대입 → $a$ 구하고 $a\\ne 2$ 확인","sol":["$4(a-2)+2(a^2+5)+a^2+2a-26=0$ → $3a^2+6a-24=0$","$a^2+2a-8=0$ → $a=2$ 또는 $a=-4$","이차방정식이므로 $a\\ne 2$, $a=-4$","$-6x^2+21x-18=0$ → $2x^2-7x+6=0$ → $(2x-3)(x-2)=0$","다른 한 근 $x=\\dfrac{3}{2}$"],"check":"ok"},
"9":{"tp":"중근 조건과 근과 계수","key":"$9x^2-(2k+1)x+1=(3x\\pm1)^2$","sol":["중근 조건: $(2k+1)^2=4\\times 9=36$ → $2k+1=\\pm 6$","$k=\\dfrac{5}{2}$ 또는 $k=-\\dfrac{7}{2}$","두 근의 합 $-1=-a$ → $a=1$, 곱 $-\\dfrac{35}{4}=b$","$a-4b=1+35=36$"],"check":"ok"},
"10":{"tp":"근을 대입하여 식 변형","key":"$k$를 대입한 식을 $k$로 나눈다","sol":["$3k^2-(2a+5)k+3=0$, $k\\ne 0$이므로 $k$로 나누면","$3\\left(k+\\dfrac{1}{k}\\right)=2a+5$","$3a=2a+5$ → $a=5$"],"check":"ok"},
"11":{"tp":"나누어 주기","key":"(학생 수)$\\times$(1인당 개수)$=270$","sol":["학생 수 $x$명: $x(x-3)=270$","$x^2-3x-270=0$ → $(x-18)(x+15)=0$","$x=18$"],"check":"ok"},
"12":{"tp":"그래프의 폭","key":"색칠한 부분에 그려지는 $y=ax^2$는 $-1\\lt a\\lt\\dfrac{5}{2}$, $a\\ne0$","sol":["두 그래프 사이에 있으려면 $-1\\lt a\\lt \\dfrac{5}{2}$","① $-\\dfrac{4}{3}\\lt -1$이므로 그려지지 않는다","②③④⑤는 범위 안에 있다"],"check":"ok"},
"13":{"tp":"선분의 내분점","key":"A, B의 $x$좌표로 C의 위치를 구한다","sol":["A $\\left(0,\\ \\dfrac{9}{2}\\right)$, $\\dfrac{1}{2}x^2=\\dfrac{9}{2}$ → B $\\left(3,\\ \\dfrac{9}{2}\\right)$","B에 가까운 삼등분점 C $\\left(2,\\ \\dfrac{9}{2}\\right)$","$4a=\\dfrac{9}{2}$ → $a=\\dfrac{9}{8}$"],"check":"ok"},
"14":{"tp":"그래프의 성질","key":"$y=-\\dfrac{1}{3}(x+3)^2+4$","sol":["$y=-\\dfrac{1}{3}(x^2+6x+9)+3+1=-\\dfrac{1}{3}(x+3)^2+4$","꼭짓점 $(-3,\\ 4)$, 축 $x=-3$ → ②④ 옳다","$y$절편 $1$, 위로 볼록, 꼭짓점이 제2사분면 → 모든 사분면을 지난다 ①","$x=1$: $-\\dfrac{1}{3}-2+1=-\\dfrac{4}{3}\\ne 0$ → ③ 옳지 않다","⑤ 축의 오른쪽에서 감소 → 옳다"],"check":"ok"},
"15":{"tp":"평행이동","key":"두 그래프의 꼭짓점 비교","sol":["$y=\\dfrac{1}{4}(x-6)^2-3$, 꼭짓점 $(6,\\ -3)$","$y=\\dfrac{1}{4}(x-3)^2+2$, 꼭짓점 $(3,\\ 2)$","$m=3-6=-3$, $n=2-(-3)=5$","$m+n=2$"],"check":"ok"},
"16":{"tp":"축의 대칭성","key":"$y$좌표가 같은 두 점의 중점이 축","sol":["축: $p=\\dfrac{-4+6}{2}=1$","$(6,\\ 1)$ 대입: $-(6-1)^2+q=1$ → $q=26$","$p+q=27$"],"fix_ans":"③","check":"원본 빠른 정답은 ④(28)이나, 두 점의 중점으로 p=1, q=26이므로 p+q=27(③). 문항 조건 그대로라면 ③이 맞다."},
"17":{"tp":"꼭짓점이 주어진 식","key":"$y=a(x-2)^2+11$","sol":["$(3,\\ 9)$ 대입: $a+11=9$ → $a=-2$","$y=-2(x-2)^2+11=-2x^2+8x+3$","$c=3$"],"check":"ok"},
"18":{"tp":"넓이로 꼭짓점 구하기","key":"꼭짓점의 $x$좌표는 $-3$, 넓이로 $y$좌표를 구한다","sol":["$\\triangle ABO=\\dfrac{1}{2}\\times 6\\times h=36$ → $h=12$, A $(-3,\\ 12)$","$9a-3b+c$는 $x=-3$일 때의 함숫값","따라서 $9a-3b+c=12$"],"check":"ok"},
"19":{"tp":"꼭짓점이 x축 위","key":"$y=a(x+5)^2$","sol":["꼭짓점 $(-5,\\ 0)$이므로 $y=a(x+5)^2$","$y$절편 $25a=-5$ → $a=-\\dfrac{1}{5}$","$a+b+c$는 $x=1$일 때의 함숫값: $-\\dfrac{1}{5}\\times 36=-\\dfrac{36}{5}$"],"check":"ok"},
"20":{"tp":"모든 사분면을 지날 조건","key":"꼭짓점 $(1,\\ 8)$이 제1사분면 → 위로 볼록, $y$절편이 양수","sol":["꼭짓점 $(1,\\ 8)$이 제1사분면에 있으므로 $a\\lt 0$ (그래야 제3, 4사분면을 지난다)","제2사분면을 지나려면 $y$절편 $a+8\\gt 0$ → $a\\gt -8$","$-8\\lt a\\lt 0$인 정수: $-7,\\,-6,\\,\\cdots,\\,-1$ → $7$개"],"fix_ans":"③","check":"원본 빠른 정답은 ②(6개)이나, -8<a<0의 정수는 -7~-1의 7개(③). a=-7일 때도 y절편이 1>0이라 모든 사분면을 지난다."},
"21":{"tp":"근이 유리수일 조건","key":"판별식 $9-4(a-1)=13-4a$가 완전제곱수","sol":["$13-4a\\ge 0$, 자연수 $a$: $a=1,\\,2,\\,3$","$a=1$: $9$ (제곱수), $a=2$: $5$ (아님), $a=3$: $1$ (제곱수)","합 $=1+3=4$"],"check":"ok"},
"22":{"tp":"반원의 넓이","key":"$\\overline{AC}=x$로 놓고 넓이 식을 세운다","sol":["$\\overline{AC}=x$, $\\overline{BC}=16-x$","큰 반원 $32\\pi$, 작은 반원들 $\\dfrac{\\pi}{8}\\{x^2+(16-x)^2\\}$","$32\\pi-\\dfrac{\\pi}{8}\\{x^2+(16-x)^2\\}=15\\pi$ → $x^2+(16-x)^2=136$","$x^2-16x+60=0$ → $x=6$ 또는 $x=10$","$\\overline{AC}\\gt\\overline{BC}$이므로 $\\overline{AC}=10$, $\\overline{BC}=6\\,\\text{cm}$"],"check":"ok"},
"24":{"tp":"두 포물선과 선분의 비","key":"A $\\left(-t,\\ \\dfrac{t^2}{4}\\right)$, C $\\left(-t,\\ -\\dfrac{t^2}{2}\\right)$","sol":["$\\overline{AB}=2t$, $\\overline{AC}=\\dfrac{t^2}{4}+\\dfrac{t^2}{2}=\\dfrac{3}{4}t^2$","$2t:\\dfrac{3}{4}t^2=8:9$ → $18t=6t^2$ → $t=3$","A의 $y$좌표 $=\\dfrac{9}{4}$이므로 $p=4$, $q=9$","$p+q=13$"],"check":"원본 편집본에 선택지가 없어 단답형으로 실음(원본 25번)."}
}
