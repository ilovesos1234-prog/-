{
"1":{"tp":"이차방정식 판별","key":"이항·정리 후 이차항이 남는지","sol":["① 삼차 ② ③ $x^2$이 소거되어 일차","④ $2x^2+2x-2=0$ → 이차방정식","⑤ 양변 $2x^2$이 같아 일차"],"check":"ok"},
"2":{"tp":"한 근이 주어질 때","key":"근을 대입해 $a$ 결정","sol":["$12a-2a-10=0\\Rightarrow a=1$","$3x^2-x-10=(3x+5)(x-2)=0$","다른 근 $-\\dfrac{5}{3}$"],"check":"ok"},
"3":{"tp":"제곱근을 이용한 풀이","key":"$x=3\\pm\\sqrt{\\dfrac{a}{3}}$","sol":["$b=3$, $\\sqrt{\\dfrac{a}{3}}=\\dfrac{\\sqrt{21}}{3}\\Rightarrow\\dfrac{a}{3}=\\dfrac{7}{3}$","$a=7$, $a-b=4$"],"check":"ok"},
"4":{"tp":"완전제곱식 만들기","key":"더하는 수는 $\\left(\\dfrac{b}{2a}\\right)^2$","sol":["㉢은 $\\dfrac{b^2}{4a^2}$이어야 한다","나머지는 옳다"],"check":"ok"},
"5":{"tp":"근을 대입해 계수 구하기","key":"두 식을 연립","sol":["$9+3a+b=0$, $1+b+a=0$","$a=-4$, $b=3$","$3x^2+11x-4=(3x-1)(x+4)=0$","$x=-4$ 또는 $x=\\dfrac{1}{3}$"],"check":"ok"},
"6":{"tp":"두 정사각형의 넓이","key":"두 변의 합 $15$, 제곱의 합 $135$","sol":["작은 변 $s$, 큰 변 $15-s$: $s^2+(15-s)^2=135$","$s^2-15s+45=0$, $s=\\dfrac{15\\pm\\sqrt{45}}{2}$","큰 정사각형의 변 $\\dfrac{15+\\sqrt{45}}{2}\\text{cm}$"],"check":"그림 원본 손상 → '두 정사각형 밑변 합 15cm' 라벨대로 다시 그림"},
"7":{"tp":"중근 조건","key":"$\\left(\\dfrac{5}{6}\\right)^2-4\\cdot\\dfrac{1}{4}k=0$","sol":["$k=\\dfrac{25}{36}$, $\\sqrt{k}=\\dfrac{5}{6}$","$6\\cdot\\dfrac{25}{36}-35\\cdot\\dfrac{5}{6}+p=0\\Rightarrow p=25$","$6x^2-35x+25=(6x-5)(x-5)$, 다른 근 $5$"],"check":"ok"},
"8":{"tp":"근을 식에 대입","key":"$a^2+5a=10$, $2b^2+3b=7$","sol":["식 $=(a^2+5a)+(2b^2+3b)+2a+2b+\\dfrac{3}{2}=17+2(a+b)+\\dfrac{3}{2}$","$a=\\dfrac{-5+\\sqrt{65}}{2}$, $b=\\dfrac{-3-\\sqrt{65}}{4}$","$2a+2b=-5+\\sqrt{65}-\\dfrac{3+\\sqrt{65}}{2}$","합 $=12+\\dfrac{\\sqrt{65}}{2}=\\dfrac{24+\\sqrt{65}}{2}$"],"check":"ok"},
"9":{"tp":"닮음과 이차방정식","key":"$\\triangle ADE\\sim\\triangle ACB$이므로 $\\overline{AD}\\cdot\\overline{AB}=\\overline{AE}\\cdot\\overline{AC}$","sol":["$4\\times 9=x(x+3)$","$x^2+3x-36=0$, $x=\\dfrac{-3+3\\sqrt{17}}{2}$"],"check":"그림 원본 손상 → 남은 라벨(4, 9, x, 3)과 정답에서 AD=4, AB=9, AE=x, EC=3으로 복원. 원본 확인 필요"},
"10":{"tp":"이차함수 판별","key":"$y=ax^2+bx+c$ ($a\\ne0$) 꼴","sol":["ㄱ 이차 ㄴ $y=360$ ㄷ $y=\\pi x^2$ 이차","ㄹ $y=\\dfrac{4}{3}(x^2+3x)$ 이차","ㅁ 세로 $=7+x-(x+3)=4$, $y=4x+12$ 일차","3개"],"check":"ok"},
"11":{"tp":"y=ax²의 성질","key":"꼭짓점 원점, 축 $x=0$","sol":["① 옳다","② $|a|$가 클수록 좁다 ③ 축은 $x=0$","④ $a$의 부호에 따라 다르다 ⑤ $y=a(x-p)^2$"],"check":"ok"},
"12":{"tp":"평행이동","key":"$x-1\\to x-3$, $3\\to 1$","sol":["$y=\\dfrac{2}{5}(x-3)^2+1$"],"check":"ok"},
"13":{"tp":"꼭짓점의 좌표","key":"$y=\\dfrac{1}{3}(x-2)^2+2$로 $a$, $b$ 결정","sol":["$\\dfrac{1}{3}(x-2)^2+2=\\dfrac{1}{3}x^2-\\dfrac{4}{3}x+\\dfrac{10}{3}$: $a=-\\dfrac{4}{3}$, $b=\\dfrac{10}{3}$","$y=\\dfrac{1}{3}x^2-\\dfrac{10}{3}x-\\dfrac{4}{3}=\\dfrac{1}{3}(x-5)^2-\\dfrac{29}{3}$","꼭짓점 $\\left(5,-\\dfrac{29}{3}\\right)$"],"check":"ok"},
"14":{"tp":"그래프와 넓이","key":"사다리꼴 ABOC","sol":["$y=-(x-3)^2+15$: A$(3,15)$, B$(3,0)$, C$(0,6)$","넓이 $=\\dfrac{1}{2}(6+15)\\times3=\\dfrac{63}{2}$"],"check":"그림 원본 손상 → 식대로 다시 그림"},
"15":{"tp":"계수 부호와 사분면","key":"직선에서 $a\\gt0$, $b\\gt0$","sol":["두 근의 합 $-a\\lt0$, 곱 $b\\gt0$ → 두 근 모두 음수","꼭짓점은 제3사분면, $y$절편 $b\\gt0$","제1, 2, 3사분면을 지나고 제4사분면은 지나지 않는다"],"check":"그림 원본 손상 → 정답이 요구하는 부호(a>0, b>0)의 예시 직선으로 다시 그림"},
"16":{"tp":"증가 범위와 확률","key":"축 $x=\\dfrac{a+b}{2}\\le 3$","sol":["$x\\gt 3$에서 증가 $\\iff a+b\\le 6$","합이 $6$ 이하인 경우: $1+2+3+4+5=15$가지","$\\dfrac{15}{36}=\\dfrac{5}{12}$"],"check":"ok"},
"17":{"tp":"그래프와 계수의 부호","key":"원점 통과 $c=0$, 아래로 볼록 $a\\gt0$, 축이 오른쪽 $b\\lt0$","sol":["$|b|+|a-b|-|ab|+2|ab|=|b|+|a-b|+|ab|$","$b\\lt0$, $a-b\\gt0$, $ab\\lt0$","$-b+a-b-ab=-ab+a-2b$"],"check":"그림 원본 손상 → 정답이 요구하는 부호(a>0, b<0, c=0)의 예시 포물선으로 다시 그림"},
"18":{"tp":"축의 대칭성","key":"$f(x)=k\\left(x-\\dfrac{5}{2}\\right)^2+q$","sol":["$f(7)-f(3)=k\\left(\\dfrac{81}{4}-\\dfrac{1}{4}\\right)=20k$","$f(0)-f(4)=k\\left(\\dfrac{25}{4}-\\dfrac{9}{4}\\right)=4k$","비 $=5$"],"check":"ok"},
"19":{"tp":"꼭짓점의 위치","key":"꼭짓점 $(2+a,\\ 9+2a)$","sol":["$y=-(x-2)^2+9$","제2사분면: $2+a\\lt0$, $9+2a\\gt0$","$-\\dfrac{9}{2}\\lt a\\lt -2$"],"check":"ok"},
"20":{"tp":"이차함수의 활용","key":"$y=kx^2$, 높이는 $(\\text{번째})^2$에 비례","sol":["$4$번째: $k(200)^2=9$","$5$번째: $9\\times\\dfrac{25}{16}=\\dfrac{225}{16}\\text{m}$"],"check":"그림 원본 손상 → 조건대로 기둥 그림을 다시 그림"},
"21":{"tp":"완전제곱식 풀이","key":"양변에 $a^2$ 더하기","sol":["$x^2+2ax=b+c$","$(x+a)^2=a^2+b+c$: $m=a$, $n=a^2+b+c$","$x=-a\\pm\\sqrt{a^2+b+c}$"],"check":"ok"},
"22":{"tp":"이차방정식의 활용","key":"높이 $x$, 밑변 $x+5$","sol":["$\\dfrac{1}{2}x(x+5)=207$","$x^2+5x-414=0$, $(x+23)(x-18)=0$","$x=18$, 밑변 $23$"],"check":"ok"},
"23":{"tp":"평행이동과 식 구하기","key":"$y$값이 같은 두 점으로 축 결정","sol":["평행이동: $y=a(x+5-p)^2+3+q$","$(-5,-4)$, $(-1,-4)$에서 축 $x=-3$ → $p=2$","$4a+3+q=-4$, $9a+3+q=-19$ → $a=-3$, $q=5$","$y=-3(x+3)^2+8=-3x^2-18x-19$"],"check":"ok"}
