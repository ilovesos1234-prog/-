{
"1":{"tp":"근호 밖의 수를 근호 안으로","key":"a√b = √(a²b)","sol":["$\\dfrac{1}{5}\\sqrt{50}=\\dfrac{1}{5}\\times5\\sqrt{2}=\\sqrt{2}$이므로 $a=2$","$-\\sqrt{162}=-9\\sqrt{2}$이므로 $b=-9$","$a-b=11$"],"check":"ok"},
"2":{"tp":"유리수가 될 조건","key":"무리수 부분의 계수가 0","sol":["$8-a\\sqrt{2}+\\sqrt{50}-15=-7+(5-a)\\sqrt{2}$","유리수이려면 $5-a=0$, $a=5$"],"check":"원본 식의 괄호가 빠져 있어 정답(5)에 맞게 √2(4√2−a)+√5(√10−3√5)로 복원"},
"3":{"tp":"√(a²)의 성질","key":"a≤0, b≥0이므로 2a−b≤0","sol":["$(-\\sqrt{-3a})^2=-3a$, $\\sqrt{(-5b)^2}=5b$","$\\sqrt{16(2a-b)^2}=4|2a-b|=-4(2a-b)$","$-3a+5b+8a-4b=5a+b$"],"check":"ok"},
"4":{"tp":"제곱근의 곱셈과 나눗셈","key":"÷(1/√k) = ×√k","sol":["③ $-\\sqrt{13}\\times\\sqrt{39}\\times\\dfrac{\\sqrt{3}}{3}=-\\dfrac{\\sqrt{13\\times117}}{3}=-\\dfrac{39}{3}=-13$","따라서 ③이 옳지 않다 (나머지는 계산이 맞다)"],"check":"ok"},
"5":{"tp":"제곱근표 읽기","key":"소수점을 두 자리씩 옮긴다","sol":["$\\sqrt{0.0611}=\\sqrt{\\dfrac{6.11}{100}}=\\dfrac{2.472}{10}=0.2472$","$24.96=2.496\\times10=\\sqrt{6.23}\\times10=\\sqrt{623}$, $b=623$"],"check":"원본 표가 잘려 있어 실제 제곱근 값으로 6.0~6.2행을 채움"},
"6":{"tp":"제곱근의 대소와 소수","key":"9 < ab+4 < 25 ⇒ 5 < ab < 21","sol":["$ab=6,9,10,14,15$가 가능 ($2\\times3$, $3\\times3$, $2\\times5$, $2\\times7$, $3\\times5$)","순서쌍: $(2,3),(3,2),(3,3),(2,5),(5,2),(2,7),(7,2),(3,5),(5,3)$","$9$개"],"check":"ok"},
"7":{"tp":"수직선 위의 무리수","key":"AP=√5, AQ=√10","sol":["$\\overline{AP}=\\overline{AB}=\\sqrt{5}$, $\\overline{AQ}=\\overline{AC}=\\sqrt{10}$","$A=-\\sqrt{10}-\\sqrt{5}$","$Q=A+\\sqrt{10}=-\\sqrt{5}$"],"check":"ok"},
"8":{"tp":"실수의 대소","key":"어림값 비교","sol":["$5\\sqrt{3}+1\\approx9.66$, $4\\sqrt{3}+3\\approx9.93$, $-4\\sqrt{5}+6\\approx-2.94$, $6\\sqrt{2}-2\\approx6.49$","작은 순서: $-4\\sqrt{5}+6$, $6\\sqrt{2}-2$, $8$, $5\\sqrt{3}+1$, $4\\sqrt{3}+3$","네 번째는 $5\\sqrt{3}+1$"],"check":"ok"},
"9":{"tp":"소수 부분의 표현","key":"√51 = √3·√17 = (1+a)(4+b)","sol":["$\\sqrt{3}=1+a$, $\\sqrt{17}=4+b$","$\\sqrt{51}=(1+a)(4+b)=ab+4a+b+4$","$7\\lt\\sqrt{51}\\lt8$이므로 소수 부분 $=ab+4a+b-3$"],"check":"ok"},
"10":{"tp":"근호 안이 제곱수","key":"320−4x = 7k², k는 짝수","sol":["$4x=320-7k^2\\gt0$, $7k^2\\equiv0\\pmod 4$이므로 $k$는 짝수","$k=0,2,4,6$일 때 $x=80,73,52,17$","$a$의 값의 합 $=0+2+4+6=12$"],"check":"a=0(x=80)도 정수이므로 포함해야 정답 12"},
"11":{"tp":"전개식의 x의 계수","key":"곱셈 공식","sol":["① $-6$ ② $-2$ ③ $1$ ④ $0$ ⑤ $7$","가장 작은 것은 ①"],"check":"ok"},
"12":{"tp":"곱셈 공식과 넓이","key":"색칠 = 네 직각삼각형 + 가운데 정사각형","sol":["네 직각삼각형: $4\\times\\dfrac{1}{2}\\times2a\\times b=4ab$","가운데 정사각형: $(2a-b)^2=4a^2-4ab+b^2$","합 $=4a^2+b^2$"],"check":"그림 재작성(가운데 정사각형의 한 변 2a−b로 그림)"},
"13":{"tp":"곱셈 공식의 변형","key":"(x+y)²−(x−y)²=4xy","sol":["$4xy=12$, $xy=3$","$9xy-6x+6y-4=-1 \\Rightarrow 27+6(y-x)-4=-1$, $y-x=-4$","$\\dfrac{1}{x}-\\dfrac{1}{y}=\\dfrac{y-x}{xy}=-\\dfrac{4}{3}$"],"check":"ok"},
"14":{"tp":"넓이와 곱셈 공식","key":"(a+3)(b+3)=ab+3(a+b)+9","sol":["$36+3(a+b)+9=84$, $a+b=13$","둘레 $=2(a+b)=26\\,\\text{cm}$"],"check":"ok"},
"15":{"tp":"완전제곱식이 될 조건","key":"a² = 4·7·4b = 112b","sol":["$a^2=112b$이므로 $b=7k^2$, $a=\\pm28k$","정답 35는 가장 작은 자연수 $b=7$일 때 $a=-28$로 본 것","$b-a=7-(-28)=35$"],"check":"문장대로면 b가 커질수록 a가 한없이 작아져 답이 정해지지 않음. 학교 답 ⑤는 b를 가장 작은 자연수 7로 본 해석 — 사람 확인 권장"},
"16":{"tp":"인수분해가 되는 조건","key":"(x+t)(x−3−t) ⇒ n=t(t+3)","sol":["$p+q=-3$, $pq=-n$에서 $n=t(t+3)$ ($t$는 정수)","가능한 값: $-2,0,4,10,18,28,40$","$7$개"],"check":"ok"},
"17":{"tp":"합차 공식의 활용","key":"e²−c² = (e−c)(e+c)","sol":["$e=c+2$이므로 $2(2c+2)=60$, $c=14$","$a=12$, $d=15$","$a^2-d^2=144-225=-81$"],"check":"ok"},
"18":{"tp":"인수와 대입","key":"x−k가 인수 ⇒ x=k 대입하면 0","sol":["$16-32+a=0$, $a=16$","$20+2b+4=0$, $b=-12$","$a+b=4$"],"check":"ok"},
"19":{"tp":"인수분해 공식으로 수 계산","key":"(x+5)(x+3)+1=(x+4)²","sol":["$x=100$이라 하면 $x^2+8x+16=(x+4)^2$","$a=104$"],"check":"ok"},
"20":{"tp":"인수분해 계수 조건","key":"ac=3, bd=6, A=ad−bc","sol":["$(a,c)=(1,3)$: $c,d$ 서로소이므로 $d=1,2$ → $A=1-18=-17$, $2-9=-7$","$(a,c)=(3,1)$: $a,b$ 서로소이므로 $b=1,2$ → $A=18-1=17$, $9-2=7$","$4$개"],"check":"원본 ⑤ 선택지에 붙은 군더더기 문구 삭제"},
"21":{"tp":"사각뿔의 부피와 유리화","key":"V = ⅓ × 밑넓이 × h","sol":["(1) $\\sqrt{3}(3\\sqrt{2}+\\sqrt{3})=3\\sqrt{6}+3$","(2) $\\dfrac{1}{3}(3\\sqrt{6}+3)h=5\\sqrt{6}$, $(\\sqrt{6}+1)h=5\\sqrt{6}$","$h=\\dfrac{5\\sqrt{6}(\\sqrt{6}-1)}{5}=6-\\sqrt{6}$"],"check":"원본 정답 '풀이참조' → 직접 풀이"},
"22":{"tp":"유리화와 소거","key":"1/(√k+√(k+1)) = √(k+1)−√k","sol":["(1) $(\\sqrt{2}-1)+(\\sqrt{3}-\\sqrt{2})+\\cdots+(\\sqrt{60}-\\sqrt{59})=\\sqrt{60}-1=2\\sqrt{15}-1$","(2) $7\\lt\\sqrt{60}\\lt8$이므로 정수 부분 $6$, 소수 부분 $2\\sqrt{15}-7$","(3) $x^2+6x-7=(x+7)(x-1)=2\\sqrt{15}(2\\sqrt{15}-8)=60-16\\sqrt{15}$"],"check":"원본 정답 '해설참조' → 직접 풀이"},
"23":{"tp":"닮음비와 무리수","key":"넓이의 비 3:5 ⇒ 닮음비 √3:√5","sol":["가로 $=17-a$, $\\overline{GD}=a$, $\\overline{AG}=17-2a$","(1) $\\overline{BE}=17-2a$, $\\overline{BF}=a-(17-2a)=3a-17$","(2) $\\sqrt{3}:\\sqrt{5}$","(3) $\\sqrt{5}(17-2a)=\\sqrt{3}a$, $a=\\dfrac{17\\sqrt{5}}{2\\sqrt{5}+\\sqrt{3}}=10-\\sqrt{15}$","(4) $2\\{(3a-17)+(17-2a)\\}=2a=20-2\\sqrt{15}$"],"check":"원본 정답 '해설참조' → 직접 풀이"}
}
