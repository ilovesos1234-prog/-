{
"1":{"tp":"두 직선의 평행","key":"기울기가 같고 $y$절편이 다르다","sol":["$m=2$ ($y$절편 $3\\neq5$)"],"check":"ok"},
"2":{"tp":"집합의 뜻","key":"대상이 분명하게 정해지는가","sol":["ㄱ: 원소가 없는 집합 $\\varnothing$ (집합)","ㄴ: $\\{1,2,3,6\\}$ (집합)","ㄷ, ㄹ, ㅁ: 기준이 불분명하여 집합이 아니다"],"check":"ok"},
"3":{"tp":"두 점 사이의 거리","key":"$\\sqrt{\\Delta x^2+\\Delta y^2}$","sol":["$\\sqrt{4^2+(-3)^2}=5$"],"check":"ok"},
"4":{"tp":"무게중심","key":"좌표의 평균","sol":["$a=\\dfrac{1-2+4}{3}=1$, $b=\\dfrac{2-5+0}{3}=-1$","$a+b=0$"],"check":"ok"},
"5":{"tp":"포함 관계와 연산","key":"$A\\subset B$이면 $A\\cap B=A$, $A\\cup B=B$","sol":["ㄱ: $B^C\\subset A^C$이므로 거짓","ㄴ: $A-B=\\varnothing$ 참","ㄷ: $A\\cap B=A\\neq B$ 거짓","ㄹ: $A\\cup B=B$ 참"],"check":"ok"},
"6":{"tp":"평행이동한 직선의 수직 조건","key":"$y$절편이 아니라 $x$축 위의 교점 $(-1,0)$을 지난다","sol":["이동 후: $y+2=a(x-1)+b$ → $y=ax-a+b-2$","$x-3y+1=0$의 기울기 $\\dfrac13$ → 수직이므로 $a=-3$","$x$축에서 만나므로 점 $(-1,0)$을 지난다: $0=-2a+b-2=6+b-2$ → $b=-4$","$ab=12$"],"check":"ok"},
"7":{"tp":"대칭이동과 최단 거리","key":"A를 $y=x$에 대칭이동","sol":["A, B는 $y=x$의 같은 쪽에 있다","A$'(2,5)$이고 $\\overline{AP}+\\overline{BP}\\ge\\overline{A'B}$","$\\overline{A'B}=\\sqrt{1^2+6^2}=\\sqrt{37}$"],"check":"ok"},
"8":{"tp":"원과 직선이 만날 조건","key":"$d\\le r$","sol":["중심 $(-1,0)$, $r=2\\sqrt2$","$\\dfrac{|-1+k|}{\\sqrt2}\\le2\\sqrt2$ → $|k-1|\\le4$","$-3\\le k\\le5$ → 합 $2$"],"check":"ok"},
"9":{"tp":"부분집합의 개수 (B⊂X⊂A)","key":"$2^{n(A)-n(B)}$","sol":["$B\\cap X=B$ → $B\\subset X$, $A\\cup X=A$ → $X\\subset A$","$2^{6-3}=8$"],"check":"ok"},
"10":{"tp":"원소의 개수","key":"$n(A\\cup B)=n(A)+n(B)-n(A\\cap B)$","sol":["$n(A\\cup B)=20-2=18$","$n(A\\cap B)=13+11-18=6$","탁구만 $=11-6=5$"],"check":"ok"},
"11":{"tp":"원의 현과 수직인 대각선","key":"RS는 중심을 지나는 지름, PQ는 원점이 중점인 현","sol":["직선 $y=2x$는 중심 $(1,2)$를 지나므로 RS는 지름이다","원점에서 중심까지 거리 $\\sqrt5$. R$=-u$, S$=3u$ (방향 $(1,2)$ 기준 거리)라 하면 $\\sqrt5-r=-u$, $\\sqrt5+r=3u$","$u=\\sqrt5$, $r=2\\sqrt5$, $\\overline{RS}=4\\sqrt5$","PQ의 중점이 원점 → PQ $\\perp$ (원점과 중심을 잇는 선) → $\\overline{PQ}=2\\sqrt{20-5}=2\\sqrt{15}$","두 대각선이 수직: 넓이 $=\\dfrac12\\times2\\sqrt{15}\\times4\\sqrt5=20\\sqrt3$"],"check":"ok"},
"12":{"tp":"대칭차집합과 원소 결정","key":"$3\\in B$이고 $3\\notin\\{-1,5\\}$이므로 $3\\in A$","sol":["$-a+4=3$이면 $a=1$: $A=\\{5,3,1\\}$, $B=\\{3,1,-1\\}$ → 조건 만족","$2a-1=3$이면 $a=2$: $A=\\{5,2,3\\}$, $B=\\{3,4,0\\}$ → 불만족","$A=\\{1,3,5\\}$, 합 $9$"],"check":"ok"},
"13":{"tp":"넓이 이등분 + 수직 → 이등변삼각형","key":"$l$은 A를 지나고 BC의 수직이등분선","sol":["$m(x-3)+(y+2)=0$이므로 $l$은 A$(3,-2)$를 지난다","넓이 이등분 → BC의 중점을 지나고, BC와 수직 → $\\overline{AB}=\\overline{AC}$","$13=(a-3)^2+(a+2)^2$ → $2a^2-2a=0$ → $a=1$","BC 기울기 $=\\dfrac{1-0}{1-6}=-\\dfrac15$ → $l$ 기울기 $-m=5$, $m=-5$","$a+m=-4$"],"check":"ok"},
"14":{"tp":"접은 원의 중심과 현의 길이","key":"접힌 호의 중심은 O를 PQ에 대칭이동한 점","sol":["접힌 호의 중심 O$'$은 반지름 $r$, $x$축에 $(-2,0)$에서 접하므로 O$'(-2,r)$","PQ는 OO$'$의 수직이등분선: OO$'$ 기울기 $-\\dfrac r2$, PQ 기울기 $\\dfrac2r=\\dfrac13$ → $r=6$","O에서 PQ까지 거리 $=\\dfrac{\\overline{OO'}}{2}=\\dfrac{\\sqrt{40}}{2}=\\sqrt{10}$","$\\overline{PQ}=2\\sqrt{36-10}=2\\sqrt{26}$"],"check":"ok"},
"15":{"tp":"각의 이등분선","key":"두 직선에 이르는 거리가 같다","sol":["$|x-3y+1|=|3x-y+a|$ (분모 $\\sqrt{10}$ 동일)","$+$: $2x+2y+a-1=0$ → $b=a-1$","$-$: $4x-4y+1+a=0$ → $c=4$, $1+a=-3$ → $a=-4$, $b=-5$","$a+b+c=-5$"],"check":"ok"},
"16":{"tp":"외접원의 반지름","key":"O, $(-2,0)$을 지나므로 중심 $(-1,k)$","sol":["꼭짓점: O$(0,0)$, $(-2,0)$, $(t,3t)$ ($t=\\dfrac{2}{3m-1}$)","중심 $(-1,k)$, $1+k^2=5$ → $k=\\pm2$","$(t+1)^2+(3t-k)^2=5$ → $10t^2+(2-6k)t=0$","$k=2$: $t=1$ → $3m-1=2$, $m=1$ ($k=-2$이면 $m\\lt0$)"],"check":"ok"},
"17":{"tp":"내분점","key":"$\\dfrac{mx_2+nx_1}{m+n}$","sol":["$3:1$: $\\left(\\dfrac{6-2}{4},\\dfrac{9+1}{4}\\right)=\\left(1,\\dfrac52\\right)$","$1:3$: $\\left(\\dfrac{2-6}{4},\\dfrac{3+3}{4}\\right)=\\left(-1,\\dfrac32\\right)$"],"check":"ok"},
"18":{"tp":"원 위의 점에서의 접선","key":"접선 $ax+by=5$","sol":["접선 기울기 $-\\dfrac ab$, 주어진 직선 기울기 $\\dfrac12$ → $-\\dfrac ab=-2$, $a=2b$","$a^2+b^2=5$ → $5b^2=5$, $b=1$, $a=2$","$a+b=3$"],"check":"ok"},
"19":{"tp":"두 직선에 접하는 원","key":"중심에서 두 직선까지 거리가 같다","sol":["$\\dfrac{|2k-1|}{\\sqrt5}=\\dfrac{|-k+5|}{\\sqrt5}$","$2k-1=5-k$ → $k=2$","$2k-1=k-5$ → $k=-4$"],"check":"ok"},
"20":{"tp":"점의 평행이동","key":"$(x,y)\\to(x-1,y+2)$","sol":["$(a-1,\\,1)=(2,\\,b)$","$a=3$, $b=1$"],"check":"ok"},
"21":{"tp":"포함 관계와 이차부등식","key":"$A-B=\\varnothing\\iff A\\subset B$","sol":["$A=\\{x\\mid2\\le x\\le4\\}$","$B=\\{x\\mid(x-1)(x-a)\\lt0\\}=\\{x\\mid1\\lt x\\lt a\\}$ ($a\\gt1$)","$A\\subset B$ → $a\\gt4$"],"check":"ok"},
"22":{"tp":"원소의 합 조건으로 집합 결정","key":"$\\{2,6,8\\}$을 $A-B$, $B-A$로 나눈다","sol":["$A^C\\cap B^C=U-(A\\cup B)=\\{1,4,7\\}$","$S(A-B)=S(B-A)$, $n(A-B)=n(B-A)+1$이고 두 집합의 합집합은 $\\{2,6,8\\}$ (합 $16$)","합이 각각 $8$: $\\{2,6\\}$과 $\\{8\\}$ → $A-B=\\{2,6\\}$, $B-A=\\{8\\}$","$A=\\{2,3,5,6\\}$, $B=\\{3,5,8\\}$"],"check":"ok"},
"23":{"tp":"두 원 위의 점 사이 거리","key":"중심거리 $\\pm$ 두 반지름","sol":["$C_1$: $(x+1)^2+(y-2)^2=1$, 중심 $(-1,2)$","$C_2$: 중심 $(2,2)\\to(2,-2)$, 반지름 $1$","중심거리 $=\\sqrt{9+16}=5$","최댓값 $5+2=7$, 최솟값 $5-2=3$"],"check":"ok"}
}
