{
"1":{"tp":"이차함수 찾기","key":"y=(x에 관한 이차식) 꼴","sol":["② $y=\\dfrac{x(x-3)}{2}=\\dfrac{1}{2}x^2-\\dfrac{3}{2}x$ (이차함수)","① $y=2\\pi x$, ③ $y=4x$, ④ $y=\\sqrt{2}x$, ⑤ $y=2(3x+2)=6x+4$ (모두 일차함수)"],"check":"ok"},
"2":{"tp":"이차방정식이 될 조건","key":"x²의 계수 ≠ 0","sol":["$(a^2+3a-4)x^2+(a-2)x-1=0$","$a^2+3a-4\\ne0$, $(a+4)(a-1)\\ne0$","$a\\ne1$, $a\\ne-4$이므로 될 수 없는 것은 $1$"],"check":"ok"},
"3":{"tp":"이차방정식의 해","key":"해를 대입","sol":["$3-5+3a=0$","$a=\\dfrac{2}{3}$"],"check":"원본에 방정식과 [ ] 안의 수가 빠져 있어 정답 2/3에 맞게 문제를 재구성함 — 사람 확인 필요"},
"4":{"tp":"이차방정식의 활용","key":"높이 = 31을 풀고 떨어지는 시각 선택","sol":["$-3t^2+21t+1=31$, $t^2-7t+10=0$","$(t-2)(t-5)=0$, $t=2$ 또는 $t=5$","떨어지다가 지나는 때는 $5$초 후"],"check":"ok"},
"5":{"tp":"켤레근","key":"유리계수 ⇒ 다른 근 6+2√3","sol":["두 근 $6\\pm2\\sqrt{3}$","$k=(6-2\\sqrt{3})(6+2\\sqrt{3})=36-12=24$"],"check":"ok"},
"6":{"tp":"이차함수 그래프의 성질","key":"y=−½(x−3)²−½","sol":["$y=-\\dfrac{1}{2}(x-3)^2-\\dfrac{1}{2}$: 축 $x=3$, 꼭짓점 $(3,-\\tfrac{1}{2})$, 위로 볼록","ㄴ: $y$절편 $-5$, 항상 $y\\lt0$이므로 제3·4사분면만 지남 (옳음)","ㄹ: $x\\gt3$이면 감소 (틀림)","ㅁ: $-\\dfrac{1}{2}(x-3)^2+\\dfrac{1}{2}-1$ (옳음) ⇒ ㄱ, ㄴ, ㄷ, ㅁ"],"check":"ok"},
"7":{"tp":"표준형으로 변형","key":"완전제곱식 만들기","sol":["$y=\\dfrac{1}{2}(x^2-2x)+\\dfrac{5}{2}=\\dfrac{1}{2}(x-1)^2+2$","$a=\\dfrac{1}{2}$, $p=1$, $q=2$, $apq=1$"],"check":"원본에 이차함수의 식이 빠져 있어 정답 1에 맞게 식을 재구성함 — 사람 확인 필요"},
"8":{"tp":"그래프와 계수의 부호","key":"볼록 방향·축의 위치·y절편","sol":["아래로 볼록 ⇒ $a\\gt0$","축이 $y$축 오른쪽 ⇒ $a$, $b$ 다른 부호 ⇒ $b\\lt0$","$y$절편이 음수 ⇒ $c\\lt0$"],"check":"그림 재작성(꼭짓점이 제4사분면, y절편 음수)"},
"9":{"tp":"그래프의 폭","key":"|a|가 클수록 폭이 좁다","sol":["$\\dfrac{1}{2}\\lt|a|\\lt\\dfrac{25}{3}$","음의 정수 $a=-1,-2,\\ldots,-8$","합 $=-36$"],"check":"ok"},
"10":{"tp":"x절편 사이의 거리","key":"AB = 2√(2k)","sol":["$\\dfrac{1}{2}x^2=k$, $x=\\pm\\sqrt{2k}$, $\\overline{AB}=2\\sqrt{2k}=\\sqrt{8k}$","$8k$가 제곱수: $k=2$ ($\\overline{AB}=4$), $k=8$ ($\\overline{AB}=8$)","합 $=10$"],"check":"ok"},
"11":{"tp":"축과 꼭짓점","key":"축 x=k/2=1/2","sol":["축 $x=\\dfrac{2k}{4}=\\dfrac{k}{2}=\\dfrac{1}{2}$이므로 $k=1$","$y=-2x^2+2x+1$, $x=\\dfrac{1}{2}$일 때 $y=\\dfrac{3}{2}$","$p+q=\\dfrac{1}{2}+\\dfrac{3}{2}=2$"],"check":"ok"},
"12":{"tp":"평행이동한 포물선과 넓이","key":"g는 f를 (a, a²)만큼 평행이동 ⇒ 넓이는 평행사변형으로 바뀐다","sol":["$g(x)=(x-a)^2+a^2$: $f$를 $x$축으로 $a$, $y$축으로 $a^2$만큼 평행이동","두 그래프는 $x=a$에서 만난다","색칠한 부분을 옮겨 붙이면 밑변 $a^2$, 높이 $a$인 평행사변형과 넓이가 같다 ⇒ $S(a)=a^3$","$S(11)=1331$"],"check":"ok"},
"13":{"tp":"근을 대입한 식의 값","key":"α²=−6α−1로 차수 낮추기","sol":["$\\alpha^2=-6\\alpha-1$, $\\alpha^3=-6\\alpha^2-\\alpha=35\\alpha+6$","$\\alpha^3+7\\alpha^2+7\\alpha+9=(35\\alpha+6)+7(-6\\alpha-1)+7\\alpha+9=8$"],"check":"두 근이 모두 음수지만 값은 어느 근이든 8"},
"14":{"tp":"모든 사분면을 지날 조건","key":"x절편 두 개의 부호가 다르다","sol":["모든 사분면을 지나려면 $x$축과 원점의 양쪽에서 만나야 한다","두 근의 곱 $\\dfrac{c}{a}\\lt0$ ⇒ $ac\\lt0$"],"check":"ok"},
"15":{"tp":"포물선과 사각형의 넓이","key":"꼭짓점·절편 구하고 나누어 계산","sol":["$y=-(x+2)^2+16$: B$(-2,16)$, A$(0,12)$","$x^2+4x-12=0$, $x=-6,2$ ⇒ C$(-6,0)$","$\\square OABC=\\triangle OBC+\\triangle OAB=\\dfrac{1}{2}\\times6\\times16+\\dfrac{1}{2}\\times12\\times2=48+12=60$"],"check":"원본 ⑤ 뒤의 군더더기 문구 삭제"},
"16":{"tp":"직선 위의 점과 넓이","key":"P(t, −5/2 t+20), t(−5/2 t+20)=40","sol":["$t\\left(-\\dfrac{5}{2}t+20\\right)=40$","$t^2-8t+16=0$, $t=4$","$P(4,\\,10)$"],"check":"ok"},
"17":{"tp":"평행사변형의 넓이와 이차방정식","key":"AD=x로 놓고 △ABC−△ADE−△DBF","sol":["$\\overline{AD}=x$라 하면 $\\overline{DB}=20-x$","$\\square DFCE=200-\\dfrac{1}{2}x^2-\\dfrac{1}{2}(20-x)^2=36$","$x^2-20x+36=0$, $x=18$ 또는 $2$, $\\overline{AD}\\gt\\overline{DB}$이므로 $x=18$","$\\overline{FC}=\\overline{DE}=18\\sqrt{2}\\,\\text{cm}$"],"check":"원본 그림이 완전히 깨져 있어 정답에 맞게 AB=20 cm를 넣어 다시 그림 — 사람 확인 필요"},
"18":{"tp":"축의 방정식과 대칭","key":"f(−1)=f(7) ⇒ 축 x=3","sol":["축의 방정식은 $x=\\dfrac{-1+7}{2}=3$","한 근이 $1$이므로 다른 근은 $2\\times3-1=5$","$x=1$ 또는 $x=5$"],"check":"원본 정답이 'x=1 또는'에서 잘림 → 직접 풀이"}
