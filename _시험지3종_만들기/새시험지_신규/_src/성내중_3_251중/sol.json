{
"1":{"tp":"제곱근의 뜻","key":"양수의 제곱근은 2개, 음수의 제곱근은 없다","sol":["① $4$는 $16$의 양의 제곱근","② $\\sqrt{(-3)^2}=3$의 제곱근은 $\\pm\\sqrt{3}$","③ 자연수는 양수이므로 제곱근이 2개 (옳다)","④ 음수 $-121$의 제곱근은 없다","⑤ $a=\\dfrac{1}{4}$이면 $\\sqrt{a}=\\dfrac{1}{2}\\gt a$"],"check":"ok"},
"2":{"tp":"제곱근의 성질","key":"$\\sqrt{a^2}=|a|$","sol":["① $2\\times 7=14$ ② $4-2=2$","③ $0.4\\div 4=0.1$ (옳다)","④ $-8\\div\\dfrac{4}{9}=-18$ ⑤ $-3\\times(-2)=6$"],"check":"ok"},
"3":{"tp":"피타고라스 정리","key":"공통 빗변(대각선)의 길이를 두 번 이용","sol":["위 삼각형: 대각선 $=\\sqrt{13^2-5^2}=12$","아래 삼각형: $x^2+8^2=12^2$","$x^2=80$, $x=4\\sqrt{5}$"],"check":"그림 원본 손상 → 라벨(13, 5, x, 8)과 정답으로 재구성한 그림"},
"4":{"tp":"√(A²) 꼴 간단히 하기","key":"근호 안 식의 부호 판단","sol":["$a\\lt 0$이므로 $3a-1\\lt 0$, $-4a+1\\gt 0$","$(1-3a)-(-4a+1)=a$"],"check":"ok"},
"5":{"tp":"유리수와 무리수","key":"각 수를 유리수/무리수로 분류","sol":["$\\dfrac{\\sqrt{3}}{\\sqrt{7}}$, $\\pi-1$: 무리수 / $-\\dfrac{1}{2}$, $6$, $0$: 유리수","① 다섯 수 모두 실수 ✗ ② 그런 수 없음 ✗","③ $\\sqrt{\\dfrac{3}{7}}\\lt 1\\lt\\pi-1$ ✗","④ 유리수 중 최대 $6$ ✓ ⑤ 무리수 두 개 ✓"],"check":"ok"},
"6":{"tp":"근호가 자연수가 될 조건","key":"$\\dfrac{8x}{3}=\\dfrac{2^3x}{3}$이 제곱수","sol":["$x=6k^2$ 꼴이어야 한다","$k=1,2,\\dots$: $6, 24, 54,\\dots$","가장 작은 두 자리 수 $24$"],"check":"ok"},
"7":{"tp":"제곱근표 읽기","key":"$\\sqrt{442}=10\\sqrt{4.42}$","sol":["표에서 $\\sqrt{4.42}=2.102$","$\\sqrt{442}=21.02$"],"check":"원본 제곱근표가 잘려 있어 실제 값으로 행을 복원함"},
"8":{"tp":"제곱근표 거꾸로 읽기","key":"표에서 $x$, $y$를 찾는다","sol":["$\\sqrt{x}=2.074\\Rightarrow x=4.30$, $\\sqrt{y}=6.481\\Rightarrow y=42.0$","$x+y=46.3$, $\\sqrt{46.3}=6.804$"],"check":"원본 제곱근표가 잘려 있어 실제 값으로 행을 복원함"},
"9":{"tp":"실수의 대소 비교","key":"제곱하거나 근삿값으로 비교","sol":["$\\sqrt{5}\\approx 2.24$, $-\\sqrt{7.2}\\approx -2.68$, $\\dfrac{\\sqrt{3}+1}{2}\\approx 1.37$, $1-\\sqrt{3}\\approx -0.73$","$a=\\sqrt{5}$, $b=-\\dfrac{6}{\\sqrt{5}}$","$a^2b=5\\times\\left(-\\dfrac{6}{\\sqrt{5}}\\right)=-6\\sqrt{5}$"],"check":"ok"},
"10":{"tp":"수직선 위의 무리수","key":"$\\overline{BD}=\\sqrt{1^2+2^2}$","sol":["C$=1$이므로 B$=-1$","$\\overline{BD}=\\sqrt{5}$, P는 B의 왼쪽","P$=-1-\\sqrt{5}$"],"check":"그림 원본 손상 → 남은 라벨 위치와 정답으로 모눈 좌표를 복원해 다시 그림"},
"11":{"tp":"수직선 위의 무리수","key":"각 점의 좌표를 구해 거리 계산","sol":["E$=-2$, P$=-1-\\sqrt{5}$: $\\overline{PE}=\\sqrt{5}-1$","$\\overline{BA}=\\sqrt{2^2+1^2}=\\sqrt{5}$, Q$=-1+\\sqrt{5}$","$\\overline{CQ}=\\sqrt{5}-2$","합 $2\\sqrt{5}-3$"],"check":"그림 원본 손상 → 10번과 같은 복원 그림 사용"},
"12":{"tp":"근호가 유리수가 될 조건","key":"$6n-5$가 $16$과 $100$ 사이의 제곱수","sol":["$16\\lt 6n-5\\lt 100$","제곱수 $25, 36, 49, 64, 81$ 중 $6n-5$ 꼴($6$으로 나눈 나머지 $1$): $25, 49$","$n=5, 9$ → $2$개"],"check":"ok"},
"13":{"tp":"근호의 혼합 계산","key":"분모의 유리화 후 동류항 정리","sol":["$\\dfrac{6}{\\sqrt{3}}=2\\sqrt{3}$, $3\\sqrt{12}=6\\sqrt{3}$","$2\\sqrt{3}+2\\sqrt{3}-\\sqrt{6}-6\\sqrt{3}=-2\\sqrt{3}-\\sqrt{6}$","$a=-2$, $b=-1$, $b-a=1$"],"check":"ok"},
"14":{"tp":"곱셈 공식","key":"각각 전개해 계수 비교","sol":["① $-5+0$ ② $-6+1$ ③ $-x^2+7x-12$: $7-12$ ⑤ $-7+2$ → 모두 $-5$","④ $-4x^2+9x-2$: $9-2=7$"],"check":"ok"},
"15":{"tp":"곱셈 공식과 무리수 상등","key":"합차 공식 $(3\\sqrt{3}+4\\sqrt{2})(3\\sqrt{3}-4\\sqrt{2})$","sol":["$(2\\sqrt{3}+1)^2=13+4\\sqrt{3}$","$(4\\sqrt{2}+3\\sqrt{3})(3\\sqrt{3}-4\\sqrt{2})=27-32=-5$","합 $8+4\\sqrt{3}$, $a=8$, $b=4$, $a+b=12$"],"check":"ok"},
"16":{"tp":"곱셈 공식을 이용한 수의 계산","key":"$a^2-b^2=(a+b)(a-b)$","sol":["$(76+24)(76-24)=100\\times 52=5200$"],"check":"ok"},
"17":{"tp":"분모의 유리화","key":"켤레식 곱하기","sol":["$\\dfrac{1}{\\sqrt{5}-\\sqrt{3}}=\\dfrac{\\sqrt{5}+\\sqrt{3}}{2}$, $\\dfrac{1}{\\sqrt{3}-1}=\\dfrac{\\sqrt{3}+1}{2}$","차: $\\dfrac{\\sqrt{5}-1}{2}$"],"check":"ok"},
"18":{"tp":"연속하는 두 홀수","key":"$2n-1$, $2n+1$","sol":["$(2n+1)^2-(2n-1)^2=8n$","㉠ $2n-1$, ㉡ $(2n-1)^2$, ㉢ $8n$"],"check":"ok"},
"19":{"tp":"완전제곱식","key":"$(2x+by)^2=4x^2+4bxy+b^2y^2$","sol":["$b^2=49$, $-a=4b$, $a\\gt 0$이므로 $b=-7$, $a=28$","$a+b=21$"],"check":"ok"},
"20":{"tp":"인수분해","key":"$x^2-4x+3=(x-1)(x-3)$, $2x^2-5x-3=(x-3)(2x+1)$","sol":["$a+b=-4$","$(cx-3)(dx+1)=(x-3)(2x+1)$: $c=1$, $d=2$","$a+b+c+d=-1$"],"check":"ok"},
"21":{"tp":"인수 찾기","key":"$4ax^2-8axy+4ay^2=4a(x-y)^2$","sol":["$a$, $x-y$, $(x-y)^2$은 인수","$4(x+y)$, $a^2(x-y)$는 인수가 아니다"],"check":"ok"},
"22":{"tp":"곱셈 공식의 변형","key":"$x^3y+xy^3=xy\\{(x+y)^2-2xy\\}$","sol":["$x=\\dfrac{\\sqrt{3}-1}{2}$, $y=\\dfrac{\\sqrt{3}+1}{2}$","$x+y=\\sqrt{3}$, $xy=\\dfrac{1}{2}$","$\\dfrac{1}{2}(3-1)=1$"],"check":"ok"},
"23":{"tp":"공통인수","key":"$5x^2-ax+b=(5x+1)(x+m)$, $10x^2+cx+1=(5x+1)(2x+1)$","sol":["$c=7$","$-a=5m+1$, $b=m$","$a+5b+c=-5m-1+5m+7=6$"],"check":"ok"},
"24":{"tp":"계수 비교","key":"전개 후 항별 비교","sol":["좌변 $=-abx^2+(a-2b)x+5$","$ab=6$, $c=a-2b$가 자연수","$(a,b)=(6,1)$일 때만 $c=4\\gt 0$","$a=6$, $b=1$, $c=4$"],"check":"ok"},
"25":{"tp":"인수분해의 도형 활용","key":"넓이를 완전제곱식으로","sol":["(1) $(4x+1)(x+3)=4x^2+13x+3$","(2) $4x^2+13x+3+(-x+6)=4x^2+12x+9$","(3) $(2x+3)^2$이고 $2x+3\\gt 0$이므로 한 변 $2x+3$"],"check":"ok"}
