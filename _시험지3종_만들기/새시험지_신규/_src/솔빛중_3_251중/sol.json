{
"1":{"tp":"제곱근의 뜻","key":"'제곱근 a'는 √a, 'a의 제곱근'은 ±√a","sol":["ㄱ. 제곱근 $\\dfrac{1}{25}$은 $\\sqrt{\\dfrac{1}{25}}=\\dfrac15$ (참)","ㄴ. $0.01$의 제곱근은 $\\pm0.1$ (참)","ㄷ. $\\sqrt{(-3)^2}=3$ 의 양의 제곱근은 $\\sqrt3$ (거짓)","ㄹ. $13$의 양의 제곱근은 $\\sqrt{13}$ (참) → ㄱ, ㄴ, ㄹ"],"check":"ok"},
"2":{"tp":"제곱근과 순환소수","key":"순환소수를 분수로 바꾼 뒤 제곱근","sol":["$a=\\sqrt9=3$","$2.\\dot7=\\dfrac{25}{9}$ 의 음의 제곱근 $b=-\\dfrac53$","$a-b=3+\\dfrac53=\\dfrac{14}{3}$"],"check":"ok"},
"3":{"tp":"제곱근의 성질 계산","key":"(√a)²=a, √(a²)=|a|","sol":["① $12+9=21$ ② $8-2=6$ ③ $4\\div16=\\dfrac14$ ④ $\\dfrac23\\times\\dfrac17=\\dfrac{2}{21}$","⑤ $6\\times3=18$ 이므로 $-18$은 옳지 않다"],"check":"ok"},
"4":{"tp":"√(a−b)² 꼴 간단히 하기","key":"근호 안 식의 부호 판단","sol":["$0\\lt a\\lt1$ 이면 $\\dfrac1a\\gt1\\gt a$ 이므로 $a-\\dfrac1a\\lt0$","(준식) $=\\left(\\dfrac1a-a\\right)-\\left(a+\\dfrac1a\\right)-2a=-4a$"],"check":"ok"},
"5":{"tp":"음수 제곱근의 대소","key":"근호 안의 수가 클수록 음수는 작다","sol":["$-\\sqrt6\\lt-\\sqrt2\\lt-1\\lt-\\sqrt{0.5}\\lt-\\sqrt{\\dfrac13}$","네 번째 수는 $-\\sqrt{0.5}$"],"check":"ok"},
"6":{"tp":"무리수 판별","key":"근호를 벗길 수 있는지 확인","sol":["$\\sqrt{25}=5$, $0.3\\dot4$ 는 유리수","$-\\sqrt8$, $\\sqrt{1.6}=\\sqrt{\\dfrac{16}{10}}$, $2+\\sqrt7$ 은 무리수 → $3$개"],"check":"ok"},
"7":{"tp":"실수의 분류","key":"근호가 있어도 유리수일 수 있다","sol":["④ $\\sqrt4=2$ 처럼 근호를 사용해도 유리수인 수가 있다"],"check":"ok"},
"8":{"tp":"무리수를 수직선 위에 나타내기","key":"대각선 길이 √2, 기준점에서 ±√2","sol":["한 변이 $1$인 정사각형의 대각선은 $\\sqrt2$","원의 중심(기준점)에서 오른쪽이면 $+\\sqrt2$, 왼쪽이면 $-\\sqrt2$","그림에서 $\\mathrm{A}=-1-\\sqrt2$, $\\mathrm{B}=-2+\\sqrt2$, $\\mathrm{C}=1-\\sqrt2$, $\\mathrm{D}=1+\\sqrt2$, $\\mathrm{E}=2-\\sqrt2$","바른 것은 ⑤"],"check":"원본 그림이 검게 손상되어 보이지 않음. 정답 ⑤와 보기가 맞도록 그림을 새로 구성했으므로 원본 시험지와 대조 필요."},
"9":{"tp":"제곱근을 포함한 부등식","key":"각 변을 제곱","sol":["$1\\lt|n-3|\\lt4$ 이므로 $|n-3|=2,\\,3$","$n=5,1,6,0$","합 $=12$"],"check":"ok"},
"10":{"tp":"√(Ax)가 자연수가 될 조건","key":"소인수의 지수가 모두 짝수","sol":["$160x=2^5\\times5\\times x$ 이므로 $x=10k^2$","$100\\le10k^2\\le300$ → $10\\le k^2\\le30$, $k=4,5$","$x=160,\\,250$ 의 $2$개"],"check":"ok"},
"11":{"tp":"근호 안으로 넣기·꺼내기","key":"a√b=√(a²b)","sol":["$6\\sqrt{\\dfrac23}=\\sqrt{36\\times\\dfrac23}=\\sqrt{24}$, $a=24$","$\\sqrt{720}=12\\sqrt5$, $b=12$","$\\dfrac ab=2$"],"check":"ok"},
"12":{"tp":"제곱근의 곱셈과 나눗셈","key":"하나의 근호로 모아 약분","sol":["(준식) $=\\sqrt{\\dfrac{7}{2a}\\times\\dfrac{2b}{15}\\times\\dfrac a7\\times\\dfrac{10}{3b}}=\\sqrt{\\dfrac{2}{9}}$","$=\\dfrac{\\sqrt2}{3}$"],"check":"원본 전사본에는 첫 항이 √(7/2·a)처럼 보이나, 그렇게 읽으면 답이 √2a/3이 되어 보기에 없다. 정답 ①에 맞게 √(7/(2a))로 옮겼다."},
"13":{"tp":"분모의 유리화","key":"분모·분자에 같은 무리수를 곱함","sol":["$\\dfrac{5}{\\sqrt{10}}=\\dfrac{5\\sqrt{10}}{10}=\\dfrac12\\sqrt{10}$, $a=\\dfrac12$","$\\dfrac{\\sqrt3}{\\sqrt8}=\\dfrac{\\sqrt3}{2\\sqrt2}=\\dfrac{\\sqrt6}{4}$, $b=\\dfrac14$","$ab=\\dfrac18$"],"check":"ok"},
"14":{"tp":"직육면체의 옆넓이","key":"부피로 높이를 구한 뒤 (밑면 둘레)×(높이)","sol":["밑넓이 $=3\\sqrt3\\times5=15\\sqrt3$, 높이 $=\\dfrac{90}{15\\sqrt3}=2\\sqrt3$","옆넓이 $=2\\left(3\\sqrt3+5\\right)\\times2\\sqrt3=36+20\\sqrt3\\ (\\text{cm}^2)$"],"check":"ok"},
"15":{"tp":"실수의 대소 비교","key":"두 수의 차의 부호 또는 근삿값","sol":["⑤ $\\left(2\\sqrt5-\\sqrt2\\right)-\\left(\\sqrt2+\\sqrt5\\right)=\\sqrt5-2\\sqrt2=\\sqrt5-\\sqrt8\\lt0$","따라서 $\\sqrt2+\\sqrt5\\gt2\\sqrt5-\\sqrt2$ 이므로 ⑤가 옳지 않다"],"check":"ok"},
"16":{"tp":"유리수가 될 조건","key":"√2의 계수가 0","sol":["$\\dfrac{4}{\\sqrt2}=2\\sqrt2$, $\\sqrt{128}=8\\sqrt2$","$\\dfrac{a\\sqrt3}{2}\\left(\\sqrt6-\\sqrt{12}\\right)=\\dfrac{3a}{2}\\sqrt2-3a$","$2-8+\\dfrac{3a}{2}=0$ → $a=4$"],"check":"ok"},
"17":{"tp":"근호를 포함한 식의 계산","key":"분배법칙 후 유리수·무리수 부분 정리","sol":["$\\dfrac{2}{\\sqrt3}\\left(2+3\\sqrt3\\right)=\\dfrac{4\\sqrt3}{3}+6$","$\\left(2\\sqrt6+3\\sqrt2\\right)\\div\\sqrt2=2\\sqrt3+3$","차 $=3-\\dfrac23\\sqrt3$, $a+b=3-\\dfrac23=\\dfrac73$"],"check":"ok"},
"18":{"tp":"제곱근을 문자로 나타내기","key":"√2=a, √20=2√5=b","sol":["ㄱ. $\\sqrt{\\dfrac{1}{50}}=\\dfrac{\\sqrt2}{10}=0.1a$ (거짓)","ㄴ. $\\sqrt{1.8}=\\dfrac{\\sqrt{180}}{10}=\\dfrac{6\\sqrt5}{10}=0.3b$ (참)","ㄷ. $\\sqrt{50}=5\\sqrt2=5a$ (참)","ㄹ. $\\sqrt{8000}=40\\sqrt5=20b$ (거짓) → ㄴ, ㄷ"],"check":"ok"},
"19":{"tp":"정수 부분과 소수 부분","key":"2<√5<3","sol":["$a=(2+\\sqrt5)-4=\\sqrt5-2$, $b=(4-\\sqrt5)-1=3-\\sqrt5$","$|a-1|=|\\sqrt5-3|=3-\\sqrt5$, $|1-b|=|\\sqrt5-2|=\\sqrt5-2$","합 $=1$"],"check":"ok"},
"20":{"tp":"식의 값","key":"x−3=2√2 를 제곱","sol":["$x=\\dfrac{1}{3-2\\sqrt2}=3+2\\sqrt2$","$(x-3)^2=8$ → $x^2-6x=-1$","$2x^2-12x=-2$"],"check":"ok"},
"21":{"tp":"곱셈 공식","key":"(a−b)²=a²−2ab+b²","sol":["② $\\left(a-\\dfrac12\\right)^2=a^2-a+\\dfrac14$ 이므로 옳지 않다"],"check":"ok"},
"22":{"tp":"계수 비교","key":"전개 후 같은 차수의 계수 비교","sol":["$(x+6)(x-a)=x^2+(6-a)x-6a$ → $a=4$, $b=-24$","$(8x-3)(cx+2)=8cx^2+(16-3c)x-6$ → $c=3$, $d=7$","$a+d=11$"],"check":"ok"},
"23":{"tp":"전개식의 계수","key":"xy항만 골라 계산","sol":["$-(x+2y)^2$ 의 $xy$ 계수 $-4$","$(-3x+2y)^2$ 의 $xy$ 계수 $-12$","합 $-16$"],"check":"ok"},
"24":{"tp":"분모의 유리화와 연쇄 소거","key":"1/(√a+√b)=(√b−√a)/(b−a)","sol":["$\\dfrac{1}{\\sqrt{2k-1}+\\sqrt{2k+1}}=\\dfrac{\\sqrt{2k+1}-\\sqrt{2k-1}}{2}$","합 $=\\dfrac{\\sqrt9-1}{2}=1$","(준식) $=2024$"],"check":"ok"}
}
