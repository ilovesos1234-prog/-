{
"1":{"tp":"x축에 평행한 직선","key":"x축에 평행 ⇒ y=(상수)","sol":["$x$축에 평행한 직선은 $y=k$ 꼴","점 $(3,2)$를 지나므로 $y=2$"],"check":"ok"},
"2":{"tp":"y축에 수직인 직선","key":"y축에 수직 ⇒ 두 점의 y좌표가 같다","sol":["$-a=a+6$","$2a=-6$, $a=-3$"],"check":"ok"},
"3":{"tp":"교점을 지나는 직선의 방정식","key":"연립하여 교점을 구한 뒤 점-기울기","sol":["$x=3y$를 대입: $4y=4$, $y=1$, $x=3$","$y-1=\\dfrac{1}{2}(x-3)$","$y=\\dfrac{1}{2}x-\\dfrac{1}{2}$"],"check":"ok"},
"4":{"tp":"일차방정식의 그래프 성질","key":"y=2x+1로 정리","sol":["$x-y+2=-x+1 \\Rightarrow y=2x+1$","$y$절편 $1$, $x$절편 $-\\dfrac{1}{2}$ (② 옳음)","$x=7$이면 $y=15$, 기울기 $2\\ne-1$, 증가함수"],"check":"ok"},
"5":{"tp":"해가 무수히 많은 연립방정식","key":"두 식이 일치 ⇒ 계수비가 같다","sol":["$4x-3y-12=0$의 양변에 $2$를 곱하면 $8x-6y-24=0$","$a=8$, $b=6$이므로 $a-b=2$"],"check":"ok"},
"6":{"tp":"이등변삼각형이 되는 조건","key":"두 밑각이 같으면 이등변삼각형","sol":["$\\angle B=\\angle DCB=50^\\circ$이므로 $\\overline{DB}=\\overline{DC}$","$\\angle ACB=180^\\circ-50^\\circ-40^\\circ=90^\\circ$이므로 $\\angle ACD=40^\\circ=\\angle A$, $\\overline{DA}=\\overline{DC}$","$x=6-x$, $x=3$"],"check":"ok (그림 재작성: ∠A=40°, ∠B=∠DCB=50°)"},
"7":{"tp":"내각·외각의 이등분선이 만나는 각","key":"∠D = ½∠A","sol":["$\\angle ACE=\\angle A+\\angle B$이므로 $\\dfrac{1}{2}\\angle ACE=\\dfrac{1}{2}\\angle A+\\dfrac{1}{2}\\angle B$","$\\triangle DBC$에서 $\\angle DCE=\\angle DBC+\\angle x$","$\\angle x=\\dfrac{1}{2}\\angle A=18^\\circ$"],"check":"원본 ④ 선택지가 비어 있어 17°로 채움"},
"8":{"tp":"각의 이등분선과 거리","key":"각의 이등분선 위의 점에서 두 변까지의 거리는 같다","sol":["점 D에서 $\\overline{AB}$에 내린 수선의 길이 $=\\overline{DC}=3b$","$\\triangle ABD=\\dfrac{1}{2}\\times 2a\\times 3b=3ab$"],"check":"원본 문장에서 DC=3b가 빠져 있어 그림에 따라 보충"},
"9":{"tp":"삼각형의 성질 판단","key":"직각삼각형의 외심은 빗변의 중점","sol":["① 넓이가 같아도 합동은 아니다","② 직각삼각형의 외심은 빗변의 중점 (옳음)","③ RHA·RHS 조건 필요","④ 내심은 세 변까지의 거리가 같다 ⑤ 내접원의 중심이다"],"check":"ok"},
"10":{"tp":"직각삼각형의 외심","key":"OA=OB=OC, ∠OAB=60° ⇒ 정삼각형","sol":["$\\angle OAB=90^\\circ\\times\\dfrac{2}{3}=60^\\circ$","$\\overline{OA}=\\overline{OB}$이므로 $\\triangle OAB$는 정삼각형","둘레 $=3\\times4=12\\,\\text{cm}$"],"check":"ok"},
"11":{"tp":"이등변삼각형의 외심과 내심","key":"∠OBC=90°−∠A, ∠IBC=½∠B","sol":["$\\angle B=\\angle C=70^\\circ$이므로 $\\angle IBC=35^\\circ$","$\\angle BOC=2\\angle A=80^\\circ$이므로 $\\angle OBC=50^\\circ$","$\\angle OBI=50^\\circ-35^\\circ=15^\\circ$"],"check":"ok"},
"12":{"tp":"직각삼각형의 내접원","key":"넓이 = ½ r (둘레)","sol":["$3^2+4^2=5^2$이므로 직각삼각형, $a=6$","$6=\\dfrac{1}{2}r(3+4+5)$, $r=1$, $b=2$","$ab=12$"],"check":"ok"},
"13":{"tp":"평행사변형과 각의 이등분선","key":"엇각 ⇒ △ABE, △DFC는 이등변삼각형","sol":["$\\angle DAE=\\angle AEB$이므로 $\\overline{BE}=\\overline{AB}=6$","같은 방법으로 $\\overline{CF}=\\overline{CD}=6$","$\\overline{FE}=6+6-8=4\\,\\text{cm}$"],"check":"원본 ④ 선택지가 비어 있어 4.5 cm로 채움"},
"14":{"tp":"사각형 사이의 관계","key":"대각선이 수직이어도 평행사변형이 아니면 마름모가 아니다","sol":["② 두 대각선이 수직인 사각형은 마름모가 아닐 수 있다 (예: 연꼴)","나머지는 모두 옳다"],"check":"ok"},
"15":{"tp":"평행사변형과 합동","key":"△AED ≡ △FEC (ASA)","sol":["$\\overline{DE}=\\overline{CE}$, 맞꼭지각, 엇각이므로 $\\triangle AED\\equiv\\triangle FEC$","$\\overline{CF}=\\overline{AD}=7$","$\\overline{BF}=\\overline{BC}+\\overline{CF}=7+7=14\\,\\text{cm}$"],"check":"ok"},
"16":{"tp":"겹친 정사각형의 넓이","key":"△OPC ≡ △OQD (ASA)","sol":["$\\angle POC=\\angle QOD$, $\\overline{OC}=\\overline{OD}$, $\\angle OCP=\\angle ODQ=45^\\circ$","$\\square OPCQ=\\triangle OCD=\\dfrac{1}{4}\\times36=9\\,\\text{cm}^2$"],"check":"ok"},
"17":{"tp":"평행선과 넓이","key":"DC∥AE ⇒ △ACD=△ECD","sol":["$\\triangle ACD=\\triangle ECD$이므로 $\\triangle DBE=\\triangle ABC=32$","$\\overline{BM}=\\overline{ME}$이므로 $\\triangle DBM=\\dfrac{1}{2}\\times32=16\\,\\text{cm}^2$"],"check":"ok"},
"18":{"tp":"피타고라스 정리","key":"5:12:13","sol":["$(5a)^2+(12a)^2=26^2$, $169a^2=676$, $a=2$","세 변 $10,24,26$, 둘레 $60$"],"check":"원본 ⑤ 선택지가 비어 있어 정답 60으로 채움"},
"19":{"tp":"피타고라스 정리","key":"빗변² = 나머지 두 변의 제곱의 합","sol":["$\\angle C=90^\\circ$이므로 $15^2=x^2+9^2$","$x^2=225-81=144$"],"check":"ok"},
