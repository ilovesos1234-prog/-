{
"1":{"tp":"닮은 원기둥의 닮음비","key":"높이의 비 = 닮음비","sol":["닮음비 $=6:9=2:3$","$4:r=2:3$ → $r=6\\,(\\text{cm})$"],"check":"ok"},
"2":{"tp":"두 주사위의 눈의 합","key":"순서쌍으로 세기","sol":["$(1,5),(2,4),(3,3),(4,2),(5,1)$","$5$가지"],"check":"ok"},
"3":{"tp":"평행사변형의 대변","key":"$\\overline{\\text{AB}}+\\overline{\\text{BC}}=25$","sol":["둘레 $=2(\\overline{\\text{AB}}+\\overline{\\text{BC}})=50$ → $\\overline{\\text{AB}}+\\overline{\\text{BC}}=25$","$\\overline{\\text{AB}}=25\\times\\dfrac35=15$","$\\overline{\\text{CD}}=\\overline{\\text{AB}}=15\\,(\\text{cm})$"],"check":"ok"},
"4":{"tp":"평행사변형이 되는 조건","key":"한 쌍의 대변이 평행하고 길이가 같다","sol":["③ $\\angle\\text{ACB}=\\angle\\text{CAD}$ (엇각) → $\\overline{\\text{AD}}\\parallel\\overline{\\text{BC}}$","$\\overline{\\text{AD}}=\\overline{\\text{BC}}=24\\,\\text{cm}$ → 평행사변형","① ⑤는 등변사다리꼴 등도 가능, ②④는 조건 부족"],"check":"ok"},
"5":{"tp":"여러 가지 사각형","key":"이웃한 두 변이 같은 평행사변형은 마름모","sol":["④ 이웃하는 두 변의 길이가 같은 평행사변형은 마름모 (정사각형이라 할 수 없다)"],"check":"ok"},
"6":{"tp":"마름모의 각","key":"$\\angle\\text{B}=\\angle\\text{D}=65^\\circ$","sol":["$\\triangle$ABE에서 $\\angle\\text{B}=90^\\circ-25^\\circ=65^\\circ$","$\\angle\\text{BAD}=180^\\circ-65^\\circ=115^\\circ$","$\\angle\\text{DAF}=25^\\circ$ ($\\angle\\text{D}=65^\\circ$)","$\\angle\\text{EAF}=115^\\circ-25^\\circ-25^\\circ=65^\\circ$"],"check":"ok"},
"7":{"tp":"직각삼각형의 세 정사각형","key":"P = Q + R","sol":["Q $=13-4=9$","$\\overline{\\text{BC}}=3\\,(\\text{cm})$"],"check":"ok"},
"8":{"tp":"평행선과 선분의 비","key":"$\\dfrac{1}{\\overline{\\text{EF}}}=\\dfrac1x+\\dfrac1{12}$, $\\overline{\\text{AF}}:\\overline{\\text{FD}}=x:12$","sol":["$\\triangle$ABF $\\sim$ $\\triangle$DCF → $\\overline{\\text{BF}}:\\overline{\\text{FC}}=x:12$","$\\overline{\\text{EF}}=\\dfrac{12x}{x+12}=4$ → $x=6$","$\\overline{\\text{AD}}=\\sqrt{9^2+12^2}=15$, $\\overline{\\text{AF}}:\\overline{\\text{FD}}=6:12=1:2$ → $y=10$","$x+y=16$"],"check":"y는 그림에서 $\\overline{\\text{FD}}$로 표시된 길이로 읽음"},
"9":{"tp":"무게중심과 넓이","key":"F는 $\\triangle$ADC의 무게중심","sol":["$\\triangle\\text{ADC}=\\dfrac23\\times54=36$","$\\overline{\\text{AE}}$, $\\overline{\\text{CM}}$은 $\\triangle$ADC의 중선 → F는 무게중심","무게중심으로 나뉜 $6$개의 삼각형은 각각 $6$","$\\square\\text{DEFM}=\\triangle\\text{MDF}+\\triangle\\text{DEF}=12\\,(\\text{cm}^2)$"],"check":"ok"},
"10":{"tp":"경우의 수 비교","key":"각각 계산","sol":["① $3$ ② $3\\times2=6$ ③ $3^3=27$ ④ $2$ ⑤ $3\\times3\\times2=18$","가장 큰 것은 ③"],"check":"ok"},
"11":{"tp":"확률로 개수 구하기","key":"$\\dfrac{6}{10+x}=\\dfrac25$","sol":["$10+x=15$","$x=5$"],"check":"ok"},
"12":{"tp":"확률의 성질","key":"$0\\le p\\le1$, 여사건 $1-p$","sol":["① $0\\le p\\le1$ ③ $p=1$ ④ $p=0$ ⑤ 합은 $1$","② 옳다"],"check":"ok"},
"13":{"tp":"적어도 한 명일 확률","key":"$1-$(남학생만 뽑힐 확률)","sol":["전체 $\\dfrac{7\\times6}{2}=21$, 남학생만 $3$","$1-\\dfrac{3}{21}=\\dfrac67$"],"check":"ok"},
"14":{"tp":"직각삼각형의 닮음","key":"$\\triangle\\text{FDC}\\sim\\triangle\\text{BDA}$ (AA)","sol":["이등변삼각형의 꼭지각의 이등분선 → $\\overline{\\text{AD}}\\perp\\overline{\\text{BC}}$, $\\overline{\\text{DC}}=6$","$\\angle\\text{FCD}=90^\\circ-\\angle\\text{B}=\\angle\\text{BAD}$ → $\\triangle\\text{FDC}\\sim\\triangle\\text{BDA}$","$4:6=6:\\overline{\\text{AD}}$ → $\\overline{\\text{AD}}=9$","넓이 $=\\dfrac12\\times12\\times9=54\\,(\\text{cm}^2)$"],"check":"ok"},
"15":{"tp":"사다리꼴의 중점연결과 무게중심","key":"$\\overline{\\text{EF}}=\\dfrac{y+22}2$, $\\overline{\\text{GG}'}=\\dfrac13\\overline{\\text{AD}}$","sol":["$\\dfrac{y+22}{2}=18$ → $y=14$","$\\overline{\\text{HG}}:\\overline{\\text{HA}}=\\overline{\\text{HG}'}:\\overline{\\text{HD}}=1:3$ → $\\overline{\\text{GG}'}\\parallel\\overline{\\text{AD}}$","$x=\\dfrac{14}{3}$","$xy=\\dfrac{196}{3}$"],"check":"ok"},
"16":{"tp":"각의 이등분선과 중점연결정리","key":"$\\overline{\\text{MN}}\\parallel\\overline{\\text{AC}}$ → $\\overline{\\text{ME}}=\\overline{\\text{MA}}$","sol":["$\\overline{\\text{AC}}=a$라 하면 $\\overline{\\text{MN}}=\\dfrac a2$, $\\angle\\text{MEA}=\\angle\\text{EAC}=\\angle\\text{MAE}$ → $\\overline{\\text{ME}}=a$, $\\overline{\\text{NE}}=\\dfrac a2$","$\\overline{\\text{BD}}:\\overline{\\text{DC}}=2:1$, $\\triangle\\text{NED}\\sim\\triangle\\text{CAD}$ (닮음비 $1:2$)","$\\triangle\\text{CAD}=24$, $\\triangle\\text{ABC}=3\\times24=72$","$\\square\\text{AMND}=\\triangle\\text{ABD}-\\triangle\\text{MBN}=48-18=30$"],"check":"ok"},
"17":{"tp":"방정식을 만족하는 확률","key":"$2x+y=9$인 순서쌍","sol":["$(2,5),(3,3),(4,1)$ → $3$가지","$\\dfrac{3}{36}=\\dfrac1{12}$"],"check":"ok"},
"18":{"tp":"마름모의 대각선","key":"대각선은 서로를 수직이등분","sol":["한 변 $=60\\div4=15$, $\\overline{\\text{BO}}=12$","$\\triangle$ABO에서 $\\overline{\\text{AO}}=\\sqrt{15^2-12^2}=9$","$\\overline{\\text{AC}}=18\\,\\text{cm}$"],"check":"ok"},
"19":{"tp":"AA 닮음","key":"$\\triangle\\text{ABD}\\sim\\triangle\\text{ACB}$","sol":["$\\angle$A는 공통, $\\angle\\text{ABD}=\\angle\\text{ACB}$ → $\\triangle\\text{ABD}\\sim\\triangle\\text{ACB}$ (AA 닮음)","$\\overline{\\text{AB}}:\\overline{\\text{AC}}=\\overline{\\text{AD}}:\\overline{\\text{AB}}$ → $12:\\overline{\\text{AC}}=8:12$","$\\overline{\\text{AC}}=18$, $\\overline{\\text{CD}}=18-8=10\\,(\\text{cm})$"],"check":"ok"},
"20":{"tp":"중점연결정리","key":"$\\triangle$AME와 $\\triangle$CBD에서 각각 중점연결정리","sol":["$\\triangle$CBD: M은 $\\overline{\\text{BC}}$의 중점, $\\overline{\\text{ME}}\\parallel\\overline{\\text{BD}}$ → $\\overline{\\text{BD}}=2\\times8=16$","$\\triangle$AME: N은 $\\overline{\\text{AM}}$의 중점, $\\overline{\\text{ND}}\\parallel\\overline{\\text{ME}}$ → $\\overline{\\text{ND}}=\\dfrac12\\times8=4$","$\\overline{\\text{BN}}=16-4=12\\,(\\text{cm})$"],"check":"ok"},
"21":{"tp":"확률의 곱셈과 덧셈","key":"(파,노) 또는 (노,파)","sol":["A에서 파랑, B에서 노랑: $\\dfrac46\\times\\dfrac48=\\dfrac13$","A에서 노랑, B에서 파랑: $\\dfrac26\\times\\dfrac48=\\dfrac16$","$\\dfrac13+\\dfrac16=\\dfrac12$"],"check":"ok"}
