{
"1":{"tp":"연립방정식의 해와 그래프의 교점","key":"두 그래프의 교점의 좌표가 해","sol":["$x=2y-4$를 $3x-y=-7$에 대입: $5y-12=-7$, $y=1$","$x=-2$ → 해는 $(-2,\\,1)$ (그래프의 교점과 일치)"],"check":"ok"},
"2":{"tp":"교점의 좌표를 대입해 상수 구하기","key":"교점 $(-2,\\,3)$을 두 식에 대입","sol":["$-2+6=a$ → $a=4$","$-2b+3=-3$ → $b=3$","$a+b=7$"],"check":"ok"},
"3":{"tp":"이등변삼각형과 합동","key":"$\\triangle$DBC $\\equiv$ $\\triangle$ECB (SAS)","sol":["$\\overline{\\text{AD}}=\\overline{\\text{AE}}$, $\\angle$A 공통 → $\\triangle\\text{ABE}\\equiv\\triangle\\text{ACD}$","$\\triangle\\text{DBC}\\equiv\\triangle\\text{ECB}$ → $\\overline{\\text{DC}}=\\overline{\\text{EB}}$, $\\angle\\text{FBC}=\\angle\\text{FCB}$","$\\angle$FCB와 $\\angle$FCE가 같을 이유는 없다 → ④"],"check":"ok"},
"4":{"tp":"RHS 합동과 직각이등변삼각형","key":"$\\triangle\\text{DAP}\\equiv\\triangle\\text{DCQ}$ (RHS) → $\\angle\\text{PDQ}=90^\\circ$","sol":["$\\overline{\\text{DA}}=\\overline{\\text{DC}}$, $\\overline{\\text{DP}}=\\overline{\\text{DQ}}$, 빗변과 한 변 → RHS 합동","$\\angle\\text{CDQ}=\\angle\\text{ADP}=30^\\circ$ → $\\angle\\text{PDQ}=90^\\circ$, $\\angle\\text{DQP}=45^\\circ$","$\\angle\\text{DQC}=90^\\circ-30^\\circ=60^\\circ$","$\\angle\\text{BQP}=60^\\circ-45^\\circ=15^\\circ$"],"check":"ok"},
"5":{"tp":"직각삼각형의 외접원·내접원","key":"빗변 $=2R=12$, $b+c-a=2r$","sol":["외심이 $\\overline{\\text{BC}}$ 위 → $\\angle\\text{A}=90^\\circ$, $\\overline{\\text{BC}}=12$","내접원: $\\overline{\\text{AB}}+\\overline{\\text{AC}}=12+2\\times2=16$","$(b+c)^2=b^2+c^2+2bc$: $256=144+2bc$, $bc=56$","넓이 $=\\dfrac{bc}{2}=28\\,(\\text{cm}^2)$"],"check":"ok"},
"6":{"tp":"외심과 내심의 성질","key":"외심·내심이 같은 각의 이등분선 위 → 이등변삼각형","sol":["ㄱ, ㄴ 옳다","ㄷ 수직이등분선의 교점은 외심 (×)","ㄹ $\\angle$A의 이등분선이 $\\overline{\\text{BC}}$의 수직이등분선 → 이등변삼각형 (○)","ㅁ 세 꼭짓점까지 거리가 같은 점은 외심 (×)"],"check":"ok"},
"7":{"tp":"닮은 도형의 대응","key":"순서대로 대응: A-E, B-F, C-G, D-H","sol":["ㄱ $\\angle\\text{F}=\\angle\\text{B}=90^\\circ$ (○)","ㄴ $\\overline{\\text{BC}}:\\overline{\\text{FG}}=8:4=2:1$ (×)","ㄷ $\\overline{\\text{GH}}=6\\times\\dfrac12=3\\,\\text{cm}$ (×)","ㄹ (○), ㅁ C에 대응하는 점은 G (×)"],"check":"ok"},
"8":{"tp":"닮음의 뜻과 성질","key":"넓이가 같다고 닮음은 아니다","sol":["① 넓이가 같아도 모양이 다를 수 있다 (×)","②③④⑤는 닮음의 성질로 옳다"],"check":"④는 원본에 '대응하는 변은 서로 닮은 도형'으로 인쇄되어 있으나 '면'의 오타로 보고 옮겨 적음"},
"9":{"tp":"삼각형의 닮음 조건 찾기","key":"두 변의 비와 끼인각 비교","sol":["$\\overline{\\text{AB}}:\\overline{\\text{QP}}=4:6$, $\\overline{\\text{BC}}:\\overline{\\text{PR}}=6:9$, $\\angle\\text{B}=\\angle\\text{P}=65^\\circ$ → $\\triangle\\text{ABC}\\sim\\triangle\\text{QPR}$ (SAS)","$\\triangle$DEF와 $\\triangle$HGI는 AA 닮음, $\\triangle$JKL과 $\\triangle$NMO는 SSS 닮음이므로 ②③④는 틀림"],"check":"ok"},
"10":{"tp":"평행선 사이의 선분의 비","key":"$6:12=8:x$","sol":["$6:12=8:x$","$x=16$"],"check":"ok"},
"11":{"tp":"무게중심과 넓이","key":"F는 $\\triangle$ADC의 무게중심","sol":["$\\overline{\\text{CG}}$, $\\overline{\\text{AE}}$는 $\\triangle$ADC의 중선 → F는 무게중심","$\\triangle\\text{CFE}=\\dfrac16\\triangle\\text{ADC}$ → (가) $\\dfrac16$, (나) $24$","$\\triangle\\text{ABD}=\\triangle\\text{ADC}\\times\\dfrac12=12$ → (다) $\\dfrac12$","$\\triangle\\text{ABC}=12+24=36$ → (라) $36$","$ab+cd=\\dfrac16\\times24+\\dfrac12\\times36=4+18=22$"],"check":"ok"},
"12":{"tp":"피타고라스 정리","key":"빗변 위 정사각형 = 두 정사각형의 합","sol":["$9^2+12^2=81+144=225\\,(\\text{cm}^2)$"],"check":"ok"},
"13":{"tp":"경우의 수","key":"$20$ 이하의 $3$의 배수","sol":["$3,6,9,12,15,18$ → $6$가지"],"check":"ok"},
"14":{"tp":"합의 법칙","key":"동시에 일어나지 않는 경우는 더한다","sol":["$2+3+4=9$"],"check":"ok"},
"15":{"tp":"반드시 일어나는 사건","key":"확률 $1$ = 반드시 일어남","sol":["① $\\dfrac13$ ② $1$ ③ $\\dfrac12$ ④ $0$ ⑤ $\\dfrac1{10}$","② 주사위 눈은 항상 $6$ 이하"],"check":"ok"},
"16":{"tp":"세 직선이 삼각형을 만들지 않는 조건","key":"한 점에서 만나거나 두 직선이 평행","sol":["(1) $4x+8=3-x$에서 $x=-1$, $y=4$ → $(-1,\\,4)$를 $y=ax-1$에 대입: $4=-a-1$, $a=-5$","(2) $y=ax-1$이 $y=4x+8$과 평행하면 $a=4$, $x+y=3$($y=-x+3$)과 평행하면 $a=-1$","(3) $a=-5,\\,-1,\\,4$"],"check":"ok"},
"17":{"tp":"내심과 넓이 / 이등변삼각형","key":"(1) 넓이 $=\\dfrac12r(a+b+c)$ (2) $36^\\circ$, $72^\\circ$ 각 비교","sol":["(1) $\\triangle\\text{ABC}=\\dfrac12\\times4\\times(14+15+13)=84\\,(\\text{cm}^2)$","(2) $\\angle\\text{B}=\\angle\\text{C}=72^\\circ$, $\\angle\\text{A}=36^\\circ$, $\\angle\\text{ABD}=\\angle\\text{DBC}=36^\\circ$","$\\triangle$ABD: $\\angle\\text{A}=\\angle\\text{ABD}=36^\\circ$ → $\\overline{\\text{DA}}=\\overline{\\text{DB}}$","$\\triangle$BCD: $\\angle\\text{BDC}=180^\\circ-36^\\circ-72^\\circ=72^\\circ=\\angle\\text{C}$ → $\\overline{\\text{BD}}=\\overline{\\text{BC}}$","이등변삼각형: $\\triangle$ABC, $\\triangle$ABD, $\\triangle$BCD"],"check":"ok"},
"18":{"tp":"삼각형의 닮음 조건","key":"합동 조건의 '같다'를 '비가 같다'로","sol":["세 쌍의 대응변의 길이의 비가 같을 때 (SSS 닮음)","두 쌍의 대응변의 길이의 비가 같고 그 끼인각의 크기가 같을 때 (SAS 닮음)","두 쌍의 대응각의 크기가 각각 같을 때 (AA 닮음)"],"check":"답안의 그림은 생략(서술형 채점 기준은 원본 없음)"},
"19":{"tp":"피타고라스 정리의 활용","key":"(1) D에서 수선 (2) M, N에서 수선을 내려 좌표처럼","sol":["(1) D에서 $\\overline{\\text{BC}}$에 수선 DH: $\\overline{\\text{DH}}=12$, $\\overline{\\text{HC}}=24-19=5$","$\\overline{\\text{CD}}=\\sqrt{12^2+5^2}=13\\,(\\text{cm})$","(2) $\\overline{\\text{AB}}=a$, $\\overline{\\text{BC}}=c$이면 M은 B에서 가로 $\\dfrac c3$, 세로 $\\dfrac{2a}3$, N은 가로 $\\dfrac{2c}3$, 세로 $\\dfrac a3$","$\\dfrac{c^2}9+\\dfrac{4a^2}9=36$, $\\dfrac{4c^2}9+\\dfrac{a^2}9=64$","더하면 $\\dfrac59(a^2+c^2)=100$, $\\overline{\\text{AC}}^2=a^2+c^2=180$","$\\overline{\\text{MN}}^2=\\dfrac{180}{9}=20$"],"check":"ok"}
}
