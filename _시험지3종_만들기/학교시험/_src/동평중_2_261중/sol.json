"1":{"tp":"순환마디","key":"순환마디의 숫자 개수","sol":["$\\frac{5}{7}=0.\\dot{7}1428\\dot{5}$ ⇒ $x=6$","$\\frac{8}{15}=0.5\\dot{3}$ ⇒ $y=1$","$x+y=7$"],"check":"ok"},
"2":{"tp":"순환소수가 되는 분수","key":"기약분수의 분모에 2, 5 외의 소인수","sol":["ㄱ $\\frac{5}{2^3}$, ㄴ $\\frac{3}{10}$, ㄷ $\\frac{7}{10}$ ⇒ 유한소수","ㄹ $\\frac{29}{3\\times11}$, ㅁ $\\frac{7}{2^2\\times3}$, ㅂ $\\frac{10}{7^2}$ ⇒ 순환소수"],"check":"ok"},
"3":{"tp":"순환소수가 되는 조건","key":"유한소수가 되는 a를 빼기","sol":["$\\frac{18}{200a}=\\frac{9}{100a}=\\frac{3^2}{2^2\\times5^2\\times a}$","유한소수가 되는 $a$: $2,5$와 $3,9$만으로 된 수 $1,2,3,4,5,6,8,9,10,12,15,16,18,20$ ($14$개)","$20-14=6$(개): $7,11,13,14,17,19$"],"check":"ok"},
"4":{"tp":"유한소수 분수 개수","key":"28=2²×7 ⇒ 분자가 7의 배수","sol":["$\\frac{1}{4}=\\frac{7}{28}$, $\\frac{6}{7}=\\frac{24}{28}$ ⇒ $7\\lt n\\lt24$","$n$은 $7$의 배수: $14,21$ ⇒ $2$개"],"check":"ok"},
"5":{"tp":"순환소수→분수","key":"(전체-비순환부분)÷990","sol":["$1.3\\dot{5}\\dot{9}=\\frac{1359-13}{990}=\\frac{1346}{990}=\\frac{673}{495}$"],"check":"ok"},
"6":{"tp":"무한급수를 순환소수로","key":"공통인수로 묶어 0.111…로","sol":["$\\frac{1}{5^2}\\left(1+\\frac{1}{10}+\\frac{1}{10^2}+\\cdots\\right)=\\frac{1}{25}\\times1.\\dot{1}=\\frac{1}{25}\\times\\frac{10}{9}=\\frac{2}{45}$","$1+\\frac{2}{45}=\\frac{47}{45}$ ⇒ $a-b=2$"],"check":"ok"},
"7":{"tp":"지수법칙","key":"각 식 계산","sol":["① $x^8$ ② $1$ ③ $x^6$ ⑤ $64x^3y^6$","④ $\\frac{y^6}{x^2}$ 옳다"],"check":"ok"},
"8":{"tp":"자릿수","key":"2와 5의 지수를 맞춰 10의 거듭제곱","sol":["$8^{12}\\times3\\times5^{29}=2^{36}\\times3\\times5^{29}=2^7\\times3\\times10^{29}$","$=384\\times10^{29}$ ⇒ $3+29=32$자리"],"check":"ok"},
"9":{"tp":"거듭제곱을 문자로","key":"9=3²","sol":["$9^{x-2}=3^{2x-4}=\\frac{(3^x)^2}{3^4}=\\frac{A^2}{81}$"],"check":"ok"},
"10":{"tp":"지수 비교","key":"계수·지수 각각 비교","sol":["$\\frac{2^ax^{a+2}y^{11}}{y^{3a}}$에서 $2^a=64$ ⇒ $a=6$","$b=8$, $y^{11-18}=\\frac{1}{y^7}$ ⇒ $c=7$","$a+b-c=7$"],"check":"ok"},
"11":{"tp":"식의 값","key":"간단히 한 후 대입","sol":["$-8x^3y^9\\div(-4x^3y^2)\\times\\frac{x^4}{y^6}=2x^4y$","$2\\times1\\times\\frac{1}{2}=1$"],"check":"ok"},
"12":{"tp":"넓이의 비","key":"넓이 각각 구해서 나누기","sol":["삼각형 $\\frac{1}{2}\\times x^3y^2\\times2xy=x^4y^3$","사다리꼴 $\\frac{1}{2}(x^3y^2+2x^2y)\\times6x=3x^4y^2+6x^3y$","$\\frac{3x^4y^2+6x^3y}{x^4y^3}=\\frac{3}{y}+\\frac{6}{xy^2}$"],"check":"ok"},
"13":{"tp":"괄호 풀기","key":"안쪽 괄호부터","sol":["$2b-a+3b+\\square+a=5b+\\square$","$3a-5b-\\square=a-5b$ ⇒ $\\square=2a$"],"check":"ok"},
"14":{"tp":"혼합 계산","key":"나눗셈·곱셈 먼저","sol":["$(8a^2b^2-4ab^2-12b^2)\\div4b^2=2a^2-a-3$","$-(5a-7)(-4a)=20a^2-28a$","합 $22a^2-29a-3$ ⇒ $-29+(-3)=-32$"],"check":"ok"},
"15":{"tp":"부등식의 성질","key":"a>b","sol":["$-3a\\lt-3b$ ⇒ $a\\gt b$","①~④는 $\\gt$, ⑤는 $-6a\\lt-6b$ ⇒ $\\lt$"],"check":"ok"},
"16":{"tp":"해가 음수일 조건","key":"x<k에서 k≤0","sol":["$-2x\\gt a+2$ ⇒ $x\\lt-\\frac{a+2}{2}$","모두 음수 ⇒ $-\\frac{a+2}{2}\\le0$ ⇒ $a\\ge-2$","가장 작은 값 $-2$"],"check":"ok"},
"17":{"tp":"자릿수 숫자의 합","key":"순환마디 6자리 합 27","sol":["$\\frac{5}{7}=0.\\dot{7}1428\\dot{5}$, 마디의 합 $27$","$51=6\\times8+3$","$27\\times8+(7+1+4)=228$"],"check":"ok"},
"18":{"tp":"왕복 거리","key":"걷는 시간 ≤ 35분","sol":["상점까지 거리 $x$km: $\\frac{2x}{3}+\\frac{25}{60}\\le1$","$\\frac{2x}{3}\\le\\frac{7}{12}$ ⇒ $x\\le\\frac{7}{8}$","$\\frac{7}{8}$km 이내"],"check":"ok"},
"19":{"tp":"바르게 계산한 식","key":"A 먼저 구하기","sol":["$A=-2x^2+3x+5-(x^2+x-2)=-3x^2+2x+7$","바른 식 $x^2+x-2-A=4x^2-x-9$","$a=4,\\ b=1,\\ c=-9$ ⇒ $a+b+c=-4$"],"check":"ok"},
"20":{"tp":"입체도형의 높이","key":"부피÷밑넓이","sol":["원기둥 높이 $(9\\pi a^3b-2\\pi a^2)\\div\\pi a^2=9ab-2$","원뿔 높이 $\\left(\\frac{1}{6}\\pi a^2+4\\pi a^3b\\right)\\times\\frac{3}{\\pi a^2}=\\frac{1}{2}+12ab$","$h=21ab-\\frac{3}{2}$"],"check":"ok"}
