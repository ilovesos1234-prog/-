{
"1":{"tp":"최빈값","key":"도수가 가장 큰 변량","sol":["하양이 $9$명으로 가장 많다","최빈값은 하양 (도수 $9$가 아니라 변량)"],"check":"ok"},
"2":{"tp":"대푯값의 성질","key":"최빈값은 두 개 이상일 수 있다","sol":["최빈값은 여러 개일 수도, 없을 수도 있다","① 옳지 않다"],"check":"ok"},
"3":{"tp":"원과 부채꼴의 성질","key":"넓이는 중심각에 정비례, 현의 길이와는 아님","sol":["부채꼴의 넓이는 중심각의 크기에 정비례한다","현의 길이와는 정비례하지 않으므로 ②가 옳지 않다"],"check":"ok"},
"4":{"tp":"정십이면체","key":"정오각형 $12$개 → 정십이면체","sol":["면 $12$, 모서리 $\\dfrac{12\\times5}{2}=30$","꼭짓점 $\\dfrac{12\\times5}{3}=20$","④ 꼭짓점이 $30$개는 틀림"],"check":"ok"},
"5":{"tp":"정사각뿔의 겉넓이","key":"밑넓이 + 옆넓이","sol":["밑넓이 $4\\times4=16$","옆넓이 $4\\times\\dfrac12\\times4\\times5=40$","겉넓이 $56\\,\\text{cm}^2$"],"check":"ok"},
"6":{"tp":"중앙값으로 변량 구하기","key":"$6$개의 중앙값 = $3$, $4$번째 평균","sol":["$\\dfrac{2+x_4}{2}=4$에서 $x_4=6$","$7$을 넣으면 $7$개의 자료, 중앙값은 $4$번째 값","$x_1,x_2,2,6,\\cdots$ 순서이고 $7\\ge6$이므로 $4$번째 값은 $6$"],"check":"ok"},
"7":{"tp":"중앙값·최빈값으로 변량 구하기","key":"최빈값 $10$ 하나뿐 → $10$이 $3$번 이상","sol":["$6$이 $2$번이므로 $10$은 $3$번 이상 → $a,b,c$ 중 둘은 $10$","셋 다 $10$이면 중앙값 $10$이 되어 안 된다","나머지 하나를 $k$라 하면 $6,6,7,k,10,10,10,11$에서 $\\dfrac{k+10}{2}=9$, $k=8$","평균 $\\dfrac{68}{8}=8.5\\lt 9$이므로 ㄱ, ㄴ, ㄷ, ㄹ 모두 옳다"],"check":"ok"},
"8":{"tp":"원뿔의 겉넓이","key":"$\\pi r^2+\\pi rl$","sol":["$16\\pi+4\\pi l=44\\pi$","$l=7\\,\\text{cm}$"],"check":"ok"},
"9":{"tp":"오각쌍뿔의 모서리와 꼭짓점","key":"면 $10$개 정삼각형 → 오각뿔 두 개를 붙인 모양","sol":["모서리 $a=\\dfrac{10\\times3}{2}=15$","꼭짓점 $=2-10+15=7$: 위·아래 꼭짓점 $2$개(면 $5$개), 가운데 $5$개(면 $4$개)","$b=2$, $a+b=17$"],"check":"ok"},
"10":{"tp":"정육면체에서 잘라 낸 사면체","key":"정육면체 − 삼각뿔 $4$개","sol":["잘라 내는 삼각뿔 하나의 부피 $\\dfrac13\\times\\dfrac12a^2\\times a=\\dfrac16a^3$","$V=a^3-4\\times\\dfrac16a^3=\\dfrac13a^3$"],"check":"ok"},
"11":{"tp":"원기둥에 꼭 맞는 구","key":"구의 반지름 → 원기둥의 반지름·높이","sol":["$\\dfrac43\\pi r^3=36\\pi$에서 $r=3$","원기둥: 반지름 $3$, 높이 $12$ → $108\\pi$","$108\\pi-72\\pi=36\\pi\\,(\\text{cm}^3)$"],"check":"ok"},
"12":{"tp":"원주각과 중심각, 부채꼴의 넓이","key":"색칠한 부분 = $\\triangle AOC$ + 부채꼴 $COB$","sol":["$\\overline{OA}=\\overline{OC}$이므로 $\\angle OCA=30^\\circ$, $\\angle COB=60^\\circ$ (외각)","부채꼴 $COB=\\pi\\times10^2\\times\\dfrac{60}{360}=\\dfrac{50}{3}\\pi$","$\\triangle AOC=S-\\dfrac{50}{3}\\pi$"],"check":"ok"},
"13":{"tp":"정다각형의 내각과 부채꼴","key":"$\\angle BAI=360^\\circ-108^\\circ-120^\\circ$","sol":["정오각형 한 내각 $108^\\circ$, 정육각형 한 내각 $120^\\circ$","$\\angle BAI=132^\\circ$","넓이 $=\\pi\\times3^2\\times\\dfrac{132}{360}=\\dfrac{33}{10}\\pi$"],"check":"ok"},
"14":{"tp":"밑면이 부채꼴 띠인 기둥의 겉넓이","key":"밑면: 반지름 $4$, $2$인 부채꼴의 차","sol":["밑넓이 $=\\pi(4^2-2^2)\\times\\dfrac{60}{360}=2\\pi$, 두 개 $4\\pi$","밑면 둘레 $=\\dfrac{4}{3}\\pi+\\dfrac{2}{3}\\pi+2+2=2\\pi+4$","옆넓이 $=(2\\pi+4)\\times5=10\\pi+20$","겉넓이 $=(20+14\\pi)\\,\\text{cm}^2$"],"check":"ok"},
"15":{"tp":"반구와 원뿔을 붙인 회전체","key":"반구의 곡면 + 원뿔의 옆넓이","sol":["반구(반지름 $4$) 곡면: $2\\pi\\times4^2=32\\pi$","원뿔(반지름 $4$, 모선 $5$) 옆넓이: $\\pi\\times4\\times5=20\\pi$","겉넓이 $=52\\pi\\,(\\text{cm}^2)$"],"check":"ok"},
"16":{"tp":"원기둥에서 원뿔을 뺀 회전체","key":"원기둥(반지름 $5$, 높이 $4$) − 원뿔(반지름 $3$, 높이 $4$)","sol":["원기둥 $\\pi\\times5^2\\times4=100\\pi$","원뿔 $\\dfrac13\\pi\\times3^2\\times4=12\\pi$","$100\\pi-12\\pi=88\\pi\\,(\\text{cm}^3)$"],"check":"ok"}
}
