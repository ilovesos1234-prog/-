{
"1":{"tp":"중심에서 같은 거리의 현","key":"OM = ON 이면 AB = CD","sol":["$\\overline{OM}\\perp\\overline{AB}$ 이므로 $\\overline{AB}=2\\overline{MB}=6$","$\\overline{OM}=\\overline{ON}$ 이므로 $\\overline{CD}=\\overline{AB}=6$, $x=6$"],"check":"ok"},
"2":{"tp":"깨진 원의 반지름 구하기","key":"현의 수직이등분선은 중심을 지난다","sol":["반지름을 $r$이라 하면 중심은 직선 CM 위에 있고 $\\overline{AM}=\\sqrt{7}$","$r^2=(\\sqrt{7})^2+(r-1)^2$ → $2r=8$, $r=4$","넓이 $=16\\pi$"],"check":"ok"},
"3":{"tp":"중심에서 같은 거리의 두 현","key":"O에서 AB, AC까지 거리가 같다 → AB = AC","sol":["O에서 $\\overline{AB}$, $\\overline{AC}$에 이르는 거리가 같으므로 $\\overline{AB}=\\overline{AC}$","$\\angle ACB=50^\\circ$, $\\angle A=80^\\circ$ 이므로 $\\angle BOC=160^\\circ$","$\\triangle OBC$는 이등변삼각형: $\\angle OBC=\\dfrac{180^\\circ-160^\\circ}{2}=10^\\circ$"],"check":"ok"},
"4":{"tp":"두 접선이 이루는 각과 원주각","key":"∠AOB = 180° − ∠APB","sol":["$\\angle PAO=\\angle PBO=90^\\circ$ 이므로 $\\angle AOB=180^\\circ-50^\\circ=130^\\circ$","$\\angle x=\\dfrac{1}{2}\\times 130^\\circ=65^\\circ$"],"check":"ok"},
"5":{"tp":"삼각형의 내접원과 접선의 길이","key":"한 점에서 그은 두 접선의 길이는 같다","sol":["$\\overline{AR}=\\overline{AP}=5$, $\\overline{CR}=11-5=6=\\overline{CQ}$","$\\overline{BQ}=14-6=8$, $x=\\overline{BP}=8$"],"check":"ok"},
"6":{"tp":"반원에 접하는 세 직선","key":"CD = AD + BC, C에서 수선","sol":["$\\overline{CD}=\\overline{AD}+\\overline{BC}=4+6=10$","D에서 $\\overline{BC}$에 수선을 내리면 밑변 차 $6-4=2$","$\\overline{AB}=\\sqrt{10^2-2^2}=\\sqrt{96}=4\\sqrt{6}$"],"check":"ok"},
"7":{"tp":"외접사각형과 접선의 길이","key":"꼭짓점에서 두 접점까지의 길이가 같다","sol":["$\\overline{DS}=\\overline{DR}=2$ 이므로 $y=\\overline{AP}=\\overline{AS}=5-2=3$","$\\overline{CQ}=\\overline{CR}=4$ 이므로 $x=\\overline{BP}=\\overline{BQ}=9-4=5$","$2x-y=10-3=7$"],"check":"ok"},
"8":{"tp":"원주각과 중심각","key":"x가 보는 호의 중심각은 360° − 140°","sol":["$\\angle x$에 대한 호의 중심각은 $360^\\circ-140^\\circ=220^\\circ$","$\\angle x=110^\\circ$"],"check":"ok"},
"9":{"tp":"호의 길이와 원주각","key":"호의 길이는 원주각에 정비례, AB는 지름","sol":["$\\overline{AB}$가 지름이므로 반원의 호 길이 $=12+6=18=\\pi r$, $r=\\dfrac{18}{\\pi}$","호 BC가 반원의 $\\dfrac{1}{3}$이므로 $\\angle BAC=30^\\circ$, $\\angle ACB=90^\\circ$","$\\overline{BC}=\\overline{AB}\\sin 30^\\circ=r=\\dfrac{18}{\\pi}$"],"check":"ok"},
"10":{"tp":"호의 길이와 원주각","key":"PB는 지름, 호의 길이 비 = 원주각 비","sol":["호 BC $=3$에 대한 원주각 $\\angle BPC=21^\\circ$","호 PA $=9$에 대한 원주각 $\\angle PBA=3\\times 21^\\circ=63^\\circ$","$\\overline{PB}$가 지름이므로 $\\angle PAB=90^\\circ$, $\\angle x=90^\\circ-63^\\circ=27^\\circ$"],"check":"ok"},
"11":{"tp":"한 원 위의 네 점과 원주각","key":"∠ABD = ∠ACD","sol":["네 점이 한 원 위에 있으므로 $\\angle ABD=\\angle ACD=38^\\circ$","대각선의 교점을 E라 하면 $\\triangle ABE$에서 $\\angle x=180^\\circ-60^\\circ-38^\\circ=82^\\circ$"],"check":"ok"},
"12":{"tp":"지름과 내접사각형","key":"∠BDC = 90°, 대각의 합 180°","sol":["$\\overline{BC}$가 지름이므로 $\\angle BDC=90^\\circ$, $\\angle y=90^\\circ-28^\\circ=62^\\circ$","$\\angle x=180^\\circ-62^\\circ=118^\\circ$","$\\angle x-\\angle y=56^\\circ$"],"check":"ok"},
"13":{"tp":"내접사각형과 두 변의 연장선","key":"△ECD에서 ∠ADC, 대각으로 ∠ABC","sol":["$\\triangle ECD$에서 $\\angle ADC=180^\\circ-45^\\circ-50^\\circ=85^\\circ$","$\\angle ABC=180^\\circ-85^\\circ=95^\\circ$","$\\triangle FBC$에서 $\\angle x=180^\\circ-95^\\circ-50^\\circ=35^\\circ$"],"check":"ok"},
"14":{"tp":"접선과 현이 이루는 각","key":"∠PTA = ∠ABT, TA = TB","sol":["$\\angle ABT=\\angle PTA=70^\\circ$","$\\overline{TA}=\\overline{TB}$ 이므로 $\\angle TAB=70^\\circ$","$\\angle x=180^\\circ-140^\\circ=40^\\circ$"],"check":"ok"},
"15":{"tp":"접선과 현, 지름","key":"∠PTB = ∠BCT, ∠BTC = 90°","sol":["접선과 현이 이루는 각: $\\angle BCT=\\angle PTB=56^\\circ$","$\\overline{BC}$가 지름이므로 $\\angle BTC=90^\\circ$, $\\angle x=34^\\circ$","$\\angle y=\\angle TAC=\\angle TBC=34^\\circ$ (같은 호 TC)","$\\angle x+\\angle y=68^\\circ$"],"check":"ok"},
"16":{"tp":"접선과 현, 같은 호","key":"AC = AD → ∠ACD = ∠ADC, 접선-현 각","sol":["호 AC = 호 AD 이므로 $\\angle ACD=\\angle ADC=\\alpha$, $\\angle CAD=180^\\circ-2\\alpha$","접선과 현: $\\angle PCD=\\angle CAD=180^\\circ-2\\alpha$, 또 $\\angle CDP=180^\\circ-\\alpha$","$\\triangle PCD$: $33^\\circ+(180^\\circ-2\\alpha)+(180^\\circ-\\alpha)=180^\\circ$ → $\\alpha=71^\\circ$","$\\angle ABC=180^\\circ-\\angle ADC=109^\\circ$"],"check":"ok"},
"17":{"tp":"같은 거리의 현 증명","key":"RHS 합동 → AM = CN, 수선은 현을 이등분","sol":["$\\triangle OAM$과 $\\triangle OCN$에서 $\\angle OMA=\\angle ONC=90^\\circ$, $\\overline{OA}=\\overline{OC}$ (반지름), $\\overline{OM}=\\overline{ON}$","RHS 합동이므로 $\\overline{AM}=\\overline{CN}$","중심에서 현에 내린 수선은 현을 이등분하므로 $\\overline{AB}=2\\overline{AM}=2\\overline{CN}=\\overline{CD}$"],"check":"ok"},
"18":{"tp":"현의 수직이등분과 반지름","key":"OM = r/2, AM = 4","sol":["반지름을 $r$이라 하면 $\\overline{OM}=\\dfrac{r}{2}$, $\\overline{AM}=4$","$r^2=4^2+\\left(\\dfrac{r}{2}\\right)^2$ → $\\dfrac{3}{4}r^2=16$, $r^2=\\dfrac{64}{3}$","$r=\\dfrac{8\\sqrt{3}}{3}\\text{ cm}$"],"check":"ok"},
"19":{"tp":"두 접선과 제3의 접선","key":"PA = PB, CA = CE, DE = DB","sol":["$\\overline{PA}=\\overline{PC}+\\overline{CA}=13$, $\\overline{PB}=\\overline{PA}=13$","$\\overline{CE}=\\overline{CA}=3$ 이므로 $\\overline{DE}=7-3=4=\\overline{DB}$","$\\overline{PD}=13-4=9\\text{ cm}$"],"check":"ok"},
"20":{"tp":"접선과 현, 내접사각형","key":"x = ∠BAC, y = ∠DAC (접선-현), ∠BAD = 70°","sol":["$\\square ABCD$가 원에 내접하므로 $\\angle BAD=180^\\circ-110^\\circ=70^\\circ$","접선과 현이 이루는 각: $\\angle x=\\angle BAC$, $\\angle y=\\angle DAC$","$\\angle x+\\angle y=\\angle BAD=70^\\circ$"],"check":"답안표의 손글씨가 흐릿하나 풀이 결과 70°로 일치."}
}
