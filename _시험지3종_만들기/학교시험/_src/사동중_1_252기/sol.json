{
"1":{"tp":"두 직선이 평행할 조건","key":"동위각·엇각이 같거나 같은 직선에 수직이면 평행","sol":["$l\\perp s$, $m\\perp s$이므로 $l\\parallel m$","$p$, $r$은 $l$, $m$과 만나는 각이 $79^\\circ$와 $80^\\circ$의 짝이 맞지 않아 평행이 아니다","따라서 $l\\parallel m$"],"check":"ok"},
"2":{"tp":"평행선과 엇각·동위각","key":"두 직선이 $l$과 이루는 각을 각각 구해 $m$으로 옮긴다","sol":["왼쪽 직선이 $l$과 이루는 각이 $50^\\circ$이므로 동위각에서 $\\angle x=180^\\circ-50^\\circ=130^\\circ$","오른쪽 직선이 $l$과 이루는 각은 $110^\\circ-50^\\circ=60^\\circ$","엇각에서 $\\angle y=60^\\circ$","$\\angle x-\\angle y=70^\\circ$"],"check":"그림의 $110^\\circ$는 왼쪽 직선의 연장선과 오른쪽 직선 사이의 각으로 읽음(정답 ③과 일치)"},
"3":{"tp":"평행선과 정삼각형","key":"$\\angle ACF=180^\\circ-\\angle CAG$, 엇각 이용","sol":["$\\angle CAG=180^\\circ-60^\\circ-\\angle DAB=120^\\circ-\\angle DAB$","$\\angle ACE=\\angle CAG$ (엇각)이므로 $\\angle ACF=180^\\circ-\\angle CAG=60^\\circ+\\angle DAB$","$\\angle ACF-\\angle DAB=60^\\circ$"],"check":"ok"},
"4":{"tp":"작도의 뜻","key":"눈금 없는 자: 선 긋기, 컴퍼스: 길이 옮기기·원 그리기","sol":["①②③ 길이 재기는 하지 않고, 연장·직선 긋기는 자로 한다","④ 작도에서는 눈금을 쓰지 않는다","⑤ 선분의 길이를 옮길 때 컴퍼스를 쓴다 (옳음)"],"check":"ok"},
"5":{"tp":"이등변삼각형의 개수","key":"$2a+b=21$, $b\\lt 2a$, $a\\ne b$","sol":["같은 두 변 $a$, 나머지 $b$: $2a+b=21$이므로 $b$는 홀수","$(a,b)=(10,1),(9,3),(8,5),(7,7),(6,9)$ ($b\\lt 2a$)","$(7,7)$은 정삼각형이므로 제외 → $4$개"],"check":"ok"},
"6":{"tp":"삼각형이 하나로 정해질 조건","key":"SAS, ASA가 되는지 확인","sol":["① 두 변과 끼인각 $\\angle A$ → 정해짐","② $\\angle A$는 $AB$, $BC$의 끼인각이 아니므로 정해지지 않는다","③⑤ 한 변과 양 끝 각, ④ 두 각을 알면 나머지 각도 정해져 ASA"],"check":"ok"},
"7":{"tp":"ASA 합동","key":"나머지 한 각 $65^\\circ$, $8\\,\\text{cm}$는 $65^\\circ$의 대변","sol":["나머지 각 $=180^\\circ-40^\\circ-75^\\circ=65^\\circ$","$8\\,\\text{cm}$인 변은 $40^\\circ$, $75^\\circ$ 사이의 변이므로 $65^\\circ$의 대변","④ 두 각 $65^\\circ$, $75^\\circ$이고 $65^\\circ$의 대변이 $8\\,\\text{cm}$ → 합동"],"check":"ok"},
"8":{"tp":"합동인 도형의 대응","key":"대응변, 대응각은 같다","sol":["$\\overline{DE}=\\overline{AB}=5\\,\\text{cm}$","$\\angle C=\\angle F=70^\\circ$, $\\angle B=60^\\circ$","$\\angle A=180^\\circ-60^\\circ-70^\\circ=50^\\circ$"],"check":"ok"},
"9":{"tp":"정삼각형과 SAS 합동","key":"$\\triangle ABE\\equiv\\triangle ADC$ → $\\angle ABE=\\angle ADC$","sol":["$\\overline{AB}=\\overline{AD}$, $\\overline{AE}=\\overline{AC}$, $\\angle BAE=\\angle DAC=60^\\circ+\\angle BAC$ → SAS 합동","$\\angle ABE=\\angle ADC$이므로 $\\triangle DBF$에서 $\\angle BFD=60^\\circ$, $\\angle x=120^\\circ$","$\\angle FBC+\\angle FCB=60^\\circ$","$\\angle ABE+\\angle ACD+\\angle BAC=180^\\circ-60^\\circ=120^\\circ$이므로 ③이 옳지 않다"],"check":"ok"},
"10":{"tp":"대각선의 개수","key":"$n-3=8$","sol":["$n-3=8$에서 $n=11$","$\\dfrac{11\\times 8}{2}=44$(개)"],"check":"ok"},
"11":{"tp":"삼각형의 내각의 합","key":"외각이 $90^\\circ$이면 내각도 $90^\\circ$","sol":["위 꼭짓점의 외각이 직각이므로 내각도 $90^\\circ$","$\\angle x=180^\\circ-90^\\circ-38^\\circ=52^\\circ$"],"check":"ok"},
"12":{"tp":"다각형의 외각의 합","key":"오각형의 외각의 합은 $360^\\circ$","sol":["$60^\\circ+80^\\circ+95^\\circ+70^\\circ+\\angle x=360^\\circ$","$\\angle x=55^\\circ$"],"check":"ok"},
"13":{"tp":"정다각형의 내각과 외각","key":"한 외각 $=180^\\circ\\times\\dfrac{2}{9}$","sol":["한 외각 $=180^\\circ\\times\\dfrac{2}{9}=40^\\circ$","$360^\\circ\\div 40^\\circ=9$ → 정구각형"],"check":"ok"},
"14":{"tp":"중심각과 호의 길이","key":"호의 길이는 중심각에 정비례","sol":["$x:120=3:9$","$x=40$"],"check":"ok"},
"15":{"tp":"부채꼴의 넓이 차","key":"큰 부채꼴 − 작은 부채꼴","sol":["$\\pi\\times 6^2\\times\\dfrac{45}{360}-\\pi\\times 2^2\\times\\dfrac{45}{360}$","$=\\dfrac{36\\pi-4\\pi}{8}=4\\pi\\,(\\text{cm}^2)$"],"check":"ok"},
"16":{"tp":"원과 부채꼴의 용어와 성질","key":"현의 길이는 중심각에 정비례하지 않는다","sol":["① 직선이 아니라 선분이 현","② 현은 정비례하지 않는다","③ 옳다","④ 호와 현은 활꼴","⑤ 넓이는 같다"],"check":"ok"},
"17":{"tp":"각뿔대의 면·모서리·꼭짓점","key":"$n$각뿔대: 면 $n+2$, 꼭짓점 $2n$, 모서리 $3n$","sol":["$n+2=8$에서 육각뿔대","$x=12$, $y=18$","$x+y=30$"],"check":"ok"},
"18":{"tp":"정다면체의 성질","key":"면 모양 3가지, 꼭짓점 수 최대는 정십이면체(20개)","sol":["가. 면의 모양은 정삼각형, 정사각형, 정오각형의 $3$가지 (×)","나. 정팔면체는 한 꼭짓점에 $4$개 (○)","다. 정오각형 면은 정십이면체 (×)","라. 정십이면체 꼭짓점 $20$개로 가장 많다 (○)","마. 각 꼭짓점에 모인 면의 개수도 같아야 한다 (×)"],"check":"ok"},
"19":{"tp":"회전체의 단면","key":"원뿔을 회전축을 포함하는 평면으로 자르면 이등변삼각형","sol":["원뿔의 단면은 이등변삼각형이며 정삼각형이라고 할 수 없다","③이 옳지 않다"],"check":"ok"},
"20":{"tp":"사다리꼴 기둥의 겉넓이","key":"밑넓이×2 + 둘레×높이","sol":["밑면: 윗변 $3$, 아랫변 $6$, 높이 $4$인 사다리꼴, 넓이 $18$","겉넓이 $=18\\times 2+(3+6+4+5)\\times 7=36+126=162\\,(\\text{cm}^2)$"],"check":"ok"},
"21":{"tp":"우유갑의 부피","key":"우유 부피 + 빈 부분 부피","sol":["우유: $5\\times5\\times4=100$","빈 부분: $5\\times5\\times7=175$","전체 $=275\\,(\\text{cm}^3)$"],"check":"ok"},
"22":{"tp":"원뿔 전개도의 중심각","key":"호의 길이 = 밑면 둘레","sol":["$2\\pi\\times9\\times\\dfrac{x}{360}=2\\pi\\times3$","$x=120$"],"check":"ok"},
"23":{"tp":"원뿔대의 겉넓이","key":"큰 원뿔 옆넓이 − 작은 원뿔 옆넓이 + 두 밑면","sol":["두 밑면: $9\\pi+36\\pi=45\\pi$","옆넓이: $\\pi\\times6\\times12-\\pi\\times3\\times6=54\\pi$","겉넓이 $=99\\pi\\,(\\text{cm}^2)$"],"check":"ok"},
"24":{"tp":"구의 부피","key":"구 부피의 $\\dfrac18$","sol":["$\\dfrac{4}{3}\\pi\\times3^3\\times\\dfrac{1}{8}=\\dfrac{9}{2}\\pi\\,(\\text{cm}^3)$"],"check":"ok"}
}
