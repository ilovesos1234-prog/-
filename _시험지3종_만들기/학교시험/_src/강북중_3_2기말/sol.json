{
"1":{"tp":"직각삼각형의 삼각비","key":"sin A = (A의 대변)/(빗변)","sol":["$\\sin A=\\dfrac{\\overline{BC}}{\\overline{AC}}=\\dfrac{4}{5}$"],"check":"ok"},
"2":{"tp":"닮은 직각삼각형과 삼각비","key":"$\\angle BDE=\\angle A$ (두 직각삼각형의 닮음)","sol":["$\\overline{BC}=\\sqrt{15-5}=\\sqrt{10}$","$\\triangle DBE\\sim\\triangle ABC$ 이므로 $\\angle x=\\angle BAC$","$\\tan x=\\dfrac{\\overline{BC}}{\\overline{AC}}=\\dfrac{\\sqrt{10}}{\\sqrt{5}}=\\sqrt{2}$"],"check":"ok"},
"3":{"tp":"특수각의 삼각비 계산","key":"0°, 30°, 45°, 60°, 90°의 삼각비 값","sol":["① $\\dfrac{\\sqrt{3}}{2}-0=\\dfrac{\\sqrt{3}}{2}$ ② $1+1=2$","③ $\\dfrac{\\sqrt{2}}{2}\\times\\dfrac{\\sqrt{3}}{3}=\\dfrac{\\sqrt{6}}{6}$","④ $0-\\dfrac{\\sqrt{3}}{2}\\times 0=0$ (옳다)","⑤ $\\dfrac{1}{2}\\times\\dfrac{1}{2}+\\sqrt{3}=\\dfrac{1}{4}+\\sqrt{3}$"],"check":"ok"},
"4":{"tp":"사분원에서 삼각비의 값","key":"반지름 1인 사분원에서 sin은 y좌표, cos는 x좌표","sol":["$\\sin 35^\\circ=0.57$, $\\cos 35^\\circ=0.82$","$\\sin 35^\\circ+\\cos 35^\\circ=1.39$"],"check":"ok"},
"5":{"tp":"두 변과 끼인각으로 넓이","key":"넓이 = (1/2)ab sin C","sol":["$\\dfrac{1}{2}\\times\\overline{AB}\\times 4\\times\\sin 60^\\circ=\\sqrt{3}\\,\\overline{AB}=5\\sqrt{3}$","$\\overline{AB}=5$"],"check":"ok"},
"6":{"tp":"수선을 그어 거리 구하기","key":"C에서 AB에 수선을 내려 두 직각삼각형으로 나눈다","sol":["$\\angle A=180^\\circ-45^\\circ-105^\\circ=30^\\circ$","C에서 $\\overline{AB}$에 내린 수선의 발을 H라 하면 $\\overline{CH}=6\\sin 45^\\circ=3\\sqrt{2}$","$\\overline{AC}=\\dfrac{\\overline{CH}}{\\sin 30^\\circ}=6\\sqrt{2}\\,(\\text{km})$"],"check":"ok"},
"7":{"tp":"등변사다리꼴의 넓이","key":"높이 = 8 sin 60°","sol":["높이 $=8\\sin 60^\\circ=4\\sqrt{3}$, 밑변 양쪽 돌출 길이 $=8\\cos 60^\\circ=4$","$\\overline{BC}=5+4+4=13$","넓이 $=\\dfrac{1}{2}(5+13)\\times 4\\sqrt{3}=36\\sqrt{3}$"],"check":"ok"},
"8":{"tp":"맞꼭지각과 삼각비","key":"∠CMP = x (맞꼭지각), BM = MC = a로 놓기","sol":["$\\cos x=\\dfrac{1}{3}$, $\\overline{BM}=\\overline{MC}=a$라 하면 $\\overline{AM}=\\dfrac{a}{\\cos x}=3a$","$\\angle CMP=x$ 이므로 $\\overline{CP}=a\\sin x=\\dfrac{2\\sqrt{2}}{3}a$, $\\overline{MP}=a\\cos x=\\dfrac{a}{3}$","$\\overline{AP}=3a+\\dfrac{a}{3}=\\dfrac{10}{3}a$","$\\tan y=\\dfrac{\\overline{CP}}{\\overline{AP}}=\\dfrac{2\\sqrt{2}}{10}=\\dfrac{\\sqrt{2}}{5}$"],"check":"ok"},
"9":{"tp":"중심에서 같은 거리의 현","key":"중심에서 같은 거리에 있는 현의 길이는 같다 → 정삼각형","sol":["$\\overline{OD}=\\overline{OE}=\\overline{OF}$ 이므로 $\\overline{AB}=\\overline{BC}=\\overline{CA}$","D는 $\\overline{AB}$의 중점이므로 $\\overline{AB}=12$","둘레 $=3\\times 12=36$"],"check":"ok"},
"10":{"tp":"동심원과 현의 수직이등분","key":"중심에서 현까지의 거리 = 정삼각형의 내접원 반지름","sol":["정삼각형의 한 변을 삼등분하므로 $\\overline{BC}=8$","O에서 이 변까지의 거리 $=\\dfrac{24}{2\\sqrt{3}}=4\\sqrt{3}$","작은 원의 반지름 $r=\\sqrt{(4\\sqrt{3})^2+4^2}=8$","둘레 $=2\\pi\\times 8=16\\pi$"],"check":"ok"},
"11":{"tp":"외접사각형과 접선의 길이","key":"한 점에서 그은 두 접선의 길이는 같다","sol":["$\\overline{AS}=8$, $\\overline{SD}=\\overline{DR}=4$","$\\overline{RC}=\\overline{CQ}=12$","$\\overline{BP}=\\overline{BQ}=26-12=14$"],"check":"ok"},
"12":{"tp":"원주각과 중심각","key":"원주각 = 중심각의 1/2","sol":["$\\angle x=\\dfrac{1}{2}\\times 140^\\circ=70^\\circ$"],"check":"ok"},
"13":{"tp":"네 점이 한 원 위에 있을 조건","key":"한 변에 대하여 같은 쪽의 두 각이 같으면 한 원 위","sol":["① $\\angle ACD=90^\\circ-60^\\circ=30^\\circ=\\angle ABD$ → 한 원 위","② $\\angle BDC=180^\\circ-70^\\circ-80^\\circ=30^\\circ=\\angle BAC$ → 한 원 위","③ $\\angle BAC=\\angle BDC=90^\\circ$, ④ $\\angle BAC=\\angle BDC=70^\\circ$ → 한 원 위","⑤ $\\triangle DBC$에서 $\\angle BCD=45^\\circ$, 주어진 각으로 같은 원주각 쌍이 성립하지 않는다 → 답 ⑤"],"check":"⑤번 그림은 그려진 각(∠BDC=70°, ∠DBC=65°, ∠ACD=40°)만으로는 한 원 위에 있지 않음을 엄밀히 판정하기 어렵다. 나머지 넷이 모두 조건을 만족하므로 소거로 ⑤, 학교 답과 일치."},
"14":{"tp":"접선과 현이 이루는 각","key":"∠BAT = ∠BCA, 지름에 대한 원주각 90°","sol":["$\\angle BCA=\\angle BAT=65^\\circ$","$\\angle BAC=90^\\circ$ (지름)","$\\angle x=180^\\circ-90^\\circ-65^\\circ=25^\\circ$"],"check":"ok"},
"15":{"tp":"접선·평행선과 닮음","key":"엇각과 접선-현의 각으로 △ABD∽△ADE","sol":["$\\overline{ED}\\,/\\!/\\,\\overline{TA}$ 이므로 $\\angle AED=\\angle TAE$ (엇각)","접선과 현이 이루는 각: $\\angle TAB=\\angle ADB$","$\\triangle ABD\\sim\\triangle ADE$ (AA) 이므로 $\\overline{AD}^2=\\overline{AB}\\times\\overline{AE}=3\\times 6=18$","$\\overline{AD}=3\\sqrt{2}$"],"check":"ok"},
"16":{"tp":"내접사각형의 대각","key":"대각의 합 180°","sol":["$\\angle x=\\angle D=180^\\circ-\\angle B=180^\\circ-65^\\circ=115^\\circ$"],"check":"ok"},
"17":{"tp":"내각의 비와 특수각","key":"180°를 1:4:7로 나누기","sol":["세 내각은 $15^\\circ, 60^\\circ, 105^\\circ$ 이므로 $A=60^\\circ$","$\\sin A=\\dfrac{\\sqrt{3}}{2}$, $\\cos A=\\dfrac{1}{2}$, $\\tan A=\\sqrt{3}$","$\\sin A\\times\\cos A\\times\\tan A=\\dfrac{\\sqrt{3}}{2}\\times\\dfrac{1}{2}\\times\\sqrt{3}=\\dfrac{3}{4}$"],"check":"ok"},
"18":{"tp":"사분원 속 사다리꼴 넓이","key":"□BDEC = △ADE − △ABC","sol":["$\\overline{AC}=12$, $\\cos a=\\dfrac{5}{6}$ 이므로 $\\sin a=\\dfrac{\\sqrt{11}}{6}$, $\\tan a=\\dfrac{\\sqrt{11}}{5}$","$\\overline{AB}=12\\cos a=10$, $\\overline{BC}=12\\sin a=2\\sqrt{11}$","$\\overline{AD}=12$, $\\overline{DE}=12\\tan a=\\dfrac{12\\sqrt{11}}{5}$","$\\square BDEC=\\dfrac{1}{2}\\times 12\\times\\dfrac{12\\sqrt{11}}{5}-\\dfrac{1}{2}\\times 10\\times 2\\sqrt{11}=\\dfrac{72\\sqrt{11}}{5}-10\\sqrt{11}=\\dfrac{22\\sqrt{11}}{5}$"],"check":"ok"},
"19":{"tp":"직각삼각형의 내접원","key":"BD = BE = r, 피타고라스 정리","sol":["반지름을 $r$이라 하면 $\\overline{AB}=r+6$, $\\overline{BC}=r+9$, $\\overline{AC}=15$","$(r+6)^2+(r+9)^2=15^2$ → $r^2+15r-54=0$ → $(r+18)(r-3)=0$","$r=3$, 둘레 $=2\\pi\\times 3=6\\pi$"],"check":"ok"},
"20":{"tp":"지름과 원주각·중심각","key":"∠ACB = 90° → ∠CAD = 31°, 중심각은 그 2배","sol":["$\\overline{AB}$가 지름이므로 $\\angle ACB=90^\\circ$, 따라서 $\\angle ACP=90^\\circ$","$\\triangle ACP$에서 $\\angle CAP=180^\\circ-90^\\circ-59^\\circ=31^\\circ$","$\\angle x=\\angle COD=2\\angle CAD=62^\\circ$"],"check":"ok"},
"21":{"tp":"내접사각형의 외각","key":"외각 = 내대각, 두 삼각형의 내각의 합","sol":["$\\angle ADC=x$ 라 하면 내접사각형의 외각 $\\angle ABP=x$","$\\triangle QAD$에서 $\\angle QAD=180^\\circ-37^\\circ-x$, 따라서 $\\angle PAB=37^\\circ+x$","$\\triangle PAB$에서 $29^\\circ+(37^\\circ+x)+x=180^\\circ$","$2x=114^\\circ$, $x=57^\\circ$"],"check":"ok"}
}
