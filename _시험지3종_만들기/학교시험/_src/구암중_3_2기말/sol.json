{
"1":{"tp":"한 삼각비로 각과 비 구하기","key":"sin B = 1/2 → ∠B = 30°, ∠A = 60°","sol":["$\\sin B=\\dfrac{1}{2}$ 이므로 $\\angle B=30^\\circ$, $\\angle A=60^\\circ$","① 삼각비는 길이의 비일 뿐 실제 길이를 정하지 않는다 ② $\\overline{AB}:\\overline{BC}=2:\\sqrt{3}$","③ $\\tan 30^\\circ=\\dfrac{\\sqrt{3}}{3}$ (옳다) ④ $\\cos 60^\\circ=\\dfrac{1}{2}$ ⑤ $\\angle A=60^\\circ$"],"check":"ok"},
"2":{"tp":"삼각비의 값의 변화","key":"0°→90°: sin↑, cos↓, tan↑","sol":["각이 커지면 $\\sin$은 커지고 $\\cos$는 작아진다 → ①, ② 틀림","$\\tan$는 계속 커진다 → ③ 옳다","45° 미만에서는 $\\sin\\lt\\cos$ → ④ 틀림, $\\tan$는 1보다 클 수 있다 → ⑤ 틀림"],"check":"ok"},
"3":{"tp":"사분원 속 사각형 넓이","key":"□ABCD = △ODC − △OAB","sol":["$\\overline{OB}=0.80$, $\\overline{AB}=0.60$, $\\overline{OC}=1$, $\\overline{CD}=\\tan 37^\\circ=0.75$","$\\square ABCD=\\dfrac{1}{2}\\times 1\\times 0.75-\\dfrac{1}{2}\\times 0.80\\times 0.60=0.375-0.24=0.135$","반올림하면 $0.14$"],"check":"ok"},
"4":{"tp":"같은 각의 삼각비","key":"∠C = ∠ADE 이므로 tan C = 2","sol":["$\\angle C=\\angle ADE$ 이므로 $\\tan C=2$, 즉 $\\overline{AB}:\\overline{AC}=2:1$","$\\overline{AC}=k$, $\\overline{AB}=2k$ 라 하면 $\\overline{BC}=\\sqrt{5}k$","$\\sin B\\times\\sin C=\\dfrac{1}{\\sqrt{5}}\\times\\dfrac{2}{\\sqrt{5}}=\\dfrac{2}{5}$"],"check":"ok"},
"5":{"tp":"넓이로 sin 구하기","key":"△AEF 넓이 = (1/2)·AE·AF·sin x","sol":["$\\triangle AEF=36-\\triangle ABE-\\triangle ECF-\\triangle AFD=36-9-6-6=15$","$\\overline{AE}=\\sqrt{6^2+3^2}=3\\sqrt{5}$, $\\overline{AF}=\\sqrt{6^2+2^2}=2\\sqrt{10}$","$\\dfrac{1}{2}\\times 3\\sqrt{5}\\times 2\\sqrt{10}\\times\\sin x=15$ → $15\\sqrt{2}\\sin x=15$","$\\sin x=\\dfrac{\\sqrt{2}}{2}$"],"check":"ok"},
"6":{"tp":"평행이동한 두 포물선 사이 넓이","key":"y축 방향 4만큼 평행이동 → 평행사변형처럼 넓이 = 4 × 2","sol":["$y=x^2-4x+4$는 $y=x^2-4x$를 $y$축 방향으로 4만큼 평행이동한 것","$x=0$부터 $x=2$ (꼭짓점 P, Q를 잇는 선분)까지 두 곡선 사이의 세로 길이는 항상 4","넓이 $=4\\times 2=8$"],"check":"ok"},
"7":{"tp":"표준형으로 고쳐 평행이동 읽기","key":"y = −3(x−1)² + 2","sol":["$y=-3x^2+6x-1=-3(x-1)^2+2$","$a=1$, $b=2$ 이므로 $a+b=3$"],"check":"ok"},
"8":{"tp":"이차함수 그래프의 성질","key":"y = 2(x−2)² − 3","sol":["$y=2(x-2)^2-3$: 꼭짓점 $(2,-3)$, 축 $x=2$, 아래로 볼록 → ㄴ, ㄷ 틀림","꼭짓점이 $x$축 아래이므로 $x$축과 두 점에서 만난다 → ㄱ 틀림","$y$절편 5, 두 근이 모두 양수이므로 제1, 2, 4사분면을 지난다 → ㄹ 틀림 (제2사분면을 지남)","ㅁ $(0,5)$ 옳다"],"check":"ok"},
"9":{"tp":"그래프 모양과 계수","key":"위로 볼록(a<0), 축 x>0, y절편>0","sol":["위로 볼록이므로 $a\\lt 0$ → ①, ④, ⑤ 중","축이 $y$축 오른쪽: ①은 축 $x=0$, ④는 축 $x=-4$ → 제외","⑤ $y=-\\dfrac{1}{2}x^2+5x+7$: 축 $x=5\\gt 0$, $y$절편 $7\\gt 0$"],"check":"ok"},
"10":{"tp":"현까지의 거리","key":"길이가 같은 두 현은 중심에서 같은 거리, 반지름 5","sol":["두 현의 길이가 6으로 같으므로 중심에서의 거리도 같다","현의 절반 3, 반지름 5 → 거리 $x=\\sqrt{5^2-3^2}=4$"],"check":"5cm는 중심 O에서 원 위의 점까지의 반지름으로 읽었다."},
"11":{"tp":"내접사각형과 중심각","key":"∠ABC = 180° − 118°, x는 호 ABC 쪽 중심각","sol":["$\\square ABCD$가 원에 내접하므로 $y=\\angle ABC=180^\\circ-118^\\circ=62^\\circ$","$x$는 $\\angle ADC$가 보는 호(B쪽)의 중심각이므로 $x=2\\times 118^\\circ=236^\\circ$","$x-y=236-62=174$"],"check":"ok"},
"12":{"tp":"지름과 원주각, 중심각","key":"∠BAC = 90° → ∠ACE = 42°","sol":["$\\overline{BC}$가 지름이므로 $\\angle BAC=90^\\circ$, 따라서 $\\angle EAC=90^\\circ$","$\\triangle AEC$에서 $\\angle ACD=180^\\circ-90^\\circ-48^\\circ=42^\\circ$","$\\angle AOD=2\\angle ACD=84^\\circ$"],"check":"ok"},
"13":{"tp":"호의 길이와 두 현이 만나는 각","key":"호 AD의 원주각 40°, 호 BC의 원주각 32°","sol":["호 AD의 중심각 $=360^\\circ\\times\\dfrac{2}{9}=80^\\circ$ → 원주각 $40^\\circ$","호 BC는 그 $\\dfrac{4}{5}$ → 원주각 $32^\\circ$","두 현이 만나는 점에서 호 AD, BC를 보는 각 $=40^\\circ+32^\\circ=72^\\circ$","$\\angle x$는 그 이웃각이므로 $180^\\circ-72^\\circ=108^\\circ$"],"check":"ok"},
"14":{"tp":"접선과 현, 이등변삼각형","key":"∠PCB = ∠CAB, ∠ABC = ∠ACB","sol":["$\\angle ABC=\\angle ACB=\\beta$ 라 하면 $\\angle CAB=180^\\circ-2\\beta$","접선과 현: $\\angle PCB=\\angle CAB=180^\\circ-2\\beta$, $\\angle PBC=180^\\circ-\\beta$","$\\triangle PBC$: $39^\\circ+(180^\\circ-2\\beta)+(180^\\circ-\\beta)=180^\\circ$ → $\\beta=73^\\circ$","$\\angle CAB=180^\\circ-146^\\circ=34^\\circ$"],"check":"ok"},
"15":{"tp":"외접사각형과 반지름","key":"AB + CD = AD + BC, ∠A = 90° 이면 AE = r","sol":["$\\overline{AD}=\\overline{AB}+\\overline{CD}-\\overline{BC}=6+13-14=5$","$\\overline{AE}=5-1=4$","$\\angle A=90^\\circ$ 이므로 A와 두 접점, 중심이 정사각형을 이루어 $r=\\overline{AE}=4$","넓이 $=16\\pi$"],"check":"ok"},
"16":{"tp":"두 직각삼각형으로 높이 구하기","key":"EB = 10 sin 50° = 10 cos 40°, BC = 30 cos 25° = 30 sin 65°","sol":["$\\triangle ABE$에서 $\\overline{EB}=10\\sin 50^\\circ=10\\cos 40^\\circ=10\\times 0.77=7.7$","$\\triangle BCD$에서 $\\overline{BC}=30\\cos 25^\\circ=30\\sin 65^\\circ=30\\times 0.91=27.3$","$\\overline{EC}=7.7+27.3=35\\,(\\text{m})$"],"check":"ok"},
"17":{"tp":"내접·외접 정육각형의 넓이","key":"정삼각형 6개, 외접 정육각형의 높이 = 반지름 4","sol":["[2-1] 한 변 4인 정삼각형 6개: $6\\times\\dfrac{1}{2}\\times 4\\times 4\\times\\sin 60^\\circ=24\\sqrt{3}$","[2-2] 외접 정육각형의 한 변을 $2t$라 하면 $\\tan 30^\\circ=\\dfrac{t}{4}$, $t=\\dfrac{4\\sqrt{3}}{3}$","한 변 $=\\dfrac{8\\sqrt{3}}{3}$, 넓이 $=6\\times\\dfrac{1}{2}\\times\\left(\\dfrac{8\\sqrt{3}}{3}\\right)^2\\times\\sin 60^\\circ=32\\sqrt{3}$","[2-3] $32\\sqrt{3}-24\\sqrt{3}=8\\sqrt{3}$"],"check":"ok"},
"18":{"tp":"꼭짓점과 한 점으로 식 구하기","key":"y = a(x−5)² + 16 에 (0, 6) 대입","sol":["꼭짓점 $(5,16)$: $y=a(x-5)^2+16$","$(0,6)$ 대입: $25a+16=6$, $a=-\\dfrac{2}{5}$","$y=-\\dfrac{2}{5}x^2+4x+6$ 이므로 $a+b+c=-\\dfrac{2}{5}+4+6=\\dfrac{48}{5}$"],"check":"ok"},
"19":{"tp":"이등변삼각형의 외접원","key":"A에서 BC에 내린 수선은 중심 O를 지난다","sol":["A에서 $\\overline{BC}$에 내린 수선의 발을 M이라 하면 $\\overline{BM}=12$, 직선 AM은 O를 지난다","$\\triangle OMB$에서 $\\overline{OM}=\\sqrt{15^2-12^2}=9$","그림에서 A는 짧은 호 쪽이므로 $\\overline{AM}=15-9=6$","$\\overline{AB}=\\sqrt{12^2+6^2}=6\\sqrt{5}$, 둘레 $=24+12\\sqrt{5}\\,(\\text{cm})$"],"fix_ans":"$24+12\\sqrt{5}\\text{ cm}$","check":"학교 답안지는 BM=9, OM=12로 계산해 18+6√10 cm라 했으나 BC=24이므로 BM=12, OM=9가 맞다(답안지에도 빨간 펜으로 12를 고친 흔적만 있고 뒤 계산은 그대로). 문제 조건대로 풀면 24+12√5 cm."},
"20":{"tp":"두 접선과 호의 길이의 비","key":"∠PBA = 70° = ∠ACB, 원주각 비 = 호의 비","sol":["$\\overline{PA}=\\overline{PB}$ 이므로 $\\angle PAB=\\angle PBA=70^\\circ$","접선과 현: $\\angle ACB=\\angle PBA=70^\\circ$","호 AC : 호 BC $=1:3$ 이므로 $\\angle ABC=x$, $\\angle BAC=3x$","$70^\\circ+x+3x=180^\\circ$ → $x=27.5^\\circ$"],"check":"ok"}
}
