{
"1":{"tp":"유리수와 소수","key":"유한소수·순환소수는 모두 유리수","sol":["유한소수는 분모가 $10$의 거듭제곱인 분수로 나타낼 수 있으므로 모두 유리수","따라서 ② 유리수가 아닌 유한소수는 없다 ⇒ 옳지 않다"],"check":"ok"},
"2":{"tp":"유한소수 만들기","key":"분모의 소인수 3을 없앤다","sol":["$0.5\\dot{7}=\\frac{57-5}{90}=\\frac{52}{90}=\\frac{26}{45}=\\frac{26}{3^2\\times5}$","$a$는 $9$의 배수 ⇒ 가장 작은 두 자리 수 $a=18$"],"check":"ok"},
"3":{"tp":"유한소수 분수","key":"분모 110=2×5×11 ⇒ 분자가 11의 배수","sol":["$\\frac{1}{11}=\\frac{10}{110}$, $\\frac{7}{10}=\\frac{77}{110}$이므로 $10\\lt n\\lt77$","$n=11,22,33,44,55,66$ ⇒ $\\frac{1}{10},\\frac{1}{5},\\frac{3}{10},\\frac{2}{5},\\frac{1}{2},\\frac{3}{5}$","분자의 합 $1+1+3+2+1+3=11$"],"check":"ok"},
"4":{"tp":"순환소수가 되는 분수","key":"분모의 소인수가 2, 5뿐인 것 제외","sol":["전체 $39$개 중 분모가 $2,4,5,8,10,16,20,25,32,40$인 $10$개는 유한소수","$39-10=29$(개)"],"check":"ok"},
"5":{"tp":"소수점 아래 n번째 숫자","key":"순환마디 6자리","sol":["$\\frac{4}{7}=0.\\dot{5}7142\\dot{8}$","$x_5=2$, $10=6+4$ ⇒ $x_{10}=4$, $15=12+3$ ⇒ $x_{15}=1$","합 $=2+4+1=7$"],"check":"ok"},
"6":{"tp":"유한소수 조건","key":"104=2³×13, 110=2×5×11","sol":["$\\frac{x}{104}$ 유한 ⇒ $x$는 $13$의 배수: $52,65,\\cdots,143$의 $8$개","$\\frac{x}{110}$ 무한 ⇒ $x$는 $11$의 배수가 아님 ⇒ $143$ 제외","$8-1=7$(개)"],"check":"ok"},
"7":{"tp":"지수법칙","key":"빈칸의 지수 각각 구하기","sol":["① $3$ ② $5$ ③ $7$ ④ $4$ ⑤ $6$","가장 큰 것은 ③"],"check":"ok"},
"8":{"tp":"소인수분해와 지수","key":"각 수를 소인수분해해서 지수 더하기","sol":["$2\\times3\\times2^2\\times5\\times(2\\times3)\\times7\\times2^3\\times3^2\\times(2\\times5)=2^8\\times3^4\\times5^2\\times7$","$a+b-c-d=8+4-2-1=9$"],"check":"ok"},
"9":{"tp":"단항식 혼합 계산","key":"식을 간단히 한 뒤 대입","sol":["$8a^2b^3\\div(-8a^3b^3)\\times(-7a^2b)=7ab$","$7\\times(-1)\\times3=-21$"],"check":"ok"},
"10":{"tp":"원기둥 부피 비","key":"V=πr²h","sol":["$\\pi\\left(\\frac{3}{2}r\\right)^2\\times\\frac{2}{3}h=\\frac{9}{4}\\times\\frac{2}{3}\\pi r^2h=\\frac{3}{2}\\pi r^2h$","$n=\\frac{3}{2}$"],"check":"ok"},
"11":{"tp":"다항식의 덧셈·뺄셈","key":"괄호 앞 부호 주의","sol":["⑤ $x^2-5x+6-3x^2-4x+2=-2x^2-9x+8$","따라서 ⑤가 옳지 않다"],"check":"ok"},
"12":{"tp":"다항식÷단항식","key":"가로=넓이÷세로","sol":["$(3x^4y^4-4x^4y^3+x^3y^3)\\times\\frac{2}{x^2y^3}$","$=6x^2y-8x^2+2x$"],"check":"ok"},
"13":{"tp":"부등식으로 나타내기","key":"이상 ≥, 이하 ≤","sol":["ㄱ 최저 $30$ ⇒ $a\\ge30$ (옳음), ㄴ 이하 ⇒ $a\\le3.5$ (옳음)","ㄷ 이상 ⇒ $a\\ge50$, ㄹ 최고 ⇒ $a\\le50$ (틀림)"],"check":"ok"},
"14":{"tp":"부등식의 성질","key":"음수를 곱하면 부등호 방향이 바뀜","sol":["ㄱ 옳음","ㄴ $-a\\gt-b$ ⇒ $-a-3\\gt-b-3$ (틀림)","ㄷ $a\\le b$ ⇒ $-a\\ge-b$ (틀림)","ㄹ $a\\le b$ ⇒ $\\frac{a}{3}-1\\le\\frac{b}{3}-1$ (옳음)"],"check":"ok"},
"15":{"tp":"해를 수직선에","key":"그림은 x<2","sol":["① $x\\lt-\\frac{4}{3}$ ② $x\\gt-2$ ③ $x\\gt2$","④ $3x-3\\gt4x-5$ ⇒ $x\\lt2$ ⑤ $x\\lt4$"],"check":"ok"},
"16":{"tp":"해가 같은 두 부등식","key":"x≤-4와 같아지도록 a, b 관계","sol":["$3(x-3)-2(2x-5)\\ge5$ ⇒ $x\\le-4$","$(a-b)x\\le2a+5b$의 해가 $x\\le-4$ ⇒ $a-b\\gt0$, $2a+5b=-4(a-b)$ ⇒ $b=-6a$, $a\\gt0$","$(a+b)x\\gt\\frac{b}{3}$ ⇒ $-5ax\\gt-2a$ ⇒ $x\\lt\\frac{2}{5}$"],"check":"ok"},
"17":{"tp":"반대 방향 거리","key":"두 사람 거리의 합","sol":["동생 출발 시 언니는 $5\\times\\frac{6}{60}=0.5$(km)","$0.5+\\frac{9x}{60}\\ge3.2$ ⇒ $x\\ge18$","$18$분 후부터"],"check":"ok"},
"18":{"tp":"순환소수 방정식","key":"순환소수를 분수로","sol":["$1.\\dot{5}=\\frac{14}{9}$, $0.\\dot{2}=\\frac{2}{9}$","$\\frac{14}{9}a-\\frac{3}{2}a=\\frac{2}{9}$ ⇒ $\\frac{a}{18}=\\frac{2}{9}$","$a=4$"],"check":"ok"},
"19":{"tp":"저장 용량 지수","key":"512=2⁹, 1024=2¹⁰, 8=2³","sol":["(1) 남은 용량 $2^9\\times\\frac{1}{2}=2^8$(GB)","(2) $2^8\\times2^{10}=2^{18}$(MB)","(3) $2^{18}\\div2^3=2^{15}$(개)"],"check":"ok"},
"20":{"tp":"정육면체 전개도","key":"마주 보는 면 찾기","sol":["$a-4b$와 $-3a+9b$가 마주 봄 ⇒ 합 $-2a+5b$","$A$와 $-3a-2b$가 마주 봄 ⇒ $A=-2a+5b-(-3a-2b)=a+7b$","$B$와 $5a-6b$가 마주 봄 ⇒ $B=-2a+5b-(5a-6b)=-7a+11b$"],"check":"ok"},
"21":{"tp":"자연수 해가 없을 조건","key":"x<k에서 k≤1","sol":["양변에 $10$을 곱하면 $15x+12\\lt12x-36+a$ ⇒ $x\\lt\\frac{a-48}{3}$","자연수 해가 없으려면 $\\frac{a-48}{3}\\le1$ ⇒ $a\\le51$"],"check":"ok"},
"22":{"tp":"사다리꼴 넓이","key":"넓이 ≥ 49","sol":["(1) $(x+9)\\times7\\div2\\ge49$","(2) $x+9\\ge14$ ⇒ $x\\ge5$","(3) 최소 $5$cm"],"check":"ok"}
