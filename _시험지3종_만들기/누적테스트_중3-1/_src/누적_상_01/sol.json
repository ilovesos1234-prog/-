{
"1":{"tp":"제곱근의 뜻과 성질","key":"양수의 제곱근은 ±두 개, 제곱근 a는 √a","sol":["ㄷ: $16$의 제곱근은 $\\pm 4$","ㄹ: $\\sqrt{64}=8$ 의 제곱근은 $\\pm 2\\sqrt{2}$","ㅇ: $-3\\lt -\\sqrt{5}\\lt -2$, $3\\lt\\sqrt{10}\\lt 4$","사이의 정수는 $-2,-1,0,1,2,3$ 의 $6$개","옳지 않은 것: ㄷ, ㄹ, ㅇ"],"check":"ok"},
"2":{"tp":"제곱근의 근삿값","key":"20 = 1.25 × 16 으로 바꾼다","sol":["$\\sqrt{20}=\\sqrt{1.25\\times 16}=4\\sqrt{1.25}$","$=4\\times 1.12=4.48$"],"fix_ans":"$4.48$","check":"주어진 $\\sqrt{1.25}=1.12$ 로 계산하면 $4\\times1.12=4.48$ 이다. 출판사 답 4.46은 맞지 않는다 (참값 $\\sqrt{20}\\approx4.472$ 도 4.47)."},
"3":{"tp":"제곱근 구하기","key":"제곱근 a = √a, a의 제곱근 = ±√a","sol":["$x=\\sqrt{16}=4$","$\\sqrt{81}=9$ 의 양의 제곱근 $y=3$","$(-7)^2=49$ 의 음의 제곱근 $z=-7$","$xy+z=12-7=5$"],"check":"ok"},
"4":{"tp":"닮음과 무리수 (황금나선)","key":"닮은 사각형의 변의 비로 이차방정식","sol":["$\\overline{CF}=x$ 라 하면 $4:(4+x)=x:4$","$x^2+4x-16=0$, $x=-2+2\\sqrt{5}$","(1) $\\overline{CF}=2\\sqrt{5}-2$","(2) $\\overline{EJ}=4-x=6-2\\sqrt{5}$","(3) $\\overset{\\frown}{AC}=\\frac{1}{4}\\cdot2\\pi\\cdot4=2\\pi$","$\\overset{\\frown}{CJ}=(\\sqrt{5}-1)\\pi$, $\\overset{\\frown}{JG}=(3-\\sqrt{5})\\pi$","(4) 합 $=4\\pi$"],"check":"ok"},
"5":{"tp":"제곱근의 성질","key":"√a² = |a|, √(a×100)=10√a","sol":["ㄱ: $\\sqrt{49}=7$ (±가 아님)","ㄴ: $\\sqrt{(-4)^2}=4$ 의 제곱근은 $\\pm 2$","ㄷ: $0.1\\gt 0.01$ 이므로 옳다","ㄹ: $\\sqrt{200}=10\\sqrt{2}$, $10$배","옳지 않은 것: ㄱ, ㄴ, ㄹ"],"check":"ok"},
"6":{"tp":"제곱근표에 없는 수","key":"소수점을 두 자리씩 옮긴다","sol":["$\\sqrt{589}=\\sqrt{5.89\\times100}=10a$","$\\sqrt{0.00589}=\\sqrt{\\frac{58.9}{10000}}=\\frac{b}{100}$","$10a+\\frac{b}{100}$ → ②"],"check":"ok"},
"7":{"tp":"홀수의 합과 제곱근","key":"1부터 n개 홀수의 합은 n²","sol":["$57=2\\times29-1$ 이므로 $29$개","$1+3+\\cdots+57=29^2$","$\\sqrt{29^2}=29$ → ④"],"check":"ok"},
"8":{"tp":"정오각형 대각선","key":"△ABF ∽ △ACB, AF·AC = AB²","sol":["$\\overline{AC}=x$, $\\overline{CF}=\\overline{CB}=6$, $\\overline{AF}=x-6$","$\\triangle ABF\\sim\\triangle ACB$ 에서 $6^2=x(x-6)$","$x^2-6x-36=0$, $x=3+3\\sqrt{5}$ → ④"],"check":"ok"},
"9":{"tp":"제곱근의 뜻","key":"양수의 제곱근은 2개, 0은 1개, 음수는 없음","sol":["① $0$의 제곱근은 $0$","② 제곱근 $4$는 $2$","③ 양수의 제곱근은 $2$개","⑤ 음수의 제곱근은 없다","④ $6^2=36$ 이므로 옳다"],"check":"ok"},
"10":{"tp":"직각이등변삼각형의 빗변","key":"넓이 S이면 빗변² = 4S","sol":["다리 $a$ 일 때 넓이 $\\frac{a^2}{2}$, 빗변 $\\sqrt{2}a$","빗변$^2=4\\times$넓이","$\\overline{AC}=\\sqrt{16}=4$, $\\overline{CE}=\\sqrt{32}=4\\sqrt{2}$, $\\overline{EG}=\\sqrt{36}=6$","$\\overline{AG}=(10+4\\sqrt{2})\\,\\mathrm{cm}$"],"check":"ok"},
"11":{"tp":"√A² 꼴 간단히","key":"부호를 판단하여 절댓값을 푼다","sol":["$-1\\lt a\\lt 2$ 이면 $a^2\\lt 4$, $a^2-4\\lt 0$","$a^2-2a+1=(a-1)^2\\ge 0$","$(4-a^2)+(a^2-2a+1)=-2a+5$ → ①"],"check":"ok"},
"12":{"tp":"곱셈공식 변형","key":"(x−y)² = (x+y)² − 4xy","sol":["$(x-y)^2=36-4\\times(-3)=48$","$\\sqrt{48}=4\\sqrt{3}$"],"check":"ok"},
"13":{"tp":"구간별 근호 간단히","key":"A = |x+1| − |2x−1|","sol":["$A=|x+1|-|2x-1|$","ㄱ: $-(x+1)-(1-2x)=x-2$ (○)","ㄴ: $(x+1)-(1-2x)=3x$ (×)","ㄷ: $(x+1)-(2x-1)=-x+2$ (○)","ㄱ, ㄷ → ③"],"check":"ok"},
"14":{"tp":"부호 판단 후 간단히","key":"x−y>0, y+1>0","sol":["$(-\\sqrt{-x})^2=-x$","$x-y\\gt 0$ 이므로 $\\sqrt{(x-y)^2}=x-y$","$-y-1\\lt 0$ 이므로 $\\sqrt{(-y-1)^2}=y+1$","$-x+x-y+y+1=1$"],"check":"17번과 같은 문제(같은 출처)"},
"15":{"tp":"완전제곱식 꼴 근호","key":"√(x∓1/7)² = |x∓1/7|","sol":["$\\sqrt{(x-\\frac{1}{7})^2}-\\sqrt{(x+\\frac{1}{7})^2}$","$=(\\frac{1}{7}-x)-(x+\\frac{1}{7})=-2x$ → ②"],"check":"ok"},
"16":{"tp":"완전제곱식 꼴 근호","key":"√(2a∓1)² = |2a∓1|","sol":["$|2a-1|-|2a+1|$","$=(1-2a)-(2a+1)=-4a$ → ③"],"check":"ok"},
"17":{"tp":"부호 판단 후 간단히","key":"x−y>0, y+1>0","sol":["$(-\\sqrt{-x})^2=-x$","$\\sqrt{(x-y)^2}=x-y$","$\\sqrt{(-y-1)^2}=y+1$","$-x+(x-y)+(y+1)=1$"],"check":"14번과 같은 문제(같은 출처)"},
"18":{"tp":"대소 관계와 근호","key":"a<c<b, abc<0 → a<0<c<b","sol":["$a\\lt b$, $c\\lt b$, $a\\lt c$ → $a\\lt c\\lt b$","양수가 있고 $abc\\lt0$ → $a\\lt 0\\lt c\\lt b$","$-2a+b\\gt 0$, $a-3c\\lt 0$","$(-2a+b)+(3c-a)=-3a+b+3c$"],"check":"ok"},
"19":{"tp":"경우 나누어 간단히","key":"a, b와 1의 대소로 나눈다","sol":["$|a-\\frac1a|-(b-a)+|b-\\frac1b|$","$0\\lt a\\lt b\\lt 1$: $\\frac1a-a-b+a+\\frac1b-b=\\frac1a+\\frac1b-2b$","$0\\lt a\\lt 1\\lt b$: $\\frac1a-a-b+a+b-\\frac1b=\\frac1a-\\frac1b$","$1\\lt a\\lt b$: $a-\\frac1a-b+a+b-\\frac1b=2a-\\frac1a-\\frac1b$"],"check":"ok"},
"20":{"tp":"완전제곱식 꼴 근호","key":"√(a−3)² , √(2a−1)²","sol":["$-|a-3|-|2a-1|$","$=-(3-a)-(2a-1)=-a-2$"],"check":"ok"}
