{
"1":{"tp":"합차 공식으로 수의 계산","key":"$105=100+5,\\ 95=100-5$","sol":["$105\\times95=(100+5)(100-5)$","$=100^2-5^2=9975$","(가) $100$, (나) $-5$"],"check":"ok"},
"2":{"tp":"공통인수 찾기","key":"각각 인수분해","sol":["$x^2+x-12=(x+4)(x-3)$","$3x^2-11x+6=(3x-2)(x-3)$","공통인수: $x-3$"],"check":"ok"},
"3":{"tp":"인수분해로 수의 계산","key":"$a^2-b^2=(a+b)(a-b)$","sol":["$(2.05+1.95)(2.05-1.95)$","$=4\\times0.1=0.4$"],"check":"ok"},
"4":{"tp":"한 근이 주어진 이차방정식","key":"$x=-1$ 대입하여 $a$ 구하기","sol":["$2-a-3=0,\\ a=-1$","$2x^2-x-3=0$","$(2x-3)(x+1)=0$","다른 한 근 $x=\\frac32$"],"check":"ok"},
"5":{"tp":"중근 조건","key":"$(x+3)(x+a)-b=(x+1)^2$","sol":["$x^2+(3+a)x+3a-b=x^2+2x+1$","$3+a=2,\\ a=-1$","$3a-b=1,\\ b=-4$","$a+b=-5$"],"check":"ok"},
"6":{"tp":"제곱근을 이용한 풀이","key":"부등식의 해와 비교","sol":["$(x-4)^2=2,\\ x=4\\pm\\sqrt2$","$x+9\\lt5x-7 \\Rightarrow x\\gt4$","$x=4+\\sqrt2$"],"check":"ok"},
"7":{"tp":"완전제곱식 꼴","key":"$(x+4)^2=19-a$","sol":["$x^2+8x+16=19-a$","$(x+4)^2=19-a$","$19-a=15,\\ a=4$"],"check":"ok"},
"8":{"tp":"근을 대입한 식의 값","key":"양변을 $a$ 로 나누기","sol":["$a^2+4a-1=0$","$a+4-\\frac1a=0,\\ a-\\frac1a=-4$","$a^2+\\frac1{a^2}=(-4)^2+2=18$"],"check":"ok"},
"9":{"tp":"계수를 바꾸어 푼 방정식","key":"바꾼 식에 $x=-3$ 대입","sol":["바꾼 식: $x^2+5x-2a=0$","$9-15-2a=0,\\ a=-3$","처음 식: $x^2+6x+5=0$","$(x+1)(x+5)=0$","$x=-1$ 또는 $x=-5$"],"check":"ok"},
"10":{"tp":"대각선의 개수","key":"$\\frac{n(n-3)}2=20$","sol":["$n^2-3n-40=0$","$(n-8)(n+5)=0$","$n=8$, 정팔각형"],"check":"ok"},
"11":{"tp":"나이 문제","key":"동수 $x$ 살, 형 $x+3$ 살","sol":["$x^2=8(x+3)+41$","$x^2-8x-65=0$","$(x-13)(x+5)=0$","$x=13$"],"check":"ok"},
"12":{"tp":"도형의 넓이 활용","key":"한 변 $x$ $(x\\gt2)$","sol":["$(x+2)^2=9(x-2)^2$","$x+2=3(x-2)$","$x=4$"],"check":"ok"},
"13":{"tp":"나누어 주기 문제","key":"학생 수 $x$, 1인당 $x-17$","sol":["$x(x-17)=60$","$x^2-17x-60=0$","$(x-20)(x+3)=0$","$x=20$"],"check":"ok"},
"14":{"tp":"반원의 넓이 활용","key":"$t$ 초 후 $\\overline{\\mathrm{OP}}=2t$","sol":["$\\overline{\\mathrm{AP}}=10+2t,\\ \\overline{\\mathrm{PB}}=10-2t$","넓이 $=\\frac{\\pi}{8}\\{400-(10+2t)^2-(10-2t)^2\\}$","$=\\frac{\\pi}{8}(200-8t^2)=25\\pi-\\pi t^2$","$25\\pi-\\pi t^2=\\frac{75}{4}\\pi$","$t^2=\\frac{25}4,\\ t=\\frac52$"],"check":"ok"},
"15":{"tp":"길 문제","key":"세로 $x$, 가로 $2x$, 산책로 넓이 $2x$","sol":["$2x\\cdot x-2x=60$","$x^2-x-30=0$","$(x-6)(x+5)=0$","$x=6$"],"check":"ok"},
"16":{"tp":"달력 문제","key":"위아래 날짜 차는 $7$","sol":["$x(x+7)=494$","$x^2+7x-494=0$","$(x-19)(x+26)=0,\\ x=19$","$19+26=45$"],"check":"ok"},
"17":{"tp":"연속하는 자연수","key":"$x-1,\\ x,\\ x+1$","sol":["$(x+1)^2=(x-1)^2+x^2-21$","$x^2-4x-21=0$","$(x-7)(x+3)=0,\\ x=7$","$6+7+8=21$"],"check":"ok"},
"18":{"tp":"근을 대입한 식의 값","key":"$m^2-4m=6$","sol":["$m^2-4m-6=0$","$m^2-4m=6$","$m^2-4m+3=9$"],"check":"ok"},
"19":{"tp":"쏘아 올린 물체","key":"높이 식 $=55$","sol":["$40+20x-5x^2=55$","$x^2-4x+3=0$","$(x-1)(x-3)=0$","$1$ 초 후 또는 $3$ 초 후"],"check":"ok"},
"20":{"tp":"닮은 정삼각형","key":"넓이비 $1:4$ → 변 길이비 $1:2$","sol":["작은 변 $a$, 큰 변 $2a$","$3a+6a=18$","$a=2$"],"check":"ok"}
