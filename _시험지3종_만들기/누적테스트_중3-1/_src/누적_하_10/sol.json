{
"1":{"tp":"제곱근의 성질","key":"$a\\lt0$ 이면 $a=-\\sqrt{a^2}$","sol":["$a\\sqrt{\\frac ba}=-\\sqrt{a^2\\times\\frac ba}=-\\sqrt{ab}=-10$","$b\\sqrt{\\frac ab}=-\\sqrt{b^2\\times\\frac ab}=-\\sqrt{ab}=-10$","합 $=-20$"],"check":"ok"},
"2":{"tp":"제곱근의 성질","key":"$\\sqrt{a^2}=|a|,\\ (\\sqrt a)^2=a$","sol":["$a=9-11=-2$","$b=5\\times\\frac35=3$","$a-b=-5$"],"check":"ok"},
"3":{"tp":"곱셈 공식","key":"$x$ 의 계수만 비교","sol":["$(x+a)^2=x^2+2ax+a^2$","$(x-4)(x+3)=x^2-x-12$","$x$ 의 계수: $2a+1=9$","$a=4$"],"check":"ok"},
"4":{"tp":"인수분해를 이용한 수의 계산","key":"합차, 완전제곱","sol":["$97^2-9=(97+3)(97-3)=9400$","$25^2-250+25=625-250+25=400$","$9400-400=9000$"],"check":"ok"},
"5":{"tp":"인수분해 공식","key":"전개하여 계수 비교","sol":["$(3x+by)(cx+4y)=3cx^2+(12+bc)xy+4by^2$","$3c=3$ 이므로 $c=1$, $4b=8$ 이므로 $b=2$","$12+bc=14=a+12$, $a=2$","$3a+2b-c=6+4-1=9$"],"check":"ok"},
"6":{"tp":"전개 후 인수분해","key":"전개하여 정리","sol":["$x^2+2x-8-16=x^2+2x-24$","$=(x+6)(x-4)$","합 $=2x+2$"],"check":"ok"},
"7":{"tp":"인수분해의 도형 활용","key":"정사각형 한 변을 차례로 구하기","sol":["$\\overline{\\mathrm{AE}}=b$, $\\overline{\\mathrm{ED}}=a-b$","$\\overline{\\mathrm{JC}}=b-(a-b)=2b-a=\\overline{\\mathrm{HJ}}$","$\\overline{\\mathrm{FH}}=(a-b)-(2b-a)=2a-3b=\\overline{\\mathrm{GI}}$","$(2b-a)^2-(2a-3b)^2$","$=(5b-3a)(a-b)=-(a-b)(3a-5b)$"],"check":"ok"},
"8":{"tp":"다항식의 곱셈 도형 활용","key":"방의 한 변 $a$","sol":["방: 한 변 $a$, 화장실: 한 변 $b-a$","현관: 가로 $a-(b-a)=2a-b$, 세로 $b-a$","$(2a-b)(b-a)$","$=-2a^2+3ab-b^2$"],"check":"ok"},
"9":{"tp":"복잡한 식의 인수분해","key":"항을 묶어 공통인수","sol":["$x(x+y)-(x+y)=(x+y)(x-1)$","$(x+y)(x-y)-(x+y)=(x+y)(x-y-1)$","$(x+y)(x-2y)+z(x+y)=(x+y)(x-2y+z)$","공통인수 $x+y$"],"check":"ok"},
"10":{"tp":"이차방정식의 뜻","key":"(이차식)$=0$ 꼴인지","sol":["② $x^2+3x+2$ 는 등식이 아님","④ $-x^2-2x+1=0$ 은 이차방정식"],"check":"ok"},
"11":{"tp":"이차방정식의 해","key":"$x=-2$ 대입","sol":["① $(-2+2)^2=0$ ○","② $49\\neq7$, ③ $6\\neq0$","④ $2\\neq0$, ⑤ $0\\neq3$"],"check":"ok"},
"12":{"tp":"이차방정식의 해","key":"대입하여 확인","sol":["① $8\\neq0$","② $27-30=-3$ ○","③ $12\\neq0$, ④ $3\\neq15$, ⑤ $-6\\neq0$"],"check":"ok"},
"13":{"tp":"한 근이 주어진 이차방정식","key":"근을 대입","sol":["$16-4a+a-7=0$","$9-3a=0$","$a=3$"],"check":"ok"},
"14":{"tp":"인수분해를 이용한 풀이","key":"공통인 근","sol":["$2(x-7)(x+1)=0$: $x=7,\\ -1$","$(3x+2)(x+1)=0$: $x=-\\frac23,\\ -1$","공통 $x=-1$"],"check":"ok"},
"15":{"tp":"인수분해를 이용한 풀이","key":"큰 근 대입","sol":["$(x-6)(x+4)=0$, 큰 근 $6$","$36-6a-6=0$","$a=5$"],"check":"ok"},
"16":{"tp":"중근","key":"$2(x+1)^2=0$","sol":["$2(x+1)^2=2x^2+4x+2$","$a=4,\\ b=2$","$ab=8$"],"check":"ok"},
"17":{"tp":"중근","key":"$(x+5)^2=0$","sol":["$x^2+10x+25=0$","$a=10,\\ b=25$","$\\frac ba=\\frac52$"],"check":"ok"},
"18":{"tp":"중근을 가질 조건","key":"$k=\\left(\\frac{-8}{2}\\right)^2$","sol":["$k=(-4)^2=16$"],"check":"ok"},
"19":{"tp":"인수분해를 이용한 풀이","key":"정리 후 인수분해","sol":["$3x^2+5x-2=0$","$(3x-1)(x+2)=0$","$a=\\frac13,\\ b=-2$","$3a+b=1-2=-1$"],"check":"ok"},
"20":{"tp":"인수분해를 이용한 풀이","key":"곱 $24$, 합 $11$","sol":["$(x+3)(x+8)=0$","$x=-3$ 또는 $x=-8$"],"check":"ok"}
