{
"1":{"tp":"제곱근의 뜻","key":"양수의 제곱근은 ±2개, 0의 제곱근은 0","sol":["① $0$ 의 제곱근은 $0$ (×)","② 제곱근 $169=\\sqrt{169}=13$ (×)","③ $\\sqrt{16}=4$ 의 제곱근은 $\\pm 2$ (○)","④ $0$ 은 $1$ 개, 음수는 없음 (×)","⑤ $25$ 의 음의 제곱근은 $-5$ (×)"],"check":"ok"},
"2":{"tp":"제곱근의 뜻","key":"음수의 제곱근은 없다","sol":["① $144$ 의 제곱근은 $\\pm 12$ (×)","② 양수 $a$ 의 제곱근은 $\\pm\\sqrt{a}$ (×)","③ $0$ 은 $1$ 개, 음수는 없음 (×)","④ $\\sqrt{81}=9$ 의 음의 제곱근은 $-3$ (×)","⑤ 제곱하여 음수가 되는 수는 없다 (○)"],"check":"ok"},
"3":{"tp":"제곱근 구하기","key":"√16=4, (−5)²=25","sol":["$\\sqrt{16}=4$ 의 음의 제곱근 $A=-2$","$(-5)^2=25$ 의 양의 제곱근 $B=5$","$A+B=-2+5=3$"],"check":"ok"},
"4":{"tp":"제곱근 구하기","key":"√81=9, (−7)²=49","sol":["$\\sqrt{81}=9$ 의 음의 제곱근 $a=-3$","$(-7)^2=49$ 의 양의 제곱근 $b=7$","$a+b=4$"],"check":"ok"},
"5":{"tp":"수직선 위의 무리수","key":"빗변의 길이를 반지름으로 옮긴다","sol":["(1) $\\overline{AB}=\\sqrt{2^2+1^2}=\\sqrt{5}$, $\\overline{DF}=\\sqrt{1^2+2^2}=\\sqrt{5}$","$\\mathrm{B}(-3)$ 에서 왼쪽으로: $p=-3-\\sqrt{5}$","$\\mathrm{F}(2)$ 에서 오른쪽으로: $q=2+\\sqrt{5}$","(2) $p+3=-\\sqrt{5}$ 이므로 $(p+3)^2=5$","$p^2+6p+10=(p+3)^2+1=5+1=6$"],"check":"ok"},
"6":{"tp":"넓이와 제곱근","key":"정사각형 한 변 = √(넓이)","sol":["전체 한 변 $\\sqrt{80}=4\\sqrt{5}$, 방 A 한 변 $\\sqrt{20}=2\\sqrt{5}$","방 B 가로 $2\\sqrt{5}$, 세로 $\\dfrac{15}{2\\sqrt{5}}=\\dfrac{3\\sqrt{5}}{2}$","욕실 세로 $=4\\sqrt{5}-2\\sqrt{5}-\\dfrac{3\\sqrt{5}}{2}=\\dfrac{\\sqrt{5}}{2}$"],"check":"ok"},
"7":{"tp":"제곱근의 뜻","key":"음수의 제곱근은 없다","sol":["① 제곱근 $0.36=\\sqrt{0.36}=0.6$ (○)","②③④ 옳다","⑤ 음수의 제곱근은 없다 (×)"],"check":"ok"},
"8":{"tp":"부호 판단 후 근호 벗기기","key":"ab>0, a+b<0 이면 a<0, b<0","sol":["$a\\lt 0,\\ b\\lt 0$, $-a-b\\gt 0$","$\\sqrt{a^2}=-a$, $\\sqrt{(-a-b)^2}=-a-b$, $\\sqrt{b^2}=-b$","$(-a)-(-a-b)-(-b)=2b$"],"check":"ok"},
"9":{"tp":"근호 없이 나타내기","key":"제곱수인지 확인","sol":["$\\dfrac{25}{4}\\to\\pm\\dfrac{5}{2}$ (○), $24$ (×)","$1.44\\to\\pm 1.2$ (○)","$\\sqrt{\\dfrac{1}{10000}}=\\dfrac{1}{100}\\to\\pm\\dfrac{1}{10}$ (○)","$\\sqrt{1.9}$ (×) → $3$ 개"],"check":"ok"},
"10":{"tp":"제곱근의 성질","key":"√(a²)=|a|","sol":["ㄱ. $a\\lt 0$ 이면 $\\sqrt{a^2b}=-a\\sqrt{b}$ (×)","ㄴ. 옳다 (○)","ㄷ. $\\sqrt{25}=5$ 의 제곱근 $\\pm\\sqrt{5}$ (○)","ㄹ. $0$ 의 제곱근은 $1$ 개 (×)","ㅁ. $0$ 의 제곱근은 $0$ (×) → ㄴ, ㄷ"],"check":"ok"},
"11":{"tp":"√(a−b)² 간단히","key":"√3>1","sol":["$1-\\sqrt{3}\\lt 0$ 이므로 $\\sqrt{(1-\\sqrt{3})^2}=\\sqrt{3}-1$","$\\sqrt{(\\sqrt{3}-1)^2}=\\sqrt{3}-1$","합 $=2\\sqrt{3}-2$"],"check":"ok"},
"12":{"tp":"부호와 근호","key":"b<0 이면 √(4b²)=−2b","sol":["$\\sqrt{a^2}=a$","$\\sqrt{4b^2}=|2b|=-2b$","$a-2b$"],"check":"ok"},
"13":{"tp":"제곱근의 성질","key":"A=8−3=5","sol":["$3+A=8$ 에서 $A=5$","①②④⑤ 모두 $5$","③ $-\\sqrt{5^2}=-5$"],"check":"ok"},
"14":{"tp":"부호와 근호","key":"√((−a)²)=|a|","sol":["$\\sqrt{(-a)^2}=a$","$\\sqrt{b^2}=-b$","$a-(-b)=a+b$"],"check":"ok"},
"15":{"tp":"완전제곱식과 근호","key":"근호 안을 완전제곱식으로","sol":["$\\sqrt{\\left(a-\\dfrac{1}{3}\\right)^2}-\\sqrt{\\left(a+\\dfrac{1}{3}\\right)^2}$","$a-\\dfrac{1}{3}\\lt 0$ 이므로 $=\\left(\\dfrac{1}{3}-a\\right)-\\left(a+\\dfrac{1}{3}\\right)$","$=-2a$"],"check":"ok"},
"16":{"tp":"√(a−b)² 간단히","key":"x+1>0, x−3<0","sol":["$\\sqrt{(x+1)^2}=x+1$","$\\sqrt{(x-3)^2}=3-x$","$(x+1)-(3-x)=2x-2$"],"check":"ok"},
"17":{"tp":"√(a−b)² 간단히","key":"0<a<1 이면 1/a>1>a","sol":["$a+\\dfrac{1}{a}\\gt 0$, $a-\\dfrac{1}{a}\\lt 0$, $1-\\dfrac{1}{a}\\lt 0$","$-\\left(a+\\dfrac{1}{a}\\right)-\\left(\\dfrac{1}{a}-a\\right)+\\left(\\dfrac{1}{a}-1\\right)$","$=-\\dfrac{1}{a}-1$"],"check":"ok"},
"18":{"tp":"√(a−b)² 간단히","key":"x<−2 이면 x−2<0, −x>0","sol":["$\\sqrt{9(x-2)^2}=3(2-x)=6-3x$","$(-\\sqrt{-x})^2=-x$","$\\sqrt{(2-x)^2}=2-x$","$6-3x-x-(2-x)=-3x+4$"],"check":"ok"},
"19":{"tp":"부호 판단 후 근호 벗기기","key":"xy<0, y<x 이면 x>0, y<0","sol":["$x\\gt 0,\\ y\\lt 0$","$\\sqrt{(2x)^2}=2x$, $\\sqrt{(-x)^2}=x$, $(\\sqrt{-2y})^2=-2y$","$2x-x-(-2y)=x+2y$"],"check":"ok"},
"20":{"tp":"√(a−b)² 간단히","key":"2√5=√20>3","sol":["$1+2\\sqrt{5}\\gt 0$, $3-2\\sqrt{5}\\lt 0$","$(1+2\\sqrt{5})-(2\\sqrt{5}-3)$","$=4$"],"check":"ok"}
}
