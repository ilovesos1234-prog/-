{
"1":{"tp":"제곱근의 뜻","key":"x²=a","sol":["$x^2=a$ ($a\\gt 0$)","$x=\\pm\\sqrt{a}$"],"check":"ok"},
"2":{"tp":"제곱근의 뜻과 성질","key":"제곱근 a = √a","sol":["ㄱ. $\\sqrt{49}=7$ (×)  ㄴ. 제곱근 $\\dfrac{36}{49}=\\dfrac{6}{7}$ (×)","ㄷ. $\\sqrt{81}=9$ 의 제곱근 $\\pm 3$ (○)","ㄹ. $2\\sqrt{16}=8=\\sqrt{64}$ (×)","ㅁ. $\\sqrt{a^2}=|a|=9$ → $a=\\pm 9$ (○)","ㅂ. $-\\sqrt{(-x)^2}=-|x|=x$ (×) → $2$ 개"],"check":"ok"},
"3":{"tp":"√(a−b)² 간단히","key":"a>1 이면 a²>a>1>1/a","sol":["$\\dfrac{1}{a}-a\\lt 0$, $a-a^2\\lt 0$, $a^2-\\dfrac{1}{a}\\gt 0$","$\\left(a-\\dfrac{1}{a}\\right)-(a^2-a)+\\left(a^2-\\dfrac{1}{a}\\right)$","$=2a-\\dfrac{2}{a}$"],"check":"ok"},
"4":{"tp":"√(a−b)² 간단히","key":"x−6<0, 3−x<0, −x<0","sol":["$(6-x)+(x-3)+x$","$=x+3$"],"check":"ok"},
"5":{"tp":"√(a/x)가 자연수","key":"160=2⁵×5","sol":["$\\dfrac{160}{x}=\\dfrac{2^5\\times 5}{x}$ 이 제곱수","가장 작은 $x$: $\\dfrac{160}{x}=16$","$x=10$"],"check":"ok"},
"6":{"tp":"√(a−x)가 정수","key":"0도 정수","sol":["$18-a=0,1,4,9,16$","$a=18,17,14,9,2$","합 $=60$"],"check":"ok"},
"7":{"tp":"√(a+x)가 자연수","key":"26보다 큰 제곱수","sol":["$26+x=36$","$x=10$"],"check":"ok"},
"8":{"tp":"실수의 대소","key":"√2≈1.414","sol":["$b=\\sqrt{8}\\lt\\sqrt{9}=3=a$","$c=5-\\sqrt{2}\\approx 3.59\\gt 3$","$b\\lt a\\lt c$"],"check":"ok"},
"9":{"tp":"√n 이하의 자연수","key":"14²=196, 15²=225","sol":["$f(400)$: $\\sqrt{400}=20$ → $20$","$f(200)$: $14\\lt\\sqrt{200}\\lt 15$ → $14$","$20-14=6$"],"check":"ok"},
"10":{"tp":"근호 벗기고 대소 비교","key":"a<0<b<1","sol":["$a\\lt 0\\lt b$, $b\\lt\\sqrt{b}$ → $0\\lt b\\lt 1$","ㄱ $b+1\\in(1,2)$, ㄴ $-|a|=a$, ㄷ $1-b\\in(0,1)$, ㄹ $a-1$","$a-1\\lt a\\lt 1-b\\lt b+1$ → ㄹ-ㄴ-ㄷ-ㄱ"],"check":"ok"},
"11":{"tp":"유리수와 무리수","key":"순환소수는 유리수","sol":["ㄱ. $3-2=1$ 유리수 (○)","ㄴ. 정수도 실수 (×)","ㄷ. 순환소수는 유리수 (×)","ㄹ. (○) → ㄱ, ㄹ"],"check":"ok"},
"12":{"tp":"유리수와 무리수","key":"1.7̇=16/9","sol":["ㄱ. $0.7+\\dfrac{16}{9}$ 유리수","ㄴ. $\\sqrt{3}-(\\text{유리수})$ 무리수","ㄷ. $\\sqrt{\\pi^2}=\\pi$ 무리수","ㄹ. $\\sqrt{\\dfrac{16}{9}}=\\dfrac{4}{3}$ 유리수 → ㄴ, ㄷ"],"check":"ok"},
"13":{"tp":"제곱근표 활용","key":"소수점을 두 자리씩 옮긴다","sol":["$\\sqrt{42300}=\\sqrt{4.23\\times 100^2}=205.7$","$\\sqrt{0.423}=\\sqrt{\\dfrac{42.3}{100}}=0.6504$","$205.7+650.4=856.1$"],"check":"ok"},
"14":{"tp":"실수의 분류","key":"무리수 = 순환하지 않는 무한소수","sol":["① $\\sqrt{0.9}$ 무리수 ② $-\\dfrac{1}{2}$ 유리수","③ $\\sqrt{15}$ 무리수 ④ $2$ 는 실수","⑤ $\\sqrt{5}+1$ 무리수 (○)"],"check":"ok"},
"15":{"tp":"수직선 위의 무리수","key":"정사각형 한 변 = 모눈 빗변","sol":["(1) 왼쪽 한 변 $\\sqrt{2^2+1^2}=\\sqrt{5}$, 중심 $-3$","$a=-3-\\sqrt{5}$, $c=-3+\\sqrt{5}$","오른쪽 한 변 $\\sqrt{1^2+3^2}=\\sqrt{10}$, 중심 $1$","$b=1-\\sqrt{10}$, $d=1+\\sqrt{10}$","(2) $\\dfrac{b}{a}=\\dfrac{(1-\\sqrt{10})(3-\\sqrt{5})}{-4}$, $\\dfrac{d}{c}=\\dfrac{(1+\\sqrt{10})(3+\\sqrt{5})}{-4}$","$\\dfrac{b}{a}-\\dfrac{d}{c}=\\dfrac{2\\sqrt{5}+6\\sqrt{10}}{4}=\\dfrac{\\sqrt{5}+3\\sqrt{10}}{2}$"],"check":"ok"},
"16":{"tp":"수직선 위의 무리수","key":"AB=√(1²+2²)","sol":["$\\overline{AB}=\\sqrt{1^2+2^2}=\\sqrt{5}$","$\\mathrm{B}(1)$ 에서 왼쪽으로 $\\sqrt{5}$","$\\mathrm{P}=1-\\sqrt{5}$"],"check":"ok"},
"17":{"tp":"제곱근과 무리수","key":"음수의 제곱근은 없다","sol":["ㄱ. 순환소수는 유리수 (×)","ㄴ. $25$ 의 제곱근 $\\pm 5$ (○)","ㄷ. 음수의 제곱근은 없다 (×)","ㄹ, ㅁ (○) → ㄴ, ㄹ, ㅁ"],"check":"ok"},
"18":{"tp":"실수의 대소","key":"√3<2","sol":["㉣ $\\dfrac{3}{2}=\\sqrt{\\dfrac{9}{4}}\\gt\\sqrt{2}$ (○)","㉤ $\\sqrt{3}\\lt 2$ 이므로 $\\sqrt{3}+\\sqrt{5}\\lt 2+\\sqrt{5}$ (×)"],"check":"ok"},
"19":{"tp":"수직선 위의 무리수","key":"Q=1−√5 에서 C=1","sol":["$\\overline{CD}=\\sqrt{1^2+2^2}=\\sqrt{5}$, $\\mathrm{Q}=c-\\sqrt{5}$ → $\\mathrm{C}=1$","$\\mathrm{A}=2$, $\\overline{AB}=\\sqrt{3^2+1^2}=\\sqrt{10}$","$\\mathrm{P}=2+\\sqrt{10}$, $a+b=12$"],"check":"ok"},
"20":{"tp":"수직선 위의 무리수","key":"1×2 직사각형의 대각선 √5","sol":["대각선 $\\sqrt{2^2+1^2}=\\sqrt{5}$","$\\mathrm{P}=-1-\\sqrt{5}$, $\\mathrm{Q}=2+\\sqrt{5}$","$\\overline{PQ}=(2+\\sqrt{5})-(-1-\\sqrt{5})=3+2\\sqrt{5}$"],"check":"그림은 가로 2, 세로 1 직사각형(정사각형 2개)이며 문제 원문 그대로 둠"}
