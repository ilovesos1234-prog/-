{
"1":{"tp":"근호의 덧셈과 뺄셈","key":"$\\sqrt{a^2b}=a\\sqrt{b}$ 로 간단히","sol":["$8\\sqrt2-3\\sqrt5-4\\sqrt2+2\\sqrt5$","$=4\\sqrt2-\\sqrt5$","$a=4,\\ b=-1$","$ab=-4$"],"check":"ok"},
"2":{"tp":"합차 공식","key":"$(A+B)(A-B)=A^2-B^2$","sol":["$\\frac{4}{9}a^2-\\frac{9}{25}b^2$","$=\\frac{4}{9}\\times45-\\frac{9}{25}\\times50$","$=20-18=2$"],"check":"ok"},
"3":{"tp":"식의 값","key":"양변을 $x$ 로 나누어 $x-\\frac1x$ 구하기","sol":["$x-4-\\frac1x=0$","$x-\\frac1x=4$","$x^2+\\frac1{x^2}=4^2+2=18$"],"check":"ok"},
"4":{"tp":"공통인수 묶기","key":"$-b+1=-(b-1)$","sol":["$a(b-1)-(b-1)$","$=(a-1)(b-1)$"],"check":"ok"},
"5":{"tp":"인수분해로 수의 계산","key":"$a^2-b^2=(a+b)(a-b)$","sol":["$10(5.6^2-4.4^2)$","$=10(5.6+4.4)(5.6-4.4)$","$=10\\times10\\times1.2=120$"],"check":"ok"},
"6":{"tp":"이차방정식의 뜻","key":"정리하여 $(x$ 에 대한 이차식$)=0$ 꼴인지 확인","sol":["ㄱ: 등식이 아님","ㄷ: $4x+6=0$ (일차)","ㄹ: $x^2-3x-4=-3x \\Rightarrow x^2-4=0$","이차방정식: ㄴ, ㄹ"],"check":"ok"},
"7":{"tp":"이차방정식의 해","key":"$x=2$ 대입 후 인수분해","sol":["$4+2a-12=0,\\ a=4$","$x^2+4x-12=(x+6)(x-2)=0$","$b=-6$","$a+b=-2$"],"check":"ok"},
"8":{"tp":"중근 조건","key":"$(\\frac{-6}{2})^2=$ 상수항","sol":["$k+2=(-3)^2=9$","$k=7$"],"check":"ok"},
"9":{"tp":"인수분해로 풀기","key":"한쪽으로 이항","sol":["$x^2-5x-24=0$","$(x+3)(x-8)=0$","$x=-3$ 또는 $x=8$"],"check":"ok"},
"10":{"tp":"완전제곱식 꼴","key":"양변에 $(\\frac{-10}{2})^2$ 더하기","sol":["$x^2-10x+25=30$","$(x-5)^2=30$","$m=5,\\ n=30$","$\\frac nm=6$"],"check":"ok"},
"11":{"tp":"완전제곱식 꼴","key":"양변에 $9$ 더하기","sol":["$x^2+6x=-1$","$x^2+6x+9=8$","$(x+3)^2=8$","$m+n=3+8=11$"],"check":"ok"},
"12":{"tp":"근의 공식","key":"$x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}$","sol":["$x=\\frac{5\\pm\\sqrt{25-8}}{2}=\\frac{5\\pm\\sqrt{17}}{2}$","$a=5,\\ b=17$","$a+b=22$"],"check":"ok"},
"13":{"tp":"계수가 분수·소수인 방정식","key":"양변에 $10$ 곱하기","sol":["$2x^2+3x-15=0$","$x=\\frac{-3\\pm\\sqrt{9+120}}{4}$","$x=\\frac{-3\\pm\\sqrt{129}}{4}$"],"check":"ok"},
"14":{"tp":"제곱근을 이용한 풀이","key":"$(3x-1)^2=5$","sol":["$3x-1=\\pm\\sqrt5$","$x=\\frac{1\\pm\\sqrt5}{3}$","$a=1,\\ b=5$","$a+b=6$"],"check":"ok"},
"15":{"tp":"제곱근을 이용한 풀이","key":"작은 근 $a-\\sqrt{63}\\gt0$","sol":["$x=a\\pm\\sqrt{63}$","$a\\gt\\sqrt{63}$, $7\\lt\\sqrt{63}\\lt8$","가장 작은 자연수 $a=8$"],"check":"ok"},
"16":{"tp":"잘못 본 이차식","key":"A는 상수항, B는 $x$ 의 계수를 바르게 봄","sol":["A: $x^2+5x+6$ → 상수항 $6$","B: $x^2-5x+4$ → $x$ 의 계수 $-5$","처음 식: $x^2-5x+6$","$=(x-2)(x-3)$"],"check":"ok"},
"17":{"tp":"완전제곱식 조건","key":"상수항 $=(\\frac82)^2$","sol":["$a+9=16,\\ a=7$","$(x+4)^2=0,\\ k=4$","$a+k=11$"],"check":"ok"},
"18":{"tp":"이차방정식이 될 조건","key":"정리 후 $x^2$ 의 계수 $\\ne0$","sol":["$ax^2-3x+2=6x^2+x-2$","$(a-6)x^2-4x+4=0$","$a-6\\ne0$","$a\\ne6$"],"check":"ok"},
"19":{"tp":"완전제곱식으로 풀이","key":"양변에 $1$ 더하기","sol":["$(x-1)^2=\\mathrm{A}+1$","$x=1\\pm\\sqrt{\\mathrm{A}+1}$","$\\mathrm{B}=1,\\ \\mathrm{A}+1=7$","$\\mathrm{A}+\\mathrm{B}=6+1=7$"],"check":"ok"},
"20":{"tp":"두 근으로 방정식 만들기","key":"$a(x-\\alpha)(x-\\beta)=0$","sol":["$2(x+3)(x-2)=0$","$2(x^2+x-6)=0$","$2x^2+2x-12=0$"],"check":"ok"}
