{
"1":{"tp":"부호 판단 후 근호 벗기기","key":"a−b>0, ab<0 이면 a>0, b<0","sol":["$a\\gt 0,\\ b\\lt 0$","$\\sqrt{(-a)^2}=a$, $\\sqrt{(-3b)^2}=-3b$, $\\sqrt{16b^2}=-4b$","$a-(-3b)+(-4b)=a-b$"],"check":"ok"},
"2":{"tp":"a√b 꼴 변형","key":"√63=3√7, 4√2=√32","sol":["$\\sqrt{63}=\\sqrt{9\\times 7}=3\\sqrt{7}$, $a=3$","$4\\sqrt{2}=\\sqrt{16\\times 2}=\\sqrt{32}$, $b=32$","$a+b=35$"],"check":"ok"},
"3":{"tp":"피타고라스와 제곱근","key":"빗변² = 나머지 두 변 제곱의 합","sol":["$x^2+(\\sqrt{3})^2=(2\\sqrt{2})^2$","$x^2=8-3=5$","$x=\\sqrt{5}$"],"check":"ok"},
"4":{"tp":"부호 판단 후 근호 벗기기","key":"a>0, b<0, c<0","sol":["$a\\gt 0,\\ b\\lt 0,\\ c\\lt 0$, $c-a\\lt 0$","$\\sqrt{c^2}=-c$, $\\sqrt{(-b)^2}=-b$, $\\sqrt{(c-a)^2}=a-c$, $(-\\sqrt{a})^2=a$","$-c+b+a-c-a=b-2c$"],"check":"ok"},
"5":{"tp":"√(a−b)² 간단히","key":"a−b>0","sol":["$a-b\\gt 0$","$2(a-b)+3(a-b)$","$=5a-5b$"],"check":"ok"},
"6":{"tp":"부호 판단 후 근호 벗기기","key":"a>0, b<0, b−a<0","sol":["$a\\gt 0,\\ b\\lt 0$","$\\sqrt{(-2a)^2}=2a$, $\\sqrt{(b-a)^2}=a-b$, $\\sqrt{4b^2}=-2b$","$2a-(a-b)-2b=a-b$"],"check":"ok"},
"7":{"tp":"부호 판단 후 근호 벗기기","key":"√(a²)=−a 이면 a<0","sol":["$a\\lt 0,\\ b\\lt 0$, $a+2b\\lt 0$","$\\sqrt{4a^2}=-2a$, $\\sqrt{(a+2b)^2}=-a-2b$, $27\\sqrt{\\dfrac{b^2}{9}}=-9b$","$-2a+a+2b-9b=-a-7b$"],"check":"ok"},
"8":{"tp":"부호 판단 후 근호 벗기기","key":"a>0>b","sol":["$a\\gt 0,\\ b\\lt 0$, $a-2b\\gt 0$","$2a+(-b)-(-3b)+(a-2b)$","$=3a$"],"check":"ok"},
"9":{"tp":"√가 자연수가 될 조건","key":"20x/3 이 제곱수","sol":["$\\dfrac{20x}{3}=\\dfrac{2^2\\times 5\\times x}{3}$ → $x=15k^2$","$m=15$ (k=1), 세 자리: $15\\times 9=135=n$","$\\dfrac{n}{m}=9$"],"check":"ok"},
"10":{"tp":"√가 자연수가 될 조건","key":"12x/5 제곱수 → x=15k²","sol":["$x=15,\\,60,\\cdots$ 중 $85-x$ 가 제곱수","$85-15=70$ (×), $85-60=25$ (○)","$x=60$"],"check":"ok"},
"11":{"tp":"√(a−x)가 자연수","key":"19−x 는 19보다 작은 제곱수","sol":["$19-x=1,4,9,16$","$x=18,15,10,3$","$18-3=15$"],"check":"ok"},
"12":{"tp":"√(a−x)가 자연수","key":"768−64x=64(12−x)","sol":["$\\sqrt{64(12-x)}=8\\sqrt{12-x}$","$12-x$ 가 제곱수, $x$ 최대 → $12-x=1$","$x=11$"],"check":"ok"},
"13":{"tp":"√(a+x)가 자연수","key":"85보다 큰 홀수 제곱수","sol":["$85+2x$ 는 $85$ 보다 큰 홀수인 제곱수","$85+2x=121$","$x=18$"],"check":"ok"},
"14":{"tp":"√(a+x)가 자연수","key":"18보다 큰 짝수 제곱수","sol":["$18+2x$ 는 $18$ 보다 큰 짝수인 제곱수","$18+2x=36$","$x=9$"],"check":"ok"},
"15":{"tp":"제곱근의 대소","key":"근호 안으로 넣어 비교","sol":["$a=\\sqrt{32}$, $b=\\sqrt{28}$, $c=\\sqrt{27}$","$27\\lt 28\\lt 32$","$c\\lt b\\lt a$"],"check":"ok"},
"16":{"tp":"제곱근과 부등식","key":"n² < x ≤ (n+1)²","sol":["(1) $9\\lt x\\le 16$ → $x=10,\\cdots,16$, $f(3)=7$","(2) $n^2\\lt x\\le (n+1)^2$ → $f(n)=(n+1)^2-n^2=2n+1$","(3) $2n+1=23$ → $n=11$"],"check":"ok"},
"17":{"tp":"제곱근과 부등식","key":"4 ≤ b/a < 9","sol":["$4\\le\\dfrac{b}{a}\\lt 9$, $b=20-a$","$a=3,\\ b=17$: $\\dfrac{17}{3}$ (○, 서로소)","$a=1$: $19$ (×), $a=2,4$: 서로소 아님, $a\\ge 5$: $\\dfrac{b}{a}\\le 3$ (×)","$b-2a=17-6=11$"],"check":"ok"},
"18":{"tp":"제곱근과 부등식","key":"각 변을 제곱","sol":["$4\\lt 3x-1\\le 16$","$\\dfrac{5}{3}\\lt x\\le\\dfrac{17}{3}$","$x=2,3,4,5$ → 합 $14$"],"check":"ok"},
"19":{"tp":"근호 벗기고 대소 비교","key":"−3<x<y<0","sol":["ㄱ $3+y$, ㄴ $x-3$, ㄷ $3-x$, ㄹ $y-3$, ㅁ $y$","$x-3\\lt y-3\\lt y\\lt 3+y\\lt 3-x$","ㄴ, ㄹ, ㅁ, ㄱ, ㄷ"],"check":"ok"},
"20":{"tp":"제곱근의 성질 종합","key":"a의 범위에 따라 대소가 다르다","sol":["ㄱ. $a=\\dfrac{1}{4}$ 이면 $\\dfrac{1}{a}=4$ 가 가장 큼 (×)","ㄴ. $-\\sqrt{(-2a)^2}=-2a$ (×)","ㄷ. 두 실수 사이에 무리수는 무수히 많다 (○)","ㄹ. $a=36$ 이면 약수 $9$ 개 (×)","ㅁ. $\\sqrt{a+1}-\\sqrt{a}=\\dfrac{1}{\\sqrt{a+1}+\\sqrt{a}}$, 분모가 작을수록 큼 (○)"],"check":"ok"}
}
