"4":{"tp":"제곱근표 활용","key":"5.229 = 9 × 0.581","sol":["$a=\\sqrt{5.7\\times100}=10\\times2.387=23.87$","$b=\\sqrt{9\\times0.581}=3\\times\\frac{\\sqrt{58.1}}{10}$","$=0.3\\times7.622=2.2866$"],"check":"ok"},
"5":{"tp":"제곱근표 활용 (탈출속도)","key":"근호 안을 계산하여 402","sol":["$\\frac{2GM}{R}=\\frac{2\\times6.7\\times3.6\\times10^{26}}{10^{20}\\times1.2\\times10^5}$","$=2\\times6.7\\times3\\times10=402$","$v=\\sqrt{402}=10\\sqrt{4.02}=10\\times2.005$","$=20.05\\,\\mathrm{km/s}$"],"check":"ok"},
"6":{"tp":"수직선 위의 무리수","key":"정사각형 대각선 √2","sol":["$A=-\\sqrt2$, $B=-1+\\sqrt2$ → $a=2\\sqrt2-1$","$C=2-\\sqrt2$, $D=1+\\sqrt2$ → $b=2\\sqrt2-1$","$c=2+\\sqrt2$","$a+b+c=5\\sqrt2$"],"check":"ok"},
"7":{"tp":"두 무리수 사이 무리수 개수","key":"√111 ~ √219 중 제곱수 제외","sol":["$\\sqrt{111},\\cdots,\\sqrt{219}$: $109$개","제곱수 $121,144,169,196$ 제외","$109-4=105$"],"check":"ok"},
"8":{"tp":"인수분해와 곱의 소거","key":"1−1/k² = (k−1)(k+1)/k²","sol":["$\\frac{2\\cdot4}{3\\cdot3}\\times\\frac{3\\cdot5}{4\\cdot4}\\times\\cdots\\times\\frac{(n-1)(n+1)}{n\\cdot n}$","$=\\frac{2}{n}\\times\\frac{n+1}{3}=\\frac{2(n+1)}{3n}$","$\\frac{2(n+1)}{3n}=\\frac{196}{291}$ → $582n+582=588n$","$n=97$ → ③"],"check":"ok"},
"9":{"tp":"제곱근의 곱셈","key":"근호 안을 소인수분해","sol":["근호 안 $=2^3\\cdot3^3\\cdot5^3\\cdot7\\cdot a^3$","$=30\\times(2\\cdot3\\cdot5)^2\\cdot7a^3$","$7a^3$ 이 제곱수 → $a=7$","$b=30\\times49=1470$","$\\frac{1470}{10}=147$ → ⑤"],"check":"ok"},
"10":{"tp":"제곱근의 배수 관계","key":"A = √(500/5), B = √(0.005/2)","sol":["$A=\\sqrt{100}=10$","$B=\\sqrt{0.0025}=0.05$","$AB=0.5=\\frac12$"],"check":"ok"},
"11":{"tp":"인수분해 활용","key":"(a−b)(ab−4) = 32","sol":["$ab(a-b)-4(a-b)=8(a-b)=32$, $a-b=4$","$(a+b)^2=16+48=64$, $a+b=8$","$a^2-b^2=32$","$\\sqrt{\\frac{6\\times32}{12}}=\\sqrt{16}=4$ → ④"],"check":"ok"},
"12":{"tp":"a√b 꼴 변형","key":"√(a²b) = a√b","sol":["$\\sqrt{18}=3\\sqrt2$, $a=3$","$2\\sqrt3=\\sqrt{12}$, $b=12$","$\\sqrt{36}=6$"],"check":"ok"},
"13":{"tp":"제곱근의 곱셈과 나눗셈","key":"√4000 = √400 × √10","sol":["(1) $\\sqrt{4000}=20\\sqrt{10}$, $x=20$","(2) $y=\\sqrt{\\frac{0.4}{160}}=\\sqrt{\\frac{1}{400}}=\\frac{1}{20}$","(3) $xy=1$"],"check":"ok"},
"14":{"tp":"넓이가 반씩 줄어드는 정사각형","key":"한 단계마다 넓이 1/2","sol":["$n$단계 넓이 $=\\frac{1920}{2^n}$","$7$단계: $\\frac{1920}{128}=15$","한 변 $\\sqrt{15}$"],"check":"ok"},
"15":{"tp":"정사각형 둘레","key":"한 변: √3, 4√3, 3√3","sol":["한 변: $\\sqrt3$, $\\sqrt{48}=4\\sqrt3$, $\\sqrt{27}=3\\sqrt3$","가로 합 $8\\sqrt3$, 가장 높은 높이 $4\\sqrt3$","둘레 $=2(8\\sqrt3+4\\sqrt3)=24\\sqrt3\\,\\mathrm{cm}$"],"check":"ok"},
"16":{"tp":"정팔각형 넓이","key":"잘라낸 삼각형의 빗변 = 팔각형 한 변","sol":["잘라낸 직각이등변삼각형 다리 $t$, 한 변 $\\sqrt2t$","$2t+\\sqrt2t=4$ → $t=\\frac{4}{2+\\sqrt2}=4-2\\sqrt2$","$t^2=24-16\\sqrt2$","넓이 $=16-4\\times\\frac{t^2}{2}=16-48+32\\sqrt2$","$=(32\\sqrt2-32)\\,\\mathrm{cm}^2$"],"check":"ok"},
"17":{"tp":"분모의 유리화","key":"켤레식 곱하기","sol":["$x=\\frac{(\\sqrt5-\\sqrt3)^2}{5-3}=\\frac{8-2\\sqrt{15}}{2}=4-\\sqrt{15}$","$y=\\frac{1}{4-\\sqrt{15}}=4+\\sqrt{15}$","$x-y=-2\\sqrt{15}$"],"check":"ok"},
"18":{"tp":"제곱근 활용 (해일 속력)","key":"속력 = √(9.8h)","sol":["(1) $\\sqrt{9.8\\times20}=\\sqrt{196}=14\\,\\mathrm{m/s}$","(2) $\\sqrt{980}=10\\sqrt{9.8}=31.30\\,\\mathrm{m/s}$","(3) $9.8h=42^2=1764$","$h=180\\,\\mathrm{m}$"],"check":"ok"},
"19":{"tp":"정사각형 한 변과 넓이","key":"과수원 한 변 6√15, 무밭 한 변 2√15","sol":["$\\sqrt{540}=6\\sqrt{15}$, $\\sqrt{60}=2\\sqrt{15}$","당근밭: 가로 $2\\sqrt{15}$, 세로 $6\\sqrt{15}-2\\sqrt{15}=4\\sqrt{15}$","넓이 $=8\\times15=120\\,\\mathrm{m}^2$"],"check":"ok"},
"20":{"tp":"정삼각형의 높이와 넓이","key":"높이 = 정사각형 한 변 2√3","sol":["정사각형 한 변 $\\sqrt{12}=2\\sqrt3$","정삼각형 높이 $\\frac{\\sqrt3}{2}s=2\\sqrt3$, $s=4$","넓이 $=\\frac{\\sqrt3}{4}\\times16=4\\sqrt3$"],"check":"ok"}
