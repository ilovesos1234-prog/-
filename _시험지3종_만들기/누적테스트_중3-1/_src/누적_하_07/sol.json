{
"1":{"tp":"제곱근의 뜻","key":"$169$ 의 제곱근은 $\\pm13$","sol":["$a=13,\\ b=-13$","$a-4b-1=13+52-1=64$","$\\sqrt{64}=8$","$8$ 의 제곱근은 $\\pm\\sqrt8$"],"check":"ok"},
"2":{"tp":"자연수가 되는 조건","key":"소인수의 지수를 짝수로","sol":["$20=2^2\\times5$","$x=5\\times k^2$ 꼴","가장 작은 $x=5$"],"check":"ok"},
"3":{"tp":"실수의 대소","key":"제곱하여 비교","sol":["③ $1\\lt\\sqrt3$ 이므로 $4\\lt3+\\sqrt3$ (참)","④ $2=\\sqrt4\\lt\\sqrt5$","$-2\\gt-\\sqrt5$ (거짓)"],"check":"ok"},
"4":{"tp":"제곱근의 대소","key":"$a$ 에 적당한 값 대입","sol":["$a=\\frac14$: $\\frac14,\\ \\frac12,\\ \\frac1{16},\\ 4,\\ 2$","가장 큰 수 $\\frac1a$, 가장 작은 수 $a^2$","$\\frac1a\\times a^2=a$"],"check":"ok"},
"5":{"tp":"분모의 유리화","key":"분모·분자에 근호 곱하기","sol":["$\\frac{4\\sqrt2}{\\sqrt3}=\\frac{4\\sqrt6}{3}$, $a=\\frac43$","$\\frac{14}{3\\sqrt7}=\\frac{14\\sqrt7}{21}=\\frac{2\\sqrt7}{3}$, $b=\\frac23$","$a+b=2$"],"check":"ok"},
"6":{"tp":"수직선 위의 무리수","key":"정사각형 대각선 $=\\sqrt2$","sol":["$\\overline{\\mathrm{AB}}=\\sqrt2$, A$(-3)$ 이므로 $p=-3-\\sqrt2$","$\\overline{\\mathrm{CD}}=\\sqrt2$, C$(-1)$ 이므로 $q=-1+\\sqrt2$","$3q-2p=-3+3\\sqrt2+6+2\\sqrt2$","$=3+5\\sqrt2$"],"check":"ok"},
"7":{"tp":"제곱근의 성질","key":"$ab\\lt0$ 이므로 $a,b$ 부호가 반대","sol":["(1) $a\\lt0$: $\\sqrt{a^2}=-a$","(2) $\\frac{a^2}{b^2}\\times\\frac{3|b|^3}{|a|}=3|ab|=6\\sqrt2$","(3) $a\\gt0,\\ b\\lt0$: $\\frac{a^3}{b^2}\\times\\frac{3b^2}{a}=3a^2$","$3a^2\\times\\frac{b}{a^2}\\times\\frac{-a^2b}{4}=-\\frac34(ab)^2=-6$","(4) $a\\lt0,\\ b\\gt0$: $\\frac{a^3}{b^2}\\times\\frac{3b^3}{-a}=-3a^2b$","$-3a^2b\\times\\frac ba\\times\\frac{a^2b}{4}=-\\frac34(ab)^3=12\\sqrt2$"],"check":"ok (원문의 곱셈 기호 생략을 ×로 표시)"},
"8":{"tp":"도형과 곱셈 공식","key":"길을 끝으로 밀어 붙이기","sol":["가로 $5a+1-2=5a-1$","세로 $3a-2$","$(5a-1)(3a-2)$","$=15a^2-13a+2$"],"check":"ok"},
"9":{"tp":"곱셈 공식","key":"각각 전개하여 $x^2-y^2$ 과 비교","sol":["ㄱ. $y^2-x^2$","ㄴ. $(x-y)(x+y)=x^2-y^2$ ○","ㄷ. $(x+y)(x-y)=x^2-y^2$ ○","ㄹ. $-(x+y)^2$, ㅁ. $(x-y)^2$","$2$ 개"],"check":"ok"},
"10":{"tp":"완전제곱식","key":"$(x+a)^2=x^2+2ax+a^2$","sol":["$(x+3)^2=x^2+6x+9$","$\\mathrm{A}=9$"],"check":"ok"},
"11":{"tp":"식의 값","key":"$a^3b-ab^3=ab(a+b)(a-b)$","sol":["$a=-(\\sqrt2+\\sqrt3),\\ b=\\sqrt3-\\sqrt2$","$ab=-1$","$a+b=-2\\sqrt2,\\ a-b=-2\\sqrt3$","$ab(a+b)(a-b)=-1\\times4\\sqrt6=-4\\sqrt6$"],"check":"ok"},
"12":{"tp":"분모의 유리화","key":"켤레식을 곱한다","sol":["$\\frac{(\\sqrt{x+1}-\\sqrt{x-1})^2}{(x+1)-(x-1)}$","$=\\frac{2x-2\\sqrt{x^2-1}}{2}=x-\\sqrt{x^2-1}$","$x=\\sqrt3$: $\\sqrt3-\\sqrt2$"],"check":"ok"},
"13":{"tp":"식의 값","key":"양변을 $x$ 로 나누어 $x-\\frac1x$","sol":["$x\\neq0$ 이므로 $x-4-\\frac1x=0$","$x-\\frac1x=4$","$x^2+\\frac1{x^2}=4^2+2=18$","(식) $=x^2+\\frac1{x^2}-2\\left(x-\\frac1x\\right)$","$=18-8=10$"],"check":"ok"},
"14":{"tp":"분모의 유리화와 식의 값","key":"$x+y,\\ xy$ 이용","sol":["$\\sqrt x=2+\\sqrt3,\\ \\sqrt y=2-\\sqrt3$","$x=7+4\\sqrt3,\\ y=7-4\\sqrt3$","$x+y=14,\\ xy=1$","$14+1+1=16$"],"check":"ok"},
"15":{"tp":"합차 공식","key":"$x^2-y^2=(x+y)(x-y)$","sol":["$x+y=2\\sqrt3,\\ x-y=2\\sqrt2$","$x^2-y^2=4\\sqrt6$"],"check":"ok"},
"16":{"tp":"곱셈 공식과 수의 계산","key":"$2020$ 을 기준으로 합차 공식","sol":["$(2020-2)(2020+2)+4$","$=2020^2-4+4=2020^2$","$a=2020$"],"check":"ok"},
"17":{"tp":"곱셈 공식과 수의 계산","key":"수의 모양에 맞는 공식 선택","sol":["(1) ㄴ: $(1000-2)(1000+2)=1000000-4=999996$","(2) ㄱ: $(100+2)^2=10000+400+4=10404$","(3) ㄷ: $(50+2)(50+5)=2500+350+10=2860$"],"check":"ok"},
"18":{"tp":"식의 값","key":"$x$ 를 직접 대입","sol":["$x^2=3+2\\sqrt2$","$3+2\\sqrt2-6-6\\sqrt2+5=2-4\\sqrt2$","$a=2,\\ b=-4$","$a+b=-2$"],"check":"ok"},
"19":{"tp":"분모의 유리화","key":"분모의 켤레 $\\sqrt3-\\sqrt2$ 곱하기","sol":["$\\frac{(\\sqrt3-\\sqrt2)^2}{(\\sqrt3+\\sqrt2)(\\sqrt3-\\sqrt2)}$","$=\\frac{3-2\\sqrt6+2}{3-2}$","$=5-2\\sqrt6$"],"check":"ok"},
"20":{"tp":"분모의 유리화","key":"각각 유리화 후 대입","sol":["$x=\\frac{4(\\sqrt6+\\sqrt5)}{6-5}=4\\sqrt6+4\\sqrt5$","$y=\\frac{\\sqrt5-2}{5-4}=\\sqrt5-2$","$y^2=9-4\\sqrt5$","$x+y^2=9+4\\sqrt6$"],"check":"ok"}
