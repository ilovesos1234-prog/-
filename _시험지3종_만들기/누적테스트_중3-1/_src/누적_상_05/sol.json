"15":{"tp":"실수의 대소 비교","key":"안쪽 괄호부터","sol":["$2-\\sqrt3\\lt1$ → $\\lt1,\\ 2-\\sqrt3\\gt=1$","$\\sqrt2\\lt\\sqrt5$ → $\\lt3-\\sqrt2,\\ 3-\\sqrt5\\gt=3-\\sqrt2$","$3-\\sqrt2-1=2-\\sqrt2\\gt0$","답 $3-\\sqrt2$"],"check":"ok"},
