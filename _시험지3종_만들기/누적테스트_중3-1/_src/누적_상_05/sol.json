"1":{"tp":"제곱근표 활용","key":"표에 있는 수 × (제곱수) 꼴로 바꾼다","sol":["$\\sqrt{4.4}=2.098$","$\\sqrt{444}=10\\sqrt{4.44}=21.07$","$\\sqrt{25.6}=4\\sqrt{1.6}=4\\times1.265=5.06$","$\\sqrt{1233}=\\sqrt{900\\times1.37}=30\\times1.170=35.1$","$\\sqrt{1.616}=\\sqrt{0.04\\times40.4}=0.2\\times6.356=1.2712$"],"check":"ok"},
"2":{"tp":"제곱근의 반올림","key":"(k+0.5)² 를 경계로","sol":["$f=1$: $n=1$ / $f=2$: $3,5$ / $f=3$: $7,9,11$","$f=4$: $13\\sim19$ ($4$개) / $f=5$: $21\\sim29$ ($5$개)","($12.25$, $20.25$, $30.25$ 가 경계)","$1+4+9+16+25=55$ → ⑤"],"check":"ok"},
"3":{"tp":"근호의 곱셈과 나눗셈","key":"각각 간단히 한 뒤 곱","sol":["$a=\\frac{2\\sqrt6+2\\sqrt3}{\\sqrt3}=2\\sqrt2+2$","$b=\\frac{\\sqrt6-\\sqrt3}{\\sqrt2}\\times\\frac{2\\sqrt2}{\\sqrt3}=\\frac{2(\\sqrt6-\\sqrt3)}{\\sqrt3}=2\\sqrt2-2$","$ab=4(\\sqrt2+1)(\\sqrt2-1)=4$"],"check":"ok"},
"4":{"tp":"분모의 유리화","key":"통분하면 분모 7−5=2","sol":["$\\frac{(\\sqrt7-\\sqrt5)^2-(\\sqrt7+\\sqrt5)^2}{7-5}$","$=\\frac{-4\\sqrt{35}}{2}=-2\\sqrt{35}$"],"check":"ok"},
"5":{"tp":"닮음과 제곱근","key":"AB:CD = CD:EF","sol":["$5:\\overline{CD}=\\overline{CD}:8$","$\\overline{CD}^2=40$","$\\overline{CD}=\\sqrt{40}=2\\sqrt{10}$"],"check":"ok"},
"6":{"tp":"분모의 유리화","key":"a=1/2, b=1/4","sol":["$\\frac{5}{\\sqrt{10}}=\\frac{5\\sqrt{10}}{10}=\\frac12\\sqrt{10}$, $a=\\frac12$","$\\frac{3\\sqrt5}{4\\sqrt3}=\\frac{3\\sqrt{15}}{12}=\\frac14\\sqrt{15}$, $b=\\frac14$","$\\sqrt{\\frac{b}{a}}=\\sqrt{\\frac12}=\\frac{1}{\\sqrt2}=\\frac{\\sqrt2}{2}$"],"check":"ok"},
"7":{"tp":"사다리꼴 넓이","key":"45° 이므로 높이 = 밑변 차","sol":["높이 $=(3\\sqrt3+1)-2\\sqrt3=\\sqrt3+1$","넓이 $=\\frac{(5\\sqrt3+1)(\\sqrt3+1)}{2}$","$=\\frac{16+6\\sqrt3}{2}=8+3\\sqrt3$","$a-b=8-3=5$"],"check":"ok"},
"8":{"tp":"실수의 대소 비교","key":"두 수의 차의 부호","sol":["$a-c=2\\sqrt5-3\\sqrt2=\\sqrt{20}-\\sqrt{18}\\gt0$","$c-b=3\\sqrt2+\\sqrt5-6$, $(3\\sqrt2+\\sqrt5)^2=23+2\\sqrt{90}\\gt36$","$c\\gt b$","$b\\lt c\\lt a$"],"check":"ok"},
"9":{"tp":"수직선 위의 무리수","key":"정사각형 대각선 √2","sol":["(1) $a=0-\\sqrt2=-\\sqrt2$","$b=-1+\\sqrt2$, $c=3-\\sqrt2$","(2) $c-b=4-2\\sqrt2$","$\\frac{4-2\\sqrt2}{-\\sqrt2}=-2\\sqrt2+2=2-2\\sqrt2$"],"check":"ok"},
"10":{"tp":"정수 부분과 소수 부분","key":"2<√5<3, 2<√7<3","sol":["$7\\lt10-\\sqrt5\\lt8$ → $x=7$","$3\\lt1+\\sqrt7\\lt4$ → $y=\\sqrt7-2$","$\\sqrt{5^2}+(-\\sqrt7)^2=5+7=12$ → ④"],"check":"ok"},
"11":{"tp":"유리화와 소거","key":"1/f(x) = √x − √(x−1)","sol":["$\\frac{1}{\\sqrt{x-1}+\\sqrt x}=\\sqrt x-\\sqrt{x-1}$","합 $=(\\sqrt6-\\sqrt5)+(\\sqrt7-\\sqrt6)+(\\sqrt8-\\sqrt7)+(\\sqrt9-\\sqrt8)$","$=3-\\sqrt5$ → ③"],"check":"ok"},
"12":{"tp":"근호의 덧셈과 뺄셈","key":"각 항 간단히 + 유리화","sol":["$\\sqrt{20}=2\\sqrt5$, $\\frac{4}{\\sqrt2}=2\\sqrt2$, $\\sqrt{45}=3\\sqrt5$","$\\frac{\\sqrt5+1}{\\sqrt5-1}=\\frac{(\\sqrt5+1)^2}{4}=\\frac{3+\\sqrt5}{2}$","합 $=2\\sqrt2-\\frac12\\sqrt5+\\frac32$","$a+b+c=2-\\frac12+\\frac32=3$"],"check":"ok"},
"13":{"tp":"제곱근 자","key":"눈금 A까지 거리 √A","sol":["위 자 눈금 $2$ 위치: $\\sqrt2$","아래 자 눈금 $18$ 까지: $\\sqrt{18}=3\\sqrt2$","$x=\\sqrt2+3\\sqrt2=4\\sqrt2$","$a=0,\\ b=4,\\ c=2$, $a+b+c=6$ → ②"],"check":"그림의 x를 위 자 0부터 아래 자 눈금 18까지의 거리로 보아 정답 ②와 일치"},
