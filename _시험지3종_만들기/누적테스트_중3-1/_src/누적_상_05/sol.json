"17":{"tp":"근호의 덧셈과 뺄셈","key":"분배법칙 후 정리","sol":["$\\sqrt{27}=3\\sqrt3$, $3\\sqrt{32}=12\\sqrt2$","$\\sqrt6(\\sqrt3+\\sqrt{18})=3\\sqrt2+6\\sqrt3$","$3\\sqrt3+12\\sqrt2-3\\sqrt2-6\\sqrt3=9\\sqrt2-3\\sqrt3$","$a=9$, $b=-3$"],"check":"ok"},
"18":{"tp":"유리수가 될 조건","key":"√5 의 계수 = 0","sol":["$\\sqrt{125}=5\\sqrt5$, $\\frac{1}{\\sqrt5}=\\frac{\\sqrt5}{5}$","식 $=(x+5-4-\\frac15)\\sqrt5$","$x+\\frac45=0$, $x=-\\frac45$"],"check":"ok"},
"19":{"tp":"근호의 덧셈과 뺄셈","key":"a√b 꼴로 변형","sol":["$2\\sqrt{27}=6\\sqrt3$, $\\sqrt{175}=5\\sqrt7$","$\\sqrt{48}=4\\sqrt3$, $3\\sqrt{63}=9\\sqrt7$","$6\\sqrt3-5\\sqrt7-4\\sqrt3+9\\sqrt7=2\\sqrt3+4\\sqrt7$","$a=2$, $b=4$"],"check":"ok"},
"20":{"tp":"직사각형 둘레와 넓이","key":"5×짧은 변 = 3×긴 변","sol":["짧은 변 $s$, 긴 변 $l$: $5s=3l$","둘레 $2(5s+l+s)=2(6s+l)=46\\sqrt2$","$6s+\\frac53s=23\\sqrt2$ → $s=3\\sqrt2$, $l=5\\sqrt2$","넓이 $=8\\times3\\sqrt2\\times5\\sqrt2=240$ → ②"],"check":"ok"}
