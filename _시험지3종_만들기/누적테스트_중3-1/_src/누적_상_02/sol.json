{
"1":{"tp":"제곱수 조건","key":"x+y+z=3y 가 제곱수","sol":["$x+y+z=3y=k^2$, $3y\\lt 150$","$3y=36$ 또는 $144$ ($y$ 짝수)","$y=12$ 또는 $48$","합 $=60$ → ③"],"check":"ok"},
"2":{"tp":"제곱수를 3으로 나눈 나머지","key":"제곱수를 3으로 나눈 나머지는 0 또는 1","sol":["ㄱ: $25=3\\times8+1$ (○)","ㄴ: $f(6)=0$ (×)","ㄷ: $7\\sim50$ 의 $44$개 중 $3$의 배수 $14$개","합 $=44-14=30$ (×)","ㄹ: $3$의 배수면 $0$, 아니면 $1$ (○) → ④"],"check":"ok"},
"3":{"tp":"곱셈공식 활용","key":"15996 = 4×3999 로 완전제곱식","sol":["$x=3998$ 이면 $15996=4x+4$","$x^2+4x+4=(x+2)^2=4000^2$","$=16\\times10^6$, $a=16$, $b=6$","$a+b=22$ → ⑤"],"check":"ok"},
"4":{"tp":"피타고라스와 정수 변","key":"AB² − AC² = 64 를 인수분해","sol":["$(\\overline{AB}-\\overline{AC})(\\overline{AB}+\\overline{AC})=64$","두 인수는 모두 짝수: $(2,32)$, $(4,16)$","$(17,15)$ → 둘레 $17+15+8=40$","$(10,6)$ → 둘레 $24$","최댓값 $40$"],"check":"ok"},
"5":{"tp":"√A² 꼴 계산","key":"a−b의 부호 판단","sol":["$a+b=7+\\sqrt{11}\\gt 0$","$a-b=3-\\sqrt{11}\\lt 0$ ($\\sqrt{11}\\gt 3$)","$(7+\\sqrt{11})+(\\sqrt{11}-3)=4+2\\sqrt{11}$"],"check":"ok"},
"6":{"tp":"완전제곱식으로 바꾸기","key":"(x+1)²−4x=(x−1)², (x−1)²+4x=(x+1)²","sol":["$\\sqrt{(-x)^2}=x$","$2\\sqrt{(x-1)^2}=2(1-x)$","$2\\sqrt{(x+1)^2}=2(x+1)$","$x+2-2x-2x-2=-3x$"],"check":"ok"},
"7":{"tp":"√(Ax) 자연수 조건","key":"√(45n)=3√(5n), 2로 나누어떨어져야","sol":["$\\frac{3\\sqrt{5n}}{2}$ 자연수 → $n=5k^2$, $k$ 짝수","$n=20,80,180$","$n+1$ 이 제곱수가 아니어야: $81=9^2$ 이므로 $80$ 제외","$20+180=200$ → ①"],"check":"ok"},
"8":{"tp":"√(Ax) 자연수 조건","key":"56 = 2³×7","sol":["$56a=2^3\\times7\\times a$","$a=2\\times7\\times k^2=14k^2$","$a=14,\\ 56,\\ 126$"],"check":"ok"},
"9":{"tp":"√(A−x) 정수 조건","key":"22−x 가 0 또는 제곱수","sol":["$22-x=0,1,4,9,16$","$x=22,21,18,13,6$","합 $=80$ → ⑤"],"check":"ok"},
"10":{"tp":"제곱수의 차","key":"m² − n² = 33 인수분해","sol":["$(m-n)(m+n)=33$","$(1,33)$: $m=17$, $n=16$","$(3,11)$: $m=7$, $n=4$","$n=16,\\ 4$"],"check":"ok"},
"11":{"tp":"√(A−n) 정수 조건","key":"15−n 은 0 또는 15보다 작은 제곱수","sol":["$15-n\\ge0$ 이고 $15-n$ 은 $0$ 또는 제곱수","$15-n=0,1,4,9$","$n=15,14,11,6$"],"check":"ok"},
"12":{"tp":"√(Ax), √(A/x) 자연수 조건","key":"63=3²×7, 972=2²×3⁵","sol":["(1) $x=7k^2$: $28, 63, 112, 175,\\cdots$","$100$에 가장 가까운 수 $a=112$","(2) $972=2^2\\times3^5$","$\\frac{972}{y}$ 가 $1$보다 큰 제곱수 중 최소 $4$","$y=243$, $b=243$"],"check":"ok"},
"13":{"tp":"√(Ax/y) 자연수 조건","key":"24x 의 제곱수 약수 개수","sol":["$x=3$: $72=2^3\\cdot3^2$, $\\frac{72}{y}=1,4,9,36$ → $4$개","$x=4$: $96=2^5\\cdot3$, $\\frac{96}{y}=1,4,16$ → $3$개","$x=5$: $120=2^3\\cdot3\\cdot5$, $\\frac{120}{y}=1,4$ → $2$개","총 $9$개"],"check":"ok"},
"14":{"tp":"인수분해와 제곱수","key":"2a−3b+ab−6=(a−3)(b+2)","sol":["$(a-3)(b+2)$ 가 제곱수, $3\\le b+2\\le9$","$a=4$: $b+2=4,9$ → $(4,2),(4,7)$","$a=5$: $2(b+2)=16$ → $(5,6)$","$a=6$: $3(b+2)=9$ → $(6,1)$","$a=7$: $4(b+2)$ → $(7,2),(7,7)$"],"check":"ok"},
"15":{"tp":"근호의 덧셈","key":"√294=7√6, √x=p√6","sol":["$\\sqrt{294}=7\\sqrt{6}$","$x=6p^2$, $y=6q^2$, $p+q=7$, $p\\ge q\\ge1$","$(p,q)=(6,1),(5,2),(4,3)$","$3$개 → ③"],"check":"ok"},
"16":{"tp":"실수의 대소 비교","key":"두 수의 차의 부호","sol":["$(5\\sqrt{2}-2)-5=\\sqrt{50}-7\\gt0$","$5-(4\\sqrt{3}-2)=7-\\sqrt{48}\\gt0$","$5\\sqrt{2}-2\\gt5\\gt4\\sqrt{3}-2$"],"check":"ok"},
"17":{"tp":"N(x) 합","key":"k²<x≤(k+1)² 이면 N(x)=k","sol":["$N=1$: $x=2\\sim4$ ($3$개), $N=2$: $5\\sim9$ ($5$개)","$N=3$: $7$개, $N=4$: $9$개, $N=5$: $11$개","$x=36$ 까지 합 $=3+10+21+36+55=125$","$149-125=24=6\\times4$","$x=36+4=40$ → ②"],"check":"ok"},
"18":{"tp":"제곱근 사이 자연수 개수","key":"n²<x<(n+1)² 인 x는 2n개","sol":["$n\\lt\\sqrt{x}\\lt n+1$ → $n^2\\lt x\\lt(n+1)^2$","개수 $=(n+1)^2-n^2-1=2n$","$2n=40$, $n=20$ → ⑤"],"check":"ok"},
"19":{"tp":"제곱근 부등식","key":"각 변을 제곱","sol":["$4\\le2x+8\\lt16$","$-2\\le x\\lt4$","$-2+(-1)+0+1+2+3=3$"],"check":"ok"},
"20":{"tp":"제곱근 부등식","key":"각 변을 제곱","sol":["$\\frac94\\lt x-1\\le9$","$\\frac{13}{4}\\lt x\\le10$, $x=4,\\cdots,10$","$3$의 배수: $6, 9$ → $2$개 ①"],"check":"ok"}
}
