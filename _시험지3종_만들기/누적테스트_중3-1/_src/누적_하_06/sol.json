{
"1":{"tp":"제곱근의 성질","key":"$a\\lt 0\\lt b$ 이므로 근호 안의 부호 판단","sol":["$ab\\lt 0,\\ a\\lt b \\Rightarrow a\\lt 0\\lt b$","$\\sqrt{4a^2}=|2a|=-2a$","$(-\\sqrt{b})^2=b$","$b-2a\\gt 0$ 이므로 $\\sqrt{(b-2a)^2}=b-2a$","$(-2a)+b-(b-2a)=0$"],"check":"ok"},
"2":{"tp":"√(a−b)² 꼴 간단히","key":"완전제곱식으로 바꾸고 부호 판단","sol":["$\\sqrt{(x+3)^2}-\\sqrt{(x-5)^2}$","$x+3\\gt 0,\\ x-5\\lt 0$","$=(x+3)-\\{-(x-5)\\}$","$=x+3+x-5=2x-2$"],"check":"ok"},
"3":{"tp":"자연수가 되는 조건","key":"소인수의 지수가 짝수","sol":["$360=2^3\\times3^2\\times5,\\ 90=2\\times3^2\\times5$","$\\sqrt{90x}$: $x=2\\times5\\times k^2$ 꼴","$x=10$: $\\sqrt{36}=6,\\ \\sqrt{900}=30$","가장 작은 $x=10$"],"check":"ok"},
"4":{"tp":"실수의 대소","key":"공통 부분을 빼고 비교","sol":["① $4\\gt\\sqrt{15}$ (참)","② $-\\sqrt2\\gt-\\sqrt3$ (참)","③ $\\sqrt2\\lt\\sqrt3$ (참)","④ $\\sqrt5\\lt 2=\\sqrt4$ (거짓)","⑤ $3=\\sqrt9\\gt\\sqrt8$ (참)"],"check":"ok"},
"5":{"tp":"실수와 수직선","key":"정사각형 한 변 $=\\sqrt{2^2+1^2}$","sol":["$\\overline{\\mathrm{AB}}=\\sqrt{2^2+1^2}=\\sqrt5$, 넓이 $5$","A$(-1)$ 이므로 Q$=-1+\\sqrt5$","P$=-1-\\sqrt5$","$\\overline{\\mathrm{PQ}}=2\\sqrt5$","③ P는 $-1-\\sqrt5$ (옳지 않음)"],"check":"ok"},
"6":{"tp":"근호의 곱셈·나눗셈","key":"역수 곱하기 후 분모의 유리화","sol":["$\\frac{3}{\\sqrt{15}}\\times4\\sqrt3\\times\\frac{\\sqrt2}{6}$","$=\\frac{12\\sqrt6}{6\\sqrt{15}}=\\frac{2\\sqrt2}{\\sqrt5}$","$=\\frac{2\\sqrt{10}}{5}$","$n=2,\\ m=5$","$mn=10$"],"check":"ok"},
"7":{"tp":"근호의 곱셈","key":"$12!$ 소인수분해","sol":["$\\sqrt{12!}$, $12!=2^{10}\\times3^5\\times5^2\\times7\\times11$","$=2^5\\times3^2\\times5\\sqrt{3\\times7\\times11}$","$=1440\\sqrt{231}$","$a+b=1440+231=1671$"],"check":"ok"},
"8":{"tp":"근호의 덧셈과 뺄셈","key":"대입 후 분모의 유리화","sol":["$8\\mathrm{A}=16+12\\sqrt2$","$12\\mathrm{B}=12-6\\sqrt2$","$8\\mathrm{A}-12\\mathrm{B}=4+18\\sqrt2$","$\\frac{4+18\\sqrt2}{\\sqrt6}=\\frac{2\\sqrt6}{3}+6\\sqrt3$","$\\sqrt6+\\frac{2\\sqrt6}{3}+6\\sqrt3=6\\sqrt3+\\frac53\\sqrt6$","$ab=6\\times\\frac53=10$"],"check":"ok"},
"9":{"tp":"정수 부분과 소수 부분","key":"$1\\lt\\sqrt2\\lt2$","sol":["$3\\lt5-\\sqrt2\\lt4$","$a=5-\\sqrt2-3=2-\\sqrt2$","$2\\sqrt2=\\sqrt8$, $2\\lt\\sqrt8\\lt3$ 이므로 $b=2$","$\\frac{2}{2-\\sqrt2}=\\frac{2(2+\\sqrt2)}{2}=2+\\sqrt2$"],"check":"ok"},
"10":{"tp":"수직선 위의 무리수","key":"피타고라스로 세로 길이","sol":["$\\overline{\\mathrm{BC}}=2$","$\\overline{\\mathrm{AB}}=\\sqrt{24-4}=2\\sqrt5$","$a=2-2\\sqrt5,\\ b=4+2\\sqrt5$","$a-b=-2-4\\sqrt5$"],"check":"ok"},
"11":{"tp":"다항식의 곱셈","key":"가로 $a+b$, 세로 $a-2b$","sol":["$(a+b)(a-2b)$","$=a^2-2ab+ab-2b^2$","$=a^2-ab-2b^2$"],"check":"ok"},
"12":{"tp":"다항식의 전개","key":"전개 후 계수 비교","sol":["$(x-2)(2x+3)=2x^2-x-6$","$a=2,\\ b=-1,\\ c=-6$","$2a-b-c=4+1+6=11$"],"check":"ok"},
"13":{"tp":"치환하여 전개","key":"$x-5=t$ 로 치환","sol":["$3t^2+7t-6=(3t-2)(t+3)$","$=(3x-17)(x-2)$","$a=-2,\\ b=3$","$a+b=1$"],"check":"ok"},
"14":{"tp":"도형과 곱셈 공식","key":"정사각형 변의 길이를 차례로 구하기","sol":["$\\overline{\\mathrm{GD}}=3y$ 이므로 $\\overline{\\mathrm{AG}}=4x-3y$","$\\overline{\\mathrm{EB}}=4x-3y$ 이므로 $\\overline{\\mathrm{AE}}=3y-(4x-3y)=6y-4x$","$(4x-3y)(6y-4x)=-16x^2+36xy-18y^2$","$a+b-c=-16+36+18=38$"],"check":"ok"},
"15":{"tp":"도형과 곱셈 공식","key":"판자는 가로 $2b$, 세로 $a$","sol":["A: 한 변 $2b-a$ 인 정사각형","$\\mathrm{A}=(2b-a)^2=4b^2-4ab+a^2$","B: 가로 $2b-2a$, 세로 $2b$","$\\mathrm{B}=2b(2b-2a)=4b^2-4ab$","$\\mathrm{B}-\\mathrm{A}=-a^2$"],"check":"ok"},
"16":{"tp":"합차 공식","key":"$(a+b)(a-b)=a^2-b^2$","sol":["$(5x)^2-(3y)^2$","$=25x^2-9y^2$"],"check":"ok"},
"17":{"tp":"완전제곱식","key":"$(x+a)^2=x^2+2ax+a^2$","sol":["$2a=-12 \\Rightarrow a=-6$","$b=a^2=36$","$a+b=30$"],"check":"ok"},
"18":{"tp":"합차 공식 연속 적용","key":"$(2-1)(2+1)=2^2-1$ 연쇄","sol":["$(2^2-1)(2^2+1)=2^4-1$","$(2^4-1)(2^4+1)=2^8-1$","$(2^8-1)(2^8+1)=2^{16}-1$","$a=16,\\ b=-1$, $a+b=15$"],"check":"ok"},
"19":{"tp":"곱셈 공식","key":"$(A+B)^2-(A-B)^2=4AB$","sol":["$(4a^2+4ab+b^2)-(4a^2-4ab+b^2)$","$=8ab$"],"check":"ok"},
"20":{"tp":"곱셈 공식과 계수","key":"$AB=12,\\ C=A+B$","sol":["$AB=12$ 인 정수 쌍","$(1,12),(2,6),(3,4)$: $C=13,8,7$","음수 쌍: $C=-13,-8,-7$","$C=1$ 은 불가능"],"check":"ok"}
