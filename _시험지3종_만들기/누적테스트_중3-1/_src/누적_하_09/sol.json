{
"1":{"tp":"근호의 곱셈과 나눗셈","key":"$\\sqrt{a^2b}=a\\sqrt b$","sol":["$a=9\\div3=3$","$\\sqrt{72}=\\sqrt{36\\times2}=6\\sqrt2$, $b=6$","$a+b=9$"],"check":"ok"},
"2":{"tp":"실수의 대소","key":"이항 후 제곱하여 비교","sol":["③ $3-\\sqrt{11}\\gt\\sqrt{11}-2 \\iff 5\\gt2\\sqrt{11}$","$5=\\sqrt{25},\\ 2\\sqrt{11}=\\sqrt{44}$","$\\sqrt{25}\\lt\\sqrt{44}$ 이므로 거짓","⑤ $8\\lt5\\sqrt3=\\sqrt{75}$ (참)"],"check":"ok"},
"3":{"tp":"인수분해의 도형 활용","key":"$A^2-B^2=(A+B)(A-B)$","sol":["$(2x+5)^2-4^2$","$=(2x+5+4)(2x+5-4)$","$=(2x+9)(2x+1)$","가로의 길이 $2x+9$"],"check":"ok"},
"4":{"tp":"인수분해의 활용","key":"식 변형 후 대입","sol":["ㄱ. $(x-1)^2-4=7-4=3$ ○","ㄴ. $(1-2)(1+2)+\\cdots+(7-8)(7+8)$","$=-(3+7+11+15)=-36$ ○","ㄷ. 한 변 $\\sqrt5+3\\sqrt7$","넓이 $5+6\\sqrt{35}+63=68+6\\sqrt{35}$ ○"],"check":"ok"},
"5":{"tp":"인수분해를 이용한 수의 계산","key":"완전제곱식, 합차","sol":["$\\mathrm{A}=(51-1)^2=2500$, $\\sqrt{\\mathrm{A}}=50$","$\\mathrm{B}=(17+13)(17-13)=120$","$\\frac{120}{50}=\\frac{12}{5}$"],"check":"ok"},
"6":{"tp":"인수분해 공식의 도형 이해","key":"사다리꼴 두 개를 이어 붙인 직사각형","sol":["(1) $a^2-b^2$","(2) ㉮, ㉯를 이어 붙이면","가로 $a+b$, 세로 $a-b$","넓이 $(a+b)(a-b)$","(3) $a^2-b^2=(a+b)(a-b)$"],"check":"ok"},
"7":{"tp":"합차 공식 인수분해","key":"두 번 합차 공식","sol":["$(4x^2)^2-(9y^2)^2=(4x^2+9y^2)(4x^2-9y^2)$","$=(2x+3y)(2x-3y)(4x^2+9y^2)$","$a=2,\\ b=2,\\ c=4,\\ d=9$","$a+b+c+d=17$"],"check":"ok"},
"8":{"tp":"완전제곱식이 될 조건","key":"$(2x\\pm3)^2$","sol":["$(2x\\pm3)^2=4x^2\\pm12x+9$","$k-3=\\pm12$","$k=15$ 또는 $k=-9$","합 $6$"],"check":"ok"},
"9":{"tp":"완전제곱식","key":"$a^2+2ab+b^2$","sol":["$16x^2+24x+9=(4x+3)^2$","한 변 $4x+3$"],"check":"ok"},
"10":{"tp":"인수분해의 도형 활용","key":"$4x^2+(4+a)x+9$ 를 완전제곱식으로","sol":["$x^2$ 4개, $x$ 4개, $1$ 9개","$4x^2+4x+9+ax$","$(2x+3)^2=4x^2+12x+9$","$a=8,\\ b=2x+3$","$b-a=2x-5$"],"check":"ok"},
"11":{"tp":"공통인수","key":"$x=4$ 를 대입하면 $0$","sol":["$16+4a-12=0$, $a=-1$","$16+4+b=0$, $b=-20$","$x^2-x-20=(x+4)(x-5)$"],"check":"ok"},
"12":{"tp":"치환을 이용한 식의 값","key":"짝을 지어 $x^2+2x$ 만들기","sol":["$x^2+2x=4$","$(x-1)(x+3)=x^2+2x-3=1$","$(x-2)(x+4)=x^2+2x-8=-4$","곱 $=-4$"],"check":"ok"},
"13":{"tp":"인수분해를 이용한 수의 계산","key":"$t(t+8)+16=(t+4)^2$","sol":["$100\\times106=10600=t$","$102\\times104=10608=t+8$","$t(t+8)+16=t^2+8t+16=(t+4)^2$","$\\sqrt{(t+4)^2}=10604$"],"check":"ok"},
"14":{"tp":"공통인수","key":"$x=5$ 대입","sol":["$50+5a-5=0$, $a=-9$","$25-5+b=0$, $b=-20$","$x^2-9x+20$","$=(x-4)(x-5)$"],"check":"ok"},
"15":{"tp":"공통인수","key":"$x=4$ 대입","sol":["$48+4a-4=0$, $a=-11$","$16-4+b=0$, $b=-12$","$x^2-11x-12$","$=(x-12)(x+1)$"],"check":"ok"},
"16":{"tp":"전개 후 인수분해","key":"전개하여 정리","sol":["$x^2+x-30+10=x^2+x-20$","$=(x+5)(x-4)$"],"check":"ok"},
"17":{"tp":"치환하여 완전제곱식","key":"$x^2+3x=t$","sol":["$(x-2)(x+5)=x^2+3x-10$","$(x-1)(x+4)=x^2+3x-4$","$(t-10)(t-4)+k=t^2-14t+40+k$","$40+k=49$","$k=9$"],"check":"ok"},
"18":{"tp":"인수분해의 도형 활용","key":"넓이를 인수분해","sol":["$x^2+3x-10=(x-2)(x+5)$, $\\mathrm{A}=x+5$","$\\frac{(x-3)+(x+9)}{2}\\times\\mathrm{B}=(x+3)\\mathrm{B}$","$2x^2+x-15=(2x-5)(x+3)$, $\\mathrm{B}=2x-5$","$\\mathrm{A}-\\mathrm{B}=-x+10$"],"check":"ok"},
"19":{"tp":"인수분해의 도형 활용","key":"넓이 합을 인수분해","sol":["$3x^2+8x+4$","$=(3x+2)(x+2)$","둘레 $2(3x+2+x+2)=8x+8$"],"check":"ok"},
"20":{"tp":"인수분해의 도형 활용","key":"넓이 합을 인수분해","sol":["$2x^2+6x+4$","$=(2x+2)(x+2)$","둘레 $2(2x+2+x+2)=6x+8$"],"check":"ok"}
