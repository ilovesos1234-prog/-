{
"1":{"tp":"제곱근이 자연수가 되는 조건","key":"$9-x$ 가 제곱수여야 우변도 자연수","sol":["$9-x=s^2$ 이면 $17-y=(s+2)^2$","$s=0$: $x=9,\\ y=13$, $x+y=22$","$s=1$: $x=8,\\ y=8$, $x+y=16$","$s=2$: $x=5,\\ y=1$, $x+y=6$","최댓값 $22$"],"check":"ok"},
"2":{"tp":"제곱근의 대소","key":"$n^2\\le x$ 인 가장 큰 자연수 $n$","sol":["(1) $16^2=256\\le260\\lt289=17^2$","$P(260)=16$","(2) $10^2=100\\le105\\lt121$, $P(105)=10$","(3) $256\\le280\\lt289$ 이므로 $P(280)=16$","$16-10=6$"],"check":"원문 (1)이 P(280)이 아닌 P(260)으로 되어 있으나 둘 다 16이라 그대로 둠"},
"3":{"tp":"실수의 분류","key":"반례 찾기","sol":["$\\sqrt2$ 는 무리수 ○","$\\sqrt{16}=4$ 의 제곱근은 $\\pm2$ ×","순환소수는 유리수 ×","$(1+\\sqrt2)^2=3+2\\sqrt2$ ×","$\\sqrt2+(-\\sqrt2)=0$ ×","수직선 위에 나타낼 수 있다 ○ → $2$ 개"],"check":"ok"},
"4":{"tp":"분모의 유리화","key":"$\\frac1x$ 는 분자·분모를 바꾼 것","sol":["$x=\\frac{(\\sqrt7+\\sqrt6)^2}{7-6}=13+2\\sqrt{42}$","$\\frac1x=\\frac{\\sqrt7-\\sqrt6}{\\sqrt7+\\sqrt6}=13-2\\sqrt{42}$","$x+\\frac1x=26$"],"check":"ok"},
"5":{"tp":"근호를 포함한 식의 계산","key":"분배법칙 후 정리","sol":["$\\sqrt2\\times3\\sqrt2-\\sqrt2=6-\\sqrt2$","$\\sqrt5\\times2\\sqrt5+\\sqrt{50}=10+5\\sqrt2$","합: $16+4\\sqrt2$","$a=16,\\ b=4$, $a+b=20$"],"check":"ok"},
"6":{"tp":"완전제곱식","key":"$(3x-A)^2=9x^2-6Ax+A^2$","sol":["$A^2=4$ 이므로 $A=\\pm2$, $B=-6A$","$A=2$: $B=-12$ ($A\\gt B$ ○)","$A=-2$: $B=12$ ($A\\gt B$ ×)","$A+B=-10$"],"check":"ok"},
"7":{"tp":"합차 공식 연속 적용","key":"양변에 $(5-1)$ 곱하기","sol":["$(5-1)(5+1)(5^2+1)(5^4+1)(5^8+1)=5^{16}-1$","좌변 $=\\frac14(5^{16}-1)$","$a=\\frac14,\\ b=16$","$ab=4$"],"check":"ok"},
"8":{"tp":"식의 값","key":"$2(x+y)^2$ 으로 묶기","sol":["$2x^2+4xy+2y^2=2(x+y)^2$","$x+y=2$","$2\\times4=8$"],"check":"ok"},
"9":{"tp":"인수분해를 이용한 수의 계산","key":"합차·완전제곱","sol":["$A=9(51+49)(51-49)=9\\times200=1800$","$B=(69+1)^2=4900$","$A+B=6700$"],"check":"ok"},
"10":{"tp":"분모의 유리화와 식의 값","key":"$y=\\sqrt3-\\sqrt2$","sol":["$y=\\frac1{\\sqrt3+\\sqrt2}=\\sqrt3-\\sqrt2$","$x+y=2\\sqrt3,\\ x-y=2\\sqrt2$","$x^2-y^2=4\\sqrt6$"],"check":"ok"},
"11":{"tp":"인수","key":"각각 인수분해","sol":["① $(x+y)(x-y)$ ② $(x-y)^2$","③ $(x+2y)(x-y)$","④ $(x-3y)(x+y)$ ← $x-y$ 없음","⑤ $(3x+5y)(x-y)$"],"check":"ok"},
"12":{"tp":"인수분해","key":"전개하여 확인","sol":["ㄱ. $-3x(x-2)$ 가 맞음 ×","ㄴ. $9(x+2y)(x-2y)$ 가 맞음 ×","ㄷ, ㄹ ○","ㅁ. $(2x+3y)(3x-5y)=6x^2-xy-15y^2$ ×","ㄱ, ㄴ, ㅁ"],"check":"ok"},
"13":{"tp":"인수","key":"정리하여 확인","sol":["④ $(x+1)-3x=-2x+1$","$x+1$ 을 인수로 갖지 않음"],"check":"ok"},
"14":{"tp":"인수분해의 도형 활용","key":"완전제곱식 $(2a+b)^2$","sol":["$a^2+4ab+b^2+ka^2$","$=(2a+b)^2=4a^2+4ab+b^2$ 이 되려면 $k=3$","한 변의 길이 $2a+b$"],"check":"ok"},
"15":{"tp":"인수분해 공식","key":"$acx^2+(ad+bc)x+bd$","sol":["(1) $6x^2-11x-10=(3x+2)(2x-5)$","(2) $2x^2+x-15=(2x-5)(x+3)$","(3) 공통인수 $2x-5$"],"check":"ok"},
"16":{"tp":"완전제곱식이 될 조건","key":"$\\left(\\frac{b}{2}\\right)^2$ 꼴","sol":["(1) $k=\\left(\\frac{-6}{2}\\right)^2=9$, $(x-3)^2$","(2) $3(x^2+8x)+k$, $k=3\\times16=48$, $3(x+4)^2$","(3) $(2x\\pm5)^2=4x^2\\pm20x+25$","$k-5=\\pm20$ 이므로 $k=25$ 또는 $k=-15$"],"check":"ok"},
"17":{"tp":"완전제곱식이 될 조건","key":"전개 후 $\\left(\\frac{3}{2}\\right)^2$","sol":["$x^2+3x-10+k$","$-10+k=\\left(\\frac32\\right)^2=\\frac94$","$k=\\frac{49}{4}$"],"check":"ok"},
"18":{"tp":"완전제곱식","key":"각 식을 전개하여 비교","sol":["$(a+2)^2=a^2+4a+4$, $\\mathrm{A}=4$","$(3x-1)^2=9x^2-6x+1$, $\\mathrm{B}=-1$","$(2x+5)^2=4x^2+20x+25$, $\\mathrm{C}=4$","$4-1+4=7$"],"check":"ok"},
"19":{"tp":"완전제곱식","key":"$a^2\\pm2ab+b^2$ 꼴인지","sol":["① $(x+4)^2$ ② $(2x+1)^2$","③ $(3x-2)^2=9x^2-12x+4$ 이므로 ×","④ $3(x-2)^2$ ⑤ $2x(x+y)^2$"],"check":"ok"},
"20":{"tp":"완전제곱식이 될 조건","key":"전개 후 상수항 맞추기","sol":["$36x^2+16x-1+k$","$=\\left(6x+\\frac43\\right)^2$ 이려면 $-1+k=\\frac{16}{9}$","$k=\\frac{25}{9}$"],"check":"ok"}
