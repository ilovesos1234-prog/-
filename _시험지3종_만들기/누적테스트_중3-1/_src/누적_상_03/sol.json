"5":{"tp":"√(A−3n) 정수 조건","key":"48−3n 은 0 또는 3의 배수인 제곱수","sol":["$48-3n=0,9,36$ ($45$ 이하, $3$의 배수)","$n=16,13,4$","합 $=33$"],"check":"ok"},
